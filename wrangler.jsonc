{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cameronkuey-site",
  "compatibility_date": "2026-10-01",
  // Custom domains (the cameronkuey.com zone lives in this Cloudflare account). The apex redirects to www with a
  // Cloudflare Redirect Rule; the workers.dev URL stays on.
  "routes": [
    { "pattern": "www.cameronkuey.com", "custom_domain": true },
    { "pattern": "cameronkuey.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
