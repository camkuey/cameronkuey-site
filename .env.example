# Cloudflare reads the SerpApi secret from the Worker environment, not from this file.
# Local wrangler dev reads the same name from .dev.vars (see .dev.vars.example).
# Leave it empty to run Furniture Match in demo mode.
# Photo descriptions use the Workers AI binding (no key). See docs/furniture.md.

# SerpApi private key. Google Lens, plus Google Shopping only when Lens is short on prices.
# Free plan: 250 searches/month, 50/hour. Image upload is not a search.
# Create one at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Sheet log. Both must be set or logging is skipped. See docs/furniture-log.md.
# LOG_WEBHOOK_URL is the Apps Script web app URL (ends in /exec).
LOG_WEBHOOK_URL=
LOG_WEBHOOK_SECRET=
