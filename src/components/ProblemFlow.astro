---
/* "The problem" graphic: how the team's work was scattered (Before), then how one dashboard
   pulls it together (After). Hairline before/after card, pure CSS, no JS.
   One 16 s loop: Before (question marks pop in row by row, grey bar fills) -> each row flips to
   its After label one by one with a check (accent bar fills) -> pause -> reset.
   With reduced motion a static frame is shown instead: the "after" state with a small
   "Before: ..." line on each row. Only things from the brief are claimed. */
import { THEMES, type ThemeName } from '../data/themes';
interface Props { theme?: ThemeName }
const { theme = 'brand' } = Astro.props as Props;
const TH = THEMES[theme];
const T = 16;

const labels = [
  { a: ['One task list', 'see who does what'], b: ['Own task lists', 'nobody sees it all'], s: 'Before: separate lists' },
  { a: ['Meeting action items', 'land as tasks'], b: ['No meeting notes', 'action items vanish'], s: 'Before: no meeting notes' },
  { a: ['Shop inventory', 'and daily reports'], b: ['Parts made, not logged', 'no inventory, no reports'], s: 'Before: nothing logged' },
  { a: ['Onboarding', 'new staff and volunteers'], b: ['No onboarding', 'for new people'], s: 'Before: no onboarding' },
  { a: ['Gantt timeline', 'and roadmaps'], b: ['No Gantt charts', 'or roadmaps'], s: 'Before: no Gantt or roadmaps' },
  { a: ['Airtable bases', 'one per business line'], b: ['A messy shared drive', 'not organized'], s: 'Before: a messy drive' },
];
const n2 = (i: number) => String(i + 1).padStart(2, '0');

// ── per-row keyframes (percentages of T) ──
const p = (s: number) => `${+((s / T) * 100).toFixed(2)}%`;
const RESET = 15.1, FLIP = 7.6;
let css = '';
labels.forEach((_, k) => {
  const q = 0.6 + k * 0.8; // "?" pops in (before)
  const f = FLIP + 0.5 + k * 0.75; // row flips to after
  css += `@keyframes pr-q${k}{0%,${p(q)}{opacity:0;transform:scale(.4)}${p(q + 0.25)}{opacity:1;transform:scale(1.15)}${p(q + 0.45)},${p(f)}{opacity:1;transform:scale(1)}${p(f + 0.3)},100%{opacity:0;transform:scale(1)}}`;
  css += `@keyframes pr-b${k}{0%,${p(f)}{opacity:1}${p(f + 0.35)},${p(RESET)}{opacity:0}${p(RESET + 0.6)},100%{opacity:1}}`;
  css += `@keyframes pr-a${k}{0%,${p(f)}{opacity:0}${p(f + 0.35)},${p(RESET)}{opacity:1}${p(RESET + 0.6)},100%{opacity:0}}`;
  css += `@keyframes pr-c${k}{0%,${p(f + 0.15)}{opacity:0;transform:scale(.3)}${p(f + 0.4)}{opacity:1;transform:scale(1.2)}${p(f + 0.6)},${p(RESET)}{opacity:1;transform:scale(1)}${p(RESET + 0.5)},100%{opacity:0;transform:scale(1)}}`;
  css += `.pr-row:nth-child(${k + 1}) .pr-q{animation:pr-q${k} ${T}s linear infinite}`;
  css += `.pr-row:nth-child(${k + 1}) .pr-b{animation:pr-b${k} ${T}s linear infinite}`;
  css += `.pr-row:nth-child(${k + 1}) .pr-a{animation:pr-a${k} ${T}s linear infinite}`;
  css += `.pr-row:nth-child(${k + 1}) .pr-ck{animation:pr-c${k} ${T}s linear infinite}`;
});
const last = FLIP + 0.5 + 5 * 0.75;
css += `@keyframes pr-hb{0%,${p(FLIP)}{opacity:1}${p(FLIP + 0.4)},${p(RESET)}{opacity:0}${p(RESET + 0.6)},100%{opacity:1}}`;
css += `@keyframes pr-ha{0%,${p(FLIP)}{opacity:0}${p(FLIP + 0.4)},${p(RESET)}{opacity:1}${p(RESET + 0.6)},100%{opacity:0}}`;
css += `@keyframes pr-gb{0%,${p(0.6)}{transform:scaleX(0)}${p(0.6 + 6 * 0.8)},${p(FLIP)}{transform:scaleX(1)}${p(FLIP + 0.3)},100%{transform:scaleX(0)}}`;
css += `@keyframes pr-ga{0%,${p(FLIP + 0.5)}{transform:scaleX(0)}${p(last + 0.6)},${p(RESET)}{transform:scaleX(1)}${p(RESET + 0.5)},100%{transform:scaleX(0)}}`;
css += `.pr-x .pr-hb{animation:pr-hb ${T}s linear infinite}.pr-x .pr-ha{animation:pr-ha ${T}s linear infinite}`;
css += `.pr-x .pr-gb{animation:pr-gb ${T}s linear infinite}.pr-x .pr-ga{animation:pr-ga ${T}s linear infinite}`;
css = `@media (prefers-reduced-motion:no-preference){${css}}`;

const label = 'Animated diagram of how the team’s work changed. Before: everybody kept their own task lists so nobody could see what each person was doing; nobody took meeting notes and action items vanished; manufacturing made parts but logged no inventory or end-of-day reports; there was no onboarding for new employees and volunteers; there were no Gantt charts or roadmaps; and the business ran on one messy, unorganized shared online drive instead of Airtable bases. After: one Dashboard connects them, with one task list, meeting action items landing as tasks, shop inventory and daily reports, onboarding, a Gantt timeline and roadmaps, and Airtable bases, one per business line.';
---
<div class="pr pr-x" role="img" aria-label={label} style={`--pr-acc:${TH.primary}`}>
  <div class="pr-in" aria-hidden="true">
    <div class="pr-head">
      <span class="pr-sw pr-pills">
        <span class="pr-hb"><b class="pp pp-on">Before</b><b class="pp">After</b></span>
        <span class="pr-ha"><b class="pp">Before</b><b class="pp pp-acc">After</b></span>
      </span>
      <span class="pr-sw pr-cap">
        <span class="pr-hb">Work lived in separate places</span>
        <span class="pr-ha">One connected place</span>
      </span>
    </div>
    <div class="pr-sw pr-hub">
      <span class="pr-hb pr-hub-b">Who is doing what?</span>
      <span class="pr-ha pr-hub-a"><b>Dashboard</b><small>everything in one place</small></span>
    </div>
    <ol class="pr-rows">
      {labels.map((l, i) => (
        <li class="pr-row">
          <span class="pr-ix">{n2(i)}</span>
          <span class="pr-sw pr-txt">
            <span class="pr-b"><b>{l.b[0]}</b><small>{l.b[1]}</small></span>
            <span class="pr-a"><b>{l.a[0]}</b><small>{l.a[1]}</small><em>{l.s}</em></span>
          </span>
          <span class="pr-sw pr-mk">
            <i class="pr-q">?</i>
            <svg class="pr-ck" viewBox="0 0 16 16" width="16" height="16"><path d="M3,8.5 L6.5,12 L13,4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </li>
      ))}
    </ol>
    <div class="pr-bars"><i class="pr-gb"></i><i class="pr-ga"></i></div>
  </div>
</div>
<style is:inline set:html={css}></style>

<style>
  .pr{background:#fff;border:1px solid var(--line);border-radius:6px;padding:22px 24px 22px;font-family:var(--fb)}
  /* stacked before/after layers share one grid cell so nothing jumps */
  .pr-sw{display:grid}
  .pr-sw>*{grid-area:1/1}
  .pr-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
  .pr-pills>span{display:flex;gap:6px}
  .pp{font-family:var(--mono);font-weight:400;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;border:1px solid #D9D2C6;color:#A69B88;border-radius:999px;padding:4px 11px}
  .pp-on{border-color:var(--ink);color:var(--ink)}
  .pp-acc{background:var(--pr-acc);border-color:var(--pr-acc);color:#fff}
  .pr-cap{font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:.02em;text-align:right}
  .pr-hub{margin-top:16px;border-radius:4px}
  .pr-hub>span{display:flex;align-items:baseline;justify-content:center;gap:10px;padding:10px 12px;border-radius:4px}
  .pr-hub-b{border:1px dashed #B9B2A6;color:var(--muted);font-size:15px}
  .pr-hub-a{background:var(--ink);color:#F4F0E8;border:1px solid var(--ink)}
  .pr-hub-a b{font-weight:400;font-size:15px}
  .pr-hub-a small{font-family:var(--mono);font-size:10.5px;color:#B9B2A6}
  .pr-rows{list-style:none;margin:12px 0 0;padding:0}
  .pr-row{display:grid;grid-template-columns:28px 1fr 22px;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--line)}
  .pr-row:last-child{border-bottom:0}
  .pr-ix{font-family:var(--mono);font-size:10.5px;color:#A69B88}
  .pr-txt>span{display:flex;flex-direction:column;line-height:1.3}
  .pr-txt b{font-weight:400;font-size:15px;color:var(--ink)}
  .pr-txt small{font-family:var(--mono);font-size:10.5px;color:var(--muted);letter-spacing:.01em}
  .pr-b b{color:#5A544B}
  .pr-txt em{display:none;font-style:normal;font-family:var(--mono);font-size:10px;color:#8A7F72;margin-top:2px}
  .pr-mk{justify-items:center;align-items:center}
  .pr-q{font-style:normal;font-family:var(--mono);font-size:11px;color:#8A7F72;width:18px;height:18px;border:1px dashed #B9B2A6;border-radius:50%;display:grid;place-items:center;line-height:1}
  .pr-ck{color:var(--pr-acc)}
  .pr-bars{display:grid;margin-top:14px;height:2px;background:#EFEAE2}
  .pr-bars i{grid-area:1/1;transform-origin:left}
  .pr-gb{background:#A69B88}
  .pr-ga{background:var(--pr-acc)}
  /* static frame (no animation, or reduced motion): the after state, with the before note */
  .pr-hb,.pr-b,.pr-q,.pr-gb{opacity:0}
  .pr-ga{transform:none}
  .pr-txt em{display:block}
  @media (prefers-reduced-motion:no-preference){
    .pr-hb,.pr-b{opacity:1}
    .pr-ha,.pr-a,.pr-ck{opacity:0}
    .pr-q{opacity:0}
    .pr-gb{opacity:1;transform:scaleX(0)}
    .pr-ga{transform:scaleX(0)}
    .pr-txt em{display:none}
  }
  @media (max-width:420px){
    .pr{padding:18px 16px}
    .pr-txt b{font-size:14px}
    .pr-cap{text-align:left}
  }
</style>
