---
/* "The problem" graphic: how the team's work was scattered (Before), then how one
   dashboard pulls it together (After). Pure inline SVG, SMIL only, no JS.
   One 16 s loop: Before (0.6-7.4 s) -> cross-fade (8-9.4 s) -> After (to 14.4 s) -> reset.
   With reduced motion a static frame is shown instead: the "after" state with a
   small "Before: ..." line on each card. Only things from the brief are claimed. */
const T = 16;
const INK = '#1B1A18', RED = '#881919', BLUE = '#2E5E92', GOLD = '#DAB057', LINE = '#B8AC9A', SOFT = '#D9CFC0';
const f = (n: number) => +n.toFixed(3);
const cols = [8, 188], rows = [84, 186, 288], CW = 164, CH = 92;
const cells = [0, 1, 2, 3, 4, 5].map((i) => ({ i, x: cols[i % 2], y: rows[Math.floor(i / 2)] }));

const col = (c: string) => (c === 'light' ? '#fff' : c);
const dot = (c: string, path: string, dur: number, begin: number, o: { r?: number; fade?: string; shrink?: boolean } = {}) =>
  `<g opacity="0"><circle r="${o.r ?? 3.6}" fill="${col(c)}"${c === 'light' ? ` stroke="${INK}" stroke-width="1"` : ''}>${o.shrink ? `<animate attributeName="r" values="3.6;3.6;1" keyTimes="0;.5;1" dur="${dur}s" begin="-${begin}s" repeatCount="indefinite"/>` : ''}</circle>` +
  `<animateMotion path="${path}" dur="${dur}s" begin="-${begin}s" repeatCount="indefinite" calcMode="linear"/>` +
  `<animate attributeName="opacity" values="${o.fade ?? '0;1;1;0'}" keyTimes="${o.fade ? '0;.15;.55;1' : '0;.12;.8;1'}" dur="${dur}s" begin="-${begin}s" repeatCount="indefinite"/></g>`;
const q = (x: number, y: number, s = 13) => `<text x="${x}" y="${y}" text-anchor="middle" class="pq" style="font-size:${s}px">?</text>`;
const line = (d: string, c = BLUE, extra = '') => `<path d="${d}" fill="none" stroke="${c}" stroke-width="1.3" ${extra}/>`;
const check = (x: number, y: number, c = BLUE) => `<path d="M${x},${y} l2.6,2.8 l5,-5.6" fill="none" stroke="${c}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>`;
const bars = (x: number, y: number, n: number, w = 22, c = SOFT) => Array.from({ length: n }, (_, k) => `<path d="M${x},${y + k * 7} h${w}" stroke="${c}" stroke-width="2" stroke-linecap="round"/>`).join('');
const person = (x: number, y: number) => `<circle cx="${x}" cy="${y - 6}" r="5.5" fill="${GOLD}"/><path d="M${x - 10},${y + 12} a10,10 0 0 1 20,0 z" fill="${GOLD}"/>`;

// ── per-card "before" art (card-local coordinates, 164 x 92) ──
const before: string[] = [
  // 1 own task lists
  [18, 69, 120].map((x, k) => `<rect x="${x}" y="8" width="26" height="34" rx="3" fill="#fff" stroke="${LINE}"/>${bars(x + 5, 16, 3, 16)}`).join('') +
    q(56, 30) + q(108, 30) +
    [18, 69, 120].map((x, k) => dot(INK, `M${x + 8},13 V36`, 2.6, k * 0.9, { r: 2.6 })).join(''),
  // 2 no meeting notes
  `<rect x="60" y="6" width="40" height="38" rx="3" fill="#fff" stroke="${LINE}" stroke-dasharray="3 3"/>` +
    `<path d="M70,15 L90,35 M90,15 L70,35" stroke="${RED}" stroke-width="1.6" stroke-linecap="round"/>` +
    [0, 1, 2].map((k) => dot(GOLD, `M98,${14 + k * 6} C112,${8 + k * 6} 126,${12 + k * 4} 142,${6 + k * 8}`, 3.2, k * 1.05, { shrink: true, fade: '0;1;.6;0' })).join(''),
  // 3 parts made, nothing logged
  `<rect x="10" y="12" width="38" height="28" rx="3" fill="#fff" stroke="${LINE}"/><path d="M16,34 h8 M30,34 h12" stroke="${SOFT}" stroke-width="2" stroke-linecap="round"/><rect x="16" y="18" width="8" height="7" fill="${SOFT}"/><rect x="29" y="18" width="8" height="7" fill="${SOFT}"/>` +
    `<circle cx="72" cy="43" r="3" fill="${INK}"/><circle cx="79" cy="43" r="3" fill="${INK}"/><circle cx="75.5" cy="37.5" r="3" fill="${INK}"/>` +
    [0, 1, 2].map((k) => dot(INK, 'M48,26 H62 C72,26 76,32 76,36', 2.4, k * 0.8, { r: 3, fade: '0;1;1;0' })).join('') +
    [104, 134].map((x) => `<rect x="${x}" y="8" width="24" height="34" rx="3" fill="#fff" stroke="${RED}" stroke-dasharray="3 3"/>`).join('') + q(116, 30) + q(146, 30),
  // 4 no onboarding
  person(24, 26) +
    line('M38,24 C60,8 84,40 112,22', RED, 'stroke-dasharray="1.5 4" stroke-linecap="round"') +
    `<rect x="128" y="8" width="26" height="34" rx="3" fill="#fff" stroke="${RED}" stroke-dasharray="3 3"/>` + q(141, 30) +
    dot(INK, 'M38,24 C60,8 84,40 112,22', 3.4, 0, { fade: '0;1;1;0' }) + dot(INK, 'M38,24 C60,8 84,40 112,22', 3.4, 1.7, { fade: '0;1;1;0' }),
  // 5 no Gantt or roadmap: an empty, dashed grid
  `<rect x="22" y="6" width="120" height="38" rx="3" fill="#fff" stroke="${LINE}" stroke-dasharray="3 3"/>` +
    [16, 26, 36].map((y) => `<path d="M22,${y} H142" stroke="${SOFT}" stroke-dasharray="2 4"/>`).join('') +
    [52, 82, 112].map((x) => `<path d="M${x},6 V44" stroke="${SOFT}" stroke-dasharray="2 4"/>`).join('') + q(82, 31, 15),
  // 6 one messy shared drive
  `<path d="M32,41 C12,41 12,22 34,22 C34,8 62,6 72,16 C84,4 116,8 114,22 C140,20 146,42 124,42 Z" fill="#FBF7F2" stroke="${RED}" stroke-dasharray="3 3"/>` +
    `<path d="M40,34 C56,12 70,40 86,18 S110,36 118,26 M48,20 C60,34 84,12 96,34 M60,38 C72,22 96,26 108,14" fill="none" stroke="${LINE}" stroke-width="1"/>` +
    [[44, 28, -14, INK], [62, 16, 18, GOLD], [80, 30, -8, BLUE], [96, 17, 24, INK], [106, 31, -20, GOLD], [72, 22, 40, BLUE]].map(([x, y, r, c]) => `<g transform="translate(${x} ${y}) rotate(${r})"><rect x="-6" y="-4.5" width="12" height="9" rx="1.5" fill="#fff" stroke="${c}" stroke-width="1.2"/><path d="M-6,-4.5 h5 l1.5,-1.5" fill="none" stroke="${c}" stroke-width="1.2"/></g>`).join('') +
    dot(INK, 'M40,34 C56,12 70,40 86,18 S110,36 118,26', 4.2, 0, { r: 2.8 }) + dot(GOLD, 'M60,38 C72,22 96,26 108,14', 3.4, 1.7, { r: 2.8 }),
];

// ── "after" art; anim=false gives the static, motionless version ──
const after = (anim: boolean): string[] => {
  const d = (...a: Parameters<typeof dot>) => (anim ? dot(...a) : '');
  const grow = (x: number, y: number, w: number, c: string, b: number) =>
    anim ? `<rect x="${x}" y="${y}" width="0" height="7" rx="2" fill="${c}"><animate attributeName="width" values="0;0;${w};${w};0;0" keyTimes="0;${f((b + 0.2) / T)};${f((b + 1.5) / T)};.9;.91;1" dur="${T}s" repeatCount="indefinite"/></rect>` : `<rect x="${x}" y="${y}" width="${w}" height="7" rx="2" fill="${c}"/>`;
  return [
    // 1 one task list, everyone's work visible
    person(18, 26) + person(146, 26) + line('M30,24 H52') + line('M134,24 H112') +
      `<rect x="52" y="6" width="60" height="38" rx="3" fill="#fff" stroke="${BLUE}"/>` +
      [0, 1, 2].map((k) => check(58, 18 + k * 9) + `<path d="M70,${16 + k * 9} h34" stroke="${SOFT}" stroke-width="2" stroke-linecap="round"/>`).join('') +
      d(BLUE, 'M32,24 H54', 1.8, 0) + d(BLUE, 'M132,24 H110', 1.8, 0.9),
    // 2 meeting action items land as tasks
    `<rect x="18" y="6" width="38" height="38" rx="3" fill="#fff" stroke="${BLUE}"/>${bars(24, 16, 3, 26)}` + check(26, 38, BLUE) +
      line('M56,25 H100') +
      `<rect x="100" y="8" width="48" height="34" rx="3" fill="#fff" stroke="${BLUE}"/>` +
      [0, 1, 2].map((k) => `<rect x="106" y="${14 + k * 9}" width="6" height="6" rx="1.5" fill="none" stroke="${BLUE}"/><path d="M116,${17 + k * 9} h26" stroke="${SOFT}" stroke-width="2" stroke-linecap="round"/>`).join('') +
      [0, 1, 2].map((k) => d(GOLD, 'M52,25 H104', 2.4, k * 0.8)).join(''),
    // 3 shop inventory and daily reports
    `<rect x="10" y="12" width="38" height="28" rx="3" fill="#fff" stroke="${BLUE}"/><path d="M16,34 h8 M30,34 h12" stroke="${SOFT}" stroke-width="2" stroke-linecap="round"/><rect x="16" y="18" width="8" height="7" fill="${SOFT}"/><rect x="29" y="18" width="8" height="7" fill="${SOFT}"/>` +
      line('M48,26 H100') + line('M124,25 H134') +
      `<rect x="100" y="8" width="24" height="34" rx="3" fill="#fff" stroke="${BLUE}"/>${bars(105, 16, 4, 14)}` +
      `<rect x="134" y="8" width="24" height="34" rx="3" fill="#fff" stroke="${BLUE}"/>${bars(139, 16, 2, 14)}` + check(142, 36) +
      [0, 1].map((k) => d(INK, 'M48,26 H102', 2.4, k * 1.2, { r: 3 })).join('') + d(INK, 'M124,25 H136', 1.6, 0.4, { r: 3 }),
    // 4 onboarding
    person(24, 26) + line('M38,24 H104') +
      `<rect x="104" y="6" width="52" height="38" rx="3" fill="#fff" stroke="${BLUE}"/>` +
      [0, 1, 2].map((k) => `<rect x="110" y="${13 + k * 9}" width="7" height="7" rx="1.5" fill="none" stroke="${BLUE}"/>${check(111, 17 + k * 9)}<path d="M122,${17 + k * 9} h27" stroke="${SOFT}" stroke-width="2" stroke-linecap="round"/>`).join('') +
      [0, 1].map((k) => d(GOLD, 'M38,24 H106', 2.6, k * 1.3)).join(''),
    // 5 Gantt timeline and roadmaps
    `<rect x="22" y="6" width="120" height="38" rx="3" fill="#fff" stroke="${SOFT}"/>` +
      [16, 26, 36].map((y) => `<path d="M22,${y} H142" stroke="${SOFT}"/>`).join('') +
      grow(30, 9, 48, BLUE, 9.2) + grow(54, 19, 56, GOLD, 9.6) + grow(86, 29, 44, INK, 10) +
      `<path d="M136,10 l5,5 l-5,5 l-5,-5 z" fill="${RED}"/>`,
    // 6 Airtable bases, one per business line
    [18, 66, 114].map((x) => `<rect x="${x}" y="8" width="36" height="30" rx="4" fill="${INK}"/><path d="M${x + 5},19 H${x + 31} M${x + 5},27 H${x + 31} M${x + 16},14 V34" stroke="#6B665E" stroke-width="1.2"/>`).join('') +
      line('M54,23 H66', '#A69B88') + line('M102,23 H114', '#A69B88') +
      d('light', 'M52,16 H68', 1.6, 0, { r: 2.8 }) + d('light', 'M116,30 H100', 1.6, 0.8, { r: 2.8 }),
  ];
};

const labels = [
  { a: ['One task list', 'see who does what'], b: ['Own task lists', 'nobody sees it all'], s: 'Before: separate lists' },
  { a: ['Meeting action items', 'land as tasks'], b: ['No meeting notes', 'action items vanish'], s: 'Before: no meeting notes' },
  { a: ['Shop inventory', 'and daily reports'], b: ['Parts made, not logged', 'no inventory, no reports'], s: 'Before: nothing logged' },
  { a: ['Onboarding', 'new staff and volunteers'], b: ['No onboarding', 'for new people'], s: 'Before: no onboarding' },
  { a: ['Gantt timeline', 'and roadmaps'], b: ['No Gantt charts', 'or roadmaps'], s: 'Before: no Gantt or roadmaps' },
  { a: ['Airtable bases', 'one per business line'], b: ['A messy shared drive', 'not organized'], s: 'Before: a messy drive' },
];
const txt = (c: { x: number; y: number }, l: string[], cls = '') =>
  `<text class="pt" x="${c.x + CW / 2}" y="${c.y + 62}" text-anchor="middle">${l[0]}</text><text class="ps" x="${c.x + CW / 2}" y="${c.y + 76}" text-anchor="middle">${l[1]}</text>`;
const stat = (c: { x: number; y: number }, s: string) => `<text class="pb" x="${c.x + CW / 2}" y="${c.y + 89}" text-anchor="middle">${s}</text>`;

// ── dashboard flow lines (after) ──
const cy = (c: { y: number }) => c.y + CH / 2;
const tick = (c: { x: number; y: number; i: number }) => (c.i % 2 === 0 ? `M172,${cy(c)} H180` : `M180,${cy(c)} H188`);
const spine = `M180,66 V${cy(cells[4])}`;
const flowLines = line(spine) + cells.map((c) => line(tick(c))).join('');
const tones = [BLUE, INK, GOLD, BLUE, INK, GOLD];
const flowDots = cells.map((c) => {
  const e = c.i % 2 === 0 ? 166 : 194;
  return dot(tones[c.i], `M180,66 V${cy(c)} H${e}`, 3.2, c.i * 0.55) + dot('light', `M${e},${cy(c)} H180 V66`, 3.2, c.i * 0.55 + 1.6);
}).join('');
const brokenLines = `<path d="${spine}" fill="none" stroke="${RED}" stroke-width="1.2" stroke-dasharray="2 5" stroke-linecap="round"/>` + q(180, 183, 12) + q(180, 283, 12);

// ── phase gating ──
const gate = (v: string, k: string) => `<animate attributeName="opacity" values="${v}" keyTimes="${k}" dur="${T}s" repeatCount="indefinite"/>`;
const gB = gate('0;1;1;0;0', '0;.04;.45;.5;1');
const gA = gate('0;0;1;1;0;0', '0;.52;.59;.9;.96;1');
const frame = (c: { x: number; y: number }) =>
  `<rect x="${c.x}" y="${c.y}" width="${CW}" height="${CH}" rx="6" fill="#fff" stroke="${RED}" stroke-width="1.3" stroke-dasharray="5 4">` +
  `<animate attributeName="stroke" values="${RED};${RED};${BLUE};${BLUE};${RED};${RED}" keyTimes="0;.47;.59;.9;.97;1" dur="${T}s" repeatCount="indefinite"/>` +
  `<animate attributeName="stroke-dasharray" calcMode="discrete" values="5 4;1 0;5 4" keyTimes="0;.56;.95" dur="${T}s" repeatCount="indefinite"/></rect>`;
const staticFrame = (c: { x: number; y: number }) => `<rect x="${c.x}" y="${c.y}" width="${CW}" height="${CH}" rx="6" fill="#fff" stroke="${BLUE}" stroke-width="1.3"/>`;

const beforeBody = cells.map((c) => `<g transform="translate(${c.x} ${c.y})">${before[c.i]}</g>` + txt(c, labels[c.i].b)).join('');
const afterAnim = cells.map((c, k) => `<g transform="translate(${c.x} ${c.y})">${after(true)[c.i]}</g>` + txt(c, labels[c.i].a)).join('');
const afterStatic = cells.map((c) => `<g transform="translate(${c.x} ${c.y})">${after(false)[c.i]}</g>` + txt(c, labels[c.i].a) + stat(c, labels[c.i].s)).join('');

const pillB = `<rect x="8" y="3" width="64" height="21" rx="10.5" fill="#fff" stroke="${RED}" stroke-width="1.2"/><text class="pp" x="40" y="17.5" text-anchor="middle" fill="${RED}">BEFORE</text>`;
const pillA = `<rect x="8" y="3" width="64" height="21" rx="10.5" fill="${BLUE}"/><text class="pp" x="40" y="17.5" text-anchor="middle" fill="#fff">AFTER</text>`;
const capB = `<text class="pc" x="352" y="17.5" text-anchor="end">Work lived in separate places</text>`;
const capA = `<text class="pc" x="352" y="17.5" text-anchor="end">One connected place</text>`;
const hubB = `<rect x="8" y="30" width="344" height="36" rx="6" fill="#fff" stroke="${RED}" stroke-width="1.3" stroke-dasharray="5 4"/><text class="ph" x="180" y="53" text-anchor="middle" fill="${RED}">Who is doing what?</text>`;
const hubA = `<rect x="8" y="30" width="344" height="36" rx="6" fill="${INK}"/><text class="ph" x="180" y="46" text-anchor="middle" fill="#F4F0E8">Dashboard</text><text class="ps" x="180" y="59.5" text-anchor="middle" fill="#B9B2A6">everything in one place</text>`;

const label = 'Animated diagram of how the team’s work changed. Before: everybody kept their own task lists so nobody could see what each person was doing; nobody took meeting notes and action items vanished; manufacturing made parts but logged no inventory or end-of-day reports; there was no onboarding for new employees and volunteers; there were no Gantt charts or roadmaps; and the business ran on one messy, unorganized shared online drive instead of Airtable bases. After: one Dashboard connects them, with one task list, meeting action items landing as tasks, shop inventory and daily reports, onboarding, a Gantt timeline and roadmaps, and Airtable bases, one per business line.';
---
<svg class="pr" viewBox="0 0 360 392" role="img" aria-label={label}>
  <rect class="pr-panel" x=".5" y=".5" width="359" height="391" rx="4" />
  <g class="pr-anim" aria-hidden="true">
    <g opacity="0"><g set:html={flowLines + flowDots} /><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;.52;.59;.9;.96;1" dur={`${T}s`} repeatCount="indefinite" /></g>
    <g opacity="0"><g set:html={brokenLines} /><animate attributeName="opacity" values="0;1;1;0;0" keyTimes="0;.04;.45;.5;1" dur={`${T}s`} repeatCount="indefinite" /></g>
    <g set:html={cells.map(frame).join('')} />
    <g opacity="0"><g set:html={hubB + pillB + capB} /><animate attributeName="opacity" values="0;1;1;0;0" keyTimes="0;.04;.45;.5;1" dur={`${T}s`} repeatCount="indefinite" /></g>
    <g opacity="0"><g set:html={hubA + pillA + capA} /><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;.52;.59;.9;.96;1" dur={`${T}s`} repeatCount="indefinite" /></g>
    <g opacity="0"><g set:html={beforeBody} /><animate attributeName="opacity" values="0;1;1;0;0" keyTimes="0;.04;.45;.5;1" dur={`${T}s`} repeatCount="indefinite" /></g>
    <g opacity="0"><g set:html={afterAnim} /><animate attributeName="opacity" values="0;0;1;1;0;0" keyTimes="0;.52;.59;.9;.96;1" dur={`${T}s`} repeatCount="indefinite" /></g>
  </g>
  <g class="pr-static" aria-hidden="true">
    <g set:html={line(spine) + cells.map((c) => line(tick(c))).join('') + cells.map(staticFrame).join('') + hubA + pillA + capA + afterStatic} />
  </g>
</svg>

<style>
  .pr{display:block;width:100%;height:auto;aspect-ratio:360/392;font-family:var(--fb);overflow:hidden}
  .pr-panel{fill:#EDE7DC}
  .pr :global(.pt){font-size:12.5px;font-weight:500;fill:#1B1A18;letter-spacing:.01em}
  .pr :global(.ps){font-size:11.5px;fill:#6B665E;letter-spacing:.02em}
  .pr :global(.pb){font-size:11px;fill:#881919;letter-spacing:.02em}
  .pr :global(.pq){font-weight:600;fill:#881919}
  .pr :global(.pp){font-size:11px;font-weight:500;letter-spacing:.16em}
  .pr :global(.pc){font-size:11.5px;fill:#6B665E;letter-spacing:.02em}
  .pr :global(.ph){font-size:14px;font-weight:500;letter-spacing:.01em}
  .pr-static{display:none}
  @media (prefers-reduced-motion:reduce){.pr-anim{display:none}.pr-static{display:inline}}
</style>
