---
/* "Hours to one click" loop for the Circles case study hero: one white hairline card split in two.
   Before: seven numbered hairline rows, a check pops in on each one about every second while a grey
   bar fills, under a large light "≈ 3 hours" with a mono caption.
   After: one primary Run setup button is pressed, the same tools (outlined pills) turn their dots to the
   primary together, a thin bar snaps full and "1 click" darkens.
   Plain HTML + CSS keyframes, 11 s loop with a pause on the end state, then a fade and reset.
   Base styles are the end state, so under prefers-reduced-motion nothing moves and both halves read
   in full: every check, both bars, "≈ 3 hours" and "1 click". */
import { THEMES, type ThemeName } from '../data/themes';
interface Props { theme?: ThemeName }
const { theme = 'brand' } = Astro.props as Props;
const TH = THEMES[theme];
type Tab = { t: string; short: string };
const tabs: Tab[] = [
  { t: 'Zendesk', short: 'Zendesk' },
  { t: 'Airtable', short: 'Airtable' },
  { t: 'Zoom', short: 'Zoom' },
  { t: 'Google Calendar', short: 'Calendar' },
  { t: 'Google Slides', short: 'Slides' },
  { t: 'Email', short: 'Email' },
  { t: 'Slack', short: 'Slack' },
];
const T = 11;
const p = (s: number) => `${+((s / T) * 100).toFixed(2)}%`;
const CHECK0 = 0.5, CHECK_GAP = 0.85;
const checkAt = (i: number) => CHECK0 + i * CHECK_GAP;
const BEFORE_END = checkAt(tabs.length - 1) + 0.5;
const PRESS = BEFORE_END + 0.5, LIGHT = PRESS + 0.3, DONE = LIGHT + 0.5;
const MUTE = '#CFC8BC';

let css = '';
tabs.forEach((_, i) => {
  const s = checkAt(i);
  css += `@keyframes h2c-c${i}{0%,${p(s - 0.01)}{opacity:0;transform:scale(.3)}${p(s + 0.18)}{opacity:1;transform:scale(1.18)}${p(s + 0.35)},100%{opacity:1;transform:scale(1)}}`;
  const q = LIGHT + i * 0.07;
  css += `@keyframes h2c-p${i}{0%,${p(q - 0.01)}{--hl:0}${p(q + 0.25)},100%{--hl:1}}`;
});
css += `
@property --hl{syntax:"<number>";inherits:true;initial-value:1}
@keyframes h2c-cols{0%{opacity:0}${p(0.3)},${p(T - 0.8)}{opacity:1}100%{opacity:0}}
@keyframes h2c-bbar{0%,${p(CHECK0)}{transform:scaleX(0)}${p(BEFORE_END)},100%{transform:scaleX(1)}}
@keyframes h2c-press{0%,${p(PRESS)}{transform:scale(1)}${p(PRESS + 0.15)}{transform:scale(.95)}${p(PRESS + 0.35)},100%{transform:scale(1)}}
@keyframes h2c-abar{0%,${p(LIGHT)}{transform:scaleX(0)}${p(DONE)},100%{transform:scaleX(1)}}
@keyframes h2c-alab{0%,${p(DONE - 0.1)}{color:${MUTE}}${p(DONE + 0.3)},100%{color:#1B1A18}}
@keyframes h2c-acap{0%,${p(DONE - 0.1)}{color:${MUTE}}${p(DONE + 0.3)},100%{color:#6B645A}}
`;
const A = (name: string) => `animation:${name} ${T}s linear infinite`;
let anim = `.h2c-cols{${A('h2c-cols')}}.h2c-bf{${A('h2c-bbar')}}.h2c-run{${A('h2c-press')}}.h2c-af{${A('h2c-abar')}}.h2c-al b{${A('h2c-alab')}}.h2c-al span{${A('h2c-acap')}}`;
tabs.forEach((_, i) => { anim += `.h2c-c${i}{${A('h2c-c' + i)}}.h2c-p${i}{${A('h2c-p' + i)}}`; });
css += `@media (prefers-reduced-motion:no-preference){${anim}}`;

const label =
  'Animation. Before: setting up a Circle took about 3 hours, working through Zendesk, Airtable, Zoom, Google Calendar, Google Slides, email and Slack one tab at a time. After: one click on Run does it in seconds.';
---
<div class="h2c" role="img" aria-label={label} style={`--h2c-acc:${TH.primary};--h2c-acc-ink:${TH.primaryInk}`}>
  <div class="h2c-hd">
    <span class="h2c-ey">Circles setup / Before and after</span>
    <span class="h2c-ti">Hours of setup, or one click.</span>
  </div>
  <div class="h2c-cols">
    <div class="h2c-col">
      <span class="h2c-cap">Before</span>
      <ol class="h2c-rows">
        {tabs.map((tb, i) => (
          <li>
            <span class="h2c-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="h2c-t">{tb.t}</span>
            <svg class={`h2c-ck h2c-c${i}`} viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5 L6.5 12 L13 4.5" /></svg>
          </li>
        ))}
      </ol>
      <span class="h2c-bar"><i class="h2c-bf"></i></span>
      <div class="h2c-big"><b>≈ 3 hours</b><span>of setup</span></div>
    </div>
    <div class="h2c-col is-after">
      <span class="h2c-cap">After</span>
      <span class="h2c-run"><svg viewBox="0 0 12 14" aria-hidden="true"><path d="M1 1 L11 7 L1 13 Z" /></svg>Run setup</span>
      <ul class="h2c-pills">
        {tabs.map((tb, i) => <li class={`h2c-p${i}`}><i></i>{tb.short}</li>)}
      </ul>
      <span class="h2c-bar is-thin"><i class="h2c-af"></i></span>
      <div class="h2c-big h2c-al"><b>1 click</b><span>in seconds</span></div>
    </div>
  </div>
  <style is:inline set:html={css}></style>
</div>
<style>
  .h2c{container-type:inline-size;display:block;background:#fff;border:1px solid var(--line,#E2DDD4);border-radius:6px;padding:26px 28px 24px;font-family:var(--fb);color:#1B1A18;text-align:left}
  /* the card is the panel: no extra shadow from the hero figure */
  :global(.cs-herovis:has(> .h2c)),:global(.cs-vis:has(> .h2c)){box-shadow:none!important;transform:none!important;background:transparent!important}
  .h2c-hd{display:flex;flex-direction:column;gap:8px;padding-bottom:20px;border-bottom:1px solid var(--line,#E2DDD4)}
  .h2c-ey{font-family:var(--mono);font-size:10.5px;line-height:1.4;letter-spacing:.2em;text-transform:uppercase;color:var(--h2c-acc-ink)}
  .h2c-ti{font-family:var(--fd);font-weight:300;font-size:clamp(19px,4.2cqi,26px);line-height:1.15;letter-spacing:-.012em;text-wrap:balance}

  .h2c-cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr)}
  .h2c-col{display:flex;flex-direction:column;min-width:0;padding:18px 24px 0 0}
  .h2c-col.is-after{padding:18px 0 0 24px;border-left:1px solid var(--line,#E2DDD4)}
  .h2c-cap{font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#6B645A;margin-bottom:10px}

  .h2c-rows{list-style:none;margin:0;padding:0}
  .h2c-rows li{display:grid;grid-template-columns:24px minmax(0,1fr) 16px;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid #ECE6DC}
  .h2c-n{font-family:var(--mono);font-size:10px;color:#8A7F72}
  .h2c-t{font-size:14.5px;line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .h2c-ck{width:16px;height:16px;fill:none;stroke:#1B1A18;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;transform-origin:center}

  .h2c-bar{display:block;position:relative;height:3px;margin-top:auto;background:#ECE6DC;border-radius:2px;overflow:hidden}
  /* both bars sit on one baseline at the foot of their column */
  .h2c-rows,.h2c-pills{margin-bottom:18px!important}
  .h2c-bar i{position:absolute;inset:0;background:#8A7F72;transform-origin:left center}
  .h2c-bar.is-thin{height:2px}
  .h2c-bar.is-thin i{background:var(--h2c-acc)}
  .h2c-big{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:2px 12px;margin-top:10px}
  .h2c-big b{font-family:var(--fd);font-weight:300;font-size:clamp(24px,5.6cqi,32px);line-height:1.1;letter-spacing:-.015em;color:#1B1A18;white-space:nowrap}
  .h2c-big span{font-family:var(--mono);font-size:10px;letter-spacing:.04em;color:#6B645A}

  .h2c-run{display:inline-flex;align-self:flex-start;align-items:center;gap:10px;padding:11px 20px 11px 18px;border-radius:5px;background:var(--h2c-acc);color:#fff;font-size:16px;font-weight:500;letter-spacing:.01em;line-height:1.2;transform-origin:center}
  .h2c-run svg{width:11px;height:13px;fill:#fff}
  .h2c-pills{list-style:none;margin:16px 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
  .h2c-pills li{display:flex;align-items:center;gap:8px;min-width:0;padding:6px 10px;border:1px solid;border-radius:4px;font-size:13px;line-height:1.3;white-space:nowrap;
    /* --hl: 0 = waiting (white, hairline, grey dot), 1 = done (cream, ink outline, primary dot) */
    background:rgb(calc(255 - var(--hl) * 14) calc(255 - var(--hl) * 19) calc(255 - var(--hl) * 27));
    border-color:rgb(calc(220 - var(--hl) * 193) calc(213 - var(--hl) * 187) calc(202 - var(--hl) * 178))}
  .h2c-pills i{flex:none;position:relative;width:6px;height:6px;border-radius:50%;background:#CFC6B8}
  .h2c-pills i::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--h2c-acc);opacity:var(--hl)}

  /* narrow cards: Before above After */
  @container (max-width:479px){
    .h2c-cols{grid-template-columns:minmax(0,1fr)}
    .h2c-col{padding:18px 0 0}
    .h2c-col.is-after{padding:20px 0 0;margin-top:22px;border-left:0;border-top:1px solid var(--line,#E2DDD4)}
  }
  @media (max-width:600px){.h2c{padding:20px 18px 18px}}
</style>
