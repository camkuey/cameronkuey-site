---
/* "Hours to one click" loop for the Circles case study, section 01.
   Left: seven tabs light up one after another while a clock and bar fill ("≈ 3 hours of setup").
   Right: one Run button is pressed, the same tools light together and the bar snaps full ("1 click").
   Pure inline SVG + CSS keyframes, 9s loop with a pause on the end state. Same panel, palette and
   Jost type as CaseFlow. Under prefers-reduced-motion nothing moves: the static end state shows
   both the "≈ 3 hours" and the "1 click" halves. */
import { THEMES, type ThemeName } from '../data/themes';
interface Props { theme?: ThemeName }
const { theme = 'brand' } = Astro.props as Props;
const TH = THEMES[theme];
// Before: each tab lights in the same neutral sand (manual, one at a time). After: every tool lights
// together in ink, fired by one primary Run button. No per-tool colours.
type Tab = { t: string; short: string };
const tabs: Tab[] = [
  { t: 'Zendesk', short: 'Zendesk' },
  { t: 'Airtable', short: 'Airtable' },
  { t: 'Zoom', short: 'Zoom' },
  { t: 'Google Calendar', short: 'Calendar' },
  { t: 'Google Slides', short: 'Slides' },
  { t: 'Email', short: 'Email' },
  { t: 'Slack', short: 'Slack' },
];
const LIT_B = { fill: '#E7DFD2', stroke: '#CFC4B2', ink: '#1B1A18' };
const LIT_A = { fill: '#1B1A18', stroke: '#1B1A18', ink: '#F4F0E8' };
const SLOW = '#9C9283';
const T = 9;
const ty = (i: number) => 44 + i * 24;
const px = (i: number) => (i % 2 ? 268 : 192);
const py = (i: number) => 128 + Math.floor(i / 2) * 19;
const p2 = (n: number) => +n.toFixed(2);
const tabStart = (i: number) => p2(4 + i * 6.2);
const pillStart = (i: number) => p2(65.5 + i * 0.7);

let css = '';
tabs.forEach((_, i) => {
  const s = tabStart(i);
  css += `@keyframes h2c-t${i}{0%,${p2(s - 0.01)}%{opacity:0}${p2(s + 1)}%,100%{opacity:1}}`;
  const q = pillStart(i);
  css += `@keyframes h2c-p${i}{0%,${p2(q - 0.01)}%{opacity:0}${p2(q + 1)}%,100%{opacity:1}}`;
});
css += `
@keyframes h2c-root{0%{opacity:0}3%,94%{opacity:1}99%,100%{opacity:0}}
@keyframes h2c-dim{0%,50%{opacity:1}57%,100%{opacity:.92}}
@keyframes h2c-ghost{0%,50%{opacity:.28}56%,100%{opacity:1}}
@keyframes h2c-cur{0%,50%{opacity:0;transform:translate(338px,168px)}52%{opacity:1;transform:translate(338px,168px)}61%,63%{opacity:1;transform:translate(284px,98px)}64%,100%{opacity:1;transform:translate(285px,100px)}}
@keyframes h2c-press{0%,62.5%{transform:translate(0,0)}64%,66%{transform:translate(3px,4px)}68%,100%{transform:translate(0,0)}}
@keyframes h2c-rip{0%,63.5%{opacity:0;transform:scale(.5)}64.5%{opacity:.55;transform:scale(.5)}73%,100%{opacity:0;transform:scale(1.5)}}
@keyframes h2c-bbar{0%,3%{transform:scaleX(0)}48%,100%{transform:scaleX(1)}}
@keyframes h2c-bhand{0%,3%{transform:rotate(0)}48%,100%{transform:rotate(1080deg)}}
@keyframes h2c-blab{0%,44%{opacity:0}47%,100%{opacity:1}}
@keyframes h2c-arr{0%,48%{opacity:0}52%,100%{opacity:1}}
@keyframes h2c-abar{0%,65%{transform:scaleX(0)}68%,100%{transform:scaleX(1)}}
@keyframes h2c-ahand{0%,65%{transform:rotate(0)}68%,100%{transform:rotate(720deg)}}
@keyframes h2c-alab{0%,67%{opacity:0}69.5%,100%{opacity:1}}
`;
const A = (name: string) => `animation:${name} ${T}s linear infinite`;
let anim = `.h2c-root{${A('h2c-root')}}.h2c-before{${A('h2c-dim')}}.h2c-after{${A('h2c-ghost')}}.h2c-cur{${A('h2c-cur')}}.h2c-press{${A('h2c-press')}}.h2c-rip{${A('h2c-rip')}}.h2c-bbar{${A('h2c-bbar')}}.h2c-bhand{${A('h2c-bhand')}}.h2c-blab{${A('h2c-blab')}}.h2c-arr{${A('h2c-arr')}}.h2c-abar{${A('h2c-abar')}}.h2c-ahand{${A('h2c-ahand')}}.h2c-alab{${A('h2c-alab')}}`;
tabs.forEach((_, i) => { anim += `.h2c-t${i}{${A('h2c-t' + i)}}.h2c-p${i}{${A('h2c-p' + i)}}`; });
css += `@media (prefers-reduced-motion:no-preference){${anim}}`;

const label =
  'Animation. Before: setting up a Circle took about 3 hours, working through Zendesk, Airtable, Zoom, Google Calendar, Google Slides, email and Slack one tab at a time. After: one click on Run does it in seconds.';
---
<svg class="h2c" viewBox="0 0 360 272" role="img" aria-label={label}>
  <rect class="h2c-panel" x=".5" y=".5" width="359" height="271" rx="4" />
  <g class="h2c-root" aria-hidden="true">
    <path d="M184,26 V262" stroke="#D9CFC0" stroke-width="1.2" stroke-dasharray="4 4" />

    <g class="h2c-before">
      <text class="h2c-cap" x="16" y="36">Before</text>
      {tabs.map((tb, i) => (
        <g>
          <rect x="16" y={ty(i)} width="160" height="20" rx="6" fill="#fff" stroke="#D9CFC0" />
          <text class="h2c-nm" x="27" y={ty(i) + 14} fill="#4F4A42">{tb.t}</text>
          <g class={`h2c-lit h2c-t${i}`}>
            <rect x="16" y={ty(i)} width="160" height="20" rx="6" fill={LIT_B.fill} stroke={LIT_B.stroke} />
            <text class="h2c-nm" x="27" y={ty(i) + 14} fill={LIT_B.ink}>{tb.t}</text>
            <path d={`M159,${ty(i) + 10.5} l3.5,3.5 l6.5,-7.5`} fill="none" stroke={LIT_B.ink} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </g>
        </g>
      ))}
      <circle cx="28" cy="228" r="11" fill="#fff" stroke="#1B1A18" stroke-width="1.6" />
      <g class="h2c-bhand" style="transform-origin:28px 228px"><path d="M28,228 V220.5" stroke={SLOW} stroke-width="2" stroke-linecap="round" /></g>
      <circle cx="28" cy="228" r="1.6" fill="#1B1A18" />
      <rect x="48" y="224" width="128" height="8" rx="4" fill="#EDE7DC" />
      <rect class="h2c-bbar" x="48" y="224" width="128" height="8" rx="4" fill={SLOW} style="transform-origin:48px 228px" />
      <text class="h2c-big h2c-blab" x="16" y="262">≈ 3 hours of setup</text>
    </g>

    <g class="h2c-after">
      <text class="h2c-cap" x="192" y="36">After</text>
      <rect x="199" y="63" width="140" height="52" rx="12" fill="#1B1A18" />
      <g class="h2c-press">
        <rect x="196" y="59" width="140" height="52" rx="12" fill={TH.primary} stroke="#1B1A18" stroke-width="1.5" />
        <path d="M236,76 L236,94 L250,85 Z" fill="#fff" />
        <text class="h2c-run" x="262" y="93">Run</text>
      </g>
      <circle class="h2c-rip" cx="266" cy="85" r="46" fill="none" stroke={TH.primary} stroke-width="2.5" style="transform-origin:266px 85px" />
      {tabs.map((tb, i) => (
        <g>
          <rect x={px(i)} y={py(i)} width="74" height="17" rx="8.5" fill="#fff" stroke="#D9CFC0" />
          <text class="h2c-mini" x={px(i) + 37} y={py(i) + 12} text-anchor="middle" fill="#6B645A">{tb.short}</text>
          <g class={`h2c-lit h2c-p${i}`}>
            <rect x={px(i)} y={py(i)} width="74" height="17" rx="8.5" fill={LIT_A.fill} stroke={LIT_A.stroke} />
            <text class="h2c-mini" x={px(i) + 37} y={py(i) + 12} text-anchor="middle" fill={LIT_A.ink}>{tb.short}</text>
          </g>
        </g>
      ))}
      <circle cx="204" cy="228" r="11" fill="#fff" stroke="#1B1A18" stroke-width="1.6" />
      <g class="h2c-ahand" style="transform-origin:204px 228px"><path d="M204,228 V220.5" stroke={TH.primary} stroke-width="2" stroke-linecap="round" /></g>
      <circle cx="204" cy="228" r="1.6" fill="#1B1A18" />
      <rect x="224" y="224" width="118" height="8" rx="4" fill="#EDE7DC" />
      <rect class="h2c-abar" x="224" y="224" width="118" height="8" rx="4" fill={TH.primary} style="transform-origin:224px 228px" />
      <text class="h2c-big h2c-alab" x="192" y="262">1 click<tspan class="h2c-sm" dx="7">in seconds</tspan></text>
      <g class="h2c-cur"><path d="M0,0 L0,17 L4.6,13 L7.8,20 L10.8,18.7 L7.7,11.9 L13.4,11.9 Z" fill="#fff" stroke="#1B1A18" stroke-width="1.5" stroke-linejoin="round" /></g>
    </g>

    <g class="h2c-arr">
      <circle cx="184" cy="118" r="9.5" fill="#FFFDF9" stroke="#1B1A18" stroke-width="1.3" />
      <path d="M179.5,118 H188.5 M185,114.5 L188.8,118 L185,121.5" fill="none" stroke="#1B1A18" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  </g>
  <style is:inline set:html={css}></style>
</svg>
<style>
  .h2c{display:block;width:100%;height:auto;aspect-ratio:360/272;font-family:var(--fb);overflow:hidden}
  .h2c-panel{fill:#FFFDF9;stroke:#D9CFC0;stroke-width:1}
  .h2c-cap{font-size:11.5px;font-weight:500;letter-spacing:.16em;text-transform:uppercase;fill:#6B645A}
  .h2c-nm{font-size:12.5px;font-weight:500}
  .h2c-mini{font-size:11px;font-weight:500}
  .h2c-big{font-size:16px;font-weight:600;fill:#1B1A18}
  .h2c-sm{font-size:12px;font-weight:400;fill:#4F4A42}
  .h2c-run{font-size:23px;font-weight:500;fill:#fff;letter-spacing:.02em}
  /* "before" reads as past through its neutral sand fills, not by fading text below 4.5:1 */
  .h2c-before{opacity:.92}
  .h2c-cur,.h2c-rip{opacity:0}
</style>
