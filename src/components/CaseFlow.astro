---
/* Looping flow cards for the case studies, in one timeline language:
   a white hairline card, mono eyebrow + light title + legend, then numbered circular nodes on a
   hairline track. A dot travels each hop (its colour = what is being passed, see the legend), the line
   behind it turns near-black, the active node pulses in the page accent and passed nodes fill cream.
   About 2.7 s per hop, a pause on the finished state, then a fade and reset.
   Plain HTML + CSS keyframes (generated per flow below), no JS. The track wraps onto rows by the
   card's own width and stacks vertically in narrow cards. Branches sit on a second row that starts
   from a dashed copy of the node they leave. Shapes carry meaning instead of extra colours:
   square-ish node = a person acts, double ring = a person checks or holds, dashed = not built yet.
   Base styles are the finished state, so reduced motion shows every node, label and solid line. */
import { FLOWS, type Tone, type FNode, type Dot } from '../data/case-flows';
import { THEMES, type ThemeName } from '../data/themes';

interface Props { flow: string; theme?: ThemeName }
const { flow, theme = 'brand' } = Astro.props as Props;
const def = FLOWS[flow];
if (!def) throw new Error(`Unknown flow: ${flow}`);
const TH = THEMES[theme];
const L = def.layout;

const INK = '#1B1A18', GREY = '#8A7F72';
const DOT: Record<Dot, string> = { accent: TH.primary, ink: INK, grey: GREY };
const toneCol = (t: Tone) => DOT[L.dots[t] ?? 'ink'];
const legendOf = new Map(def.legend.map(([t, l]) => [t, l]));
const rgba = (hex: string, a: number) => {
  const v = parseInt(hex.slice(1), 16);
  return `rgba(${(v >> 16) & 255},${(v >> 8) & 255},${v & 255},${a})`;
};
const f = (n: number) => +n.toFixed(3);

const byId = new Map(def.nodes.map((n) => [n.id, n]));
const get = (id: string) => { const n = byId.get(id); if (!n) throw new Error(`${flow}: unknown node ${id}`); return n; };
const strip = (v: string) => v.split(':')[0];
const routeIds = def.routes.map((r) => r.via.map(strip));

// step numbers: the order the first route walks through the nodes, with per-node overrides
const stepOf = new Map<string, string>();
{
  let n = 0;
  routeIds[0].forEach((id) => { if (!stepOf.has(id)) stepOf.set(id, String(++n)); });
  def.nodes.forEach((nd) => { if (nd.step === false) stepOf.delete(nd.id); else if (nd.step !== undefined) stepOf.set(nd.id, String(nd.step)); });
}
const num = (id: string) => { const s = stepOf.get(id); return s === undefined ? '' : /^\d+$/.test(s) ? s.padStart(2, '0') : s; };

// dot colour: the tone a route's dot carries when it leaves (or reaches) a node
const findHop = (a: string, b: string) => {
  for (let r = 0; r < routeIds.length; r++) for (let k = 0; k < routeIds[r].length - 1; k++) if (routeIds[r][k] === a && routeIds[r][k + 1] === b) return { r, k };
  return null;
};
const toneAfter = (r: number, k: number): Tone => {
  const bl = def.routes[r].blobs[0];
  let t = bl.tone;
  (bl.swaps ?? []).forEach((s) => { if (s.at <= k) t = s.tone; });
  return t;
};
const held = (ids: string[], k: number, prev?: string): Tone => {
  if (k < ids.length - 1) { const h = findHop(ids[k], ids[k + 1]); if (h) return toneAfter(h.r, h.k); }
  const from = k > 0 ? ids[k - 1] : prev;
  if (from) { const h = findHop(from, ids[k]); if (h) return toneAfter(h.r, h.k + 1); }
  return 'ink';
};
const dashed = (a: string, b: string) => def.links.some((l) => l.style === 'dash' && ((l.a === a && l.b === b) || (l.a === b && l.b === a)));

// ── cells ──
type Half = { s: number; e: number; col: string; dash: boolean; cls: string; dot: string };
type Chip = { glyph: string; label: string; to: string; style?: string; col: string; cls: string; t: number };
type Cell = {
  id: string; n: FNode; kind: string; num: string; tone: Tone; tag?: Tone; ref?: boolean;
  inH?: Half; outH?: Half; chips: Chip[]; pills?: { n: FNode; t: number; cls: string }[];
  arr: number; leave: number; cls: string;
};
let uid = 0;
const cid = () => `q${uid++}`;
const kindOf = (n: FNode, id: string) => (n.tone === 'human' ? 'human' : n.tone === 'person' ? 'person' : !num(id) ? 'plain' : 'step');
const mkCell = (id: string, ref = false): Cell => {
  const n = get(id);
  return { id, n, kind: ref ? 'ref' : kindOf(n, id), num: num(id), tone: 'ink', ref, chips: [], arr: 0, leave: 0, cls: cid() };
};
const dedupe = (ids: string[]) => ids.filter((id, i) => ids.indexOf(id) === i);
const mainIds = dedupe(L.main ?? routeIds[0]);
const main = mainIds.map((id) => mkCell(id));
const br = L.branch;
const branch = br ? [...(br.from ? [mkCell(br.from, true)] : []), ...br.via.map((id) => mkCell(id))] : [];
const all = [...main, ...branch];

// the tone each node hands on, and a tag above a node where the dot changes colour (legend words only)
const tagRun = (cells: Cell[], ids: string[], prev?: string) => {
  let last: Tone | undefined;
  cells.forEach((c, k) => {
    const t = held(ids, k, prev);
    c.tone = t;
    if (t !== last && legendOf.has(t)) c.tag = t;
    last = t;
  });
};
tagRun(main, mainIds);
if (br) {
  tagRun(branch.filter((c) => !c.ref), br.via, br.from);
  if (br.from) branch[0].tone = held([br.from, br.via[0]], 0);
}

// group (one number, several pills)
if (L.group) {
  const g = main.find((c) => c.id === L.group!.at)!;
  g.kind = 'group';
  g.pills = L.group.ids.map((id) => ({ n: get(id), t: 0, cls: cid() }));
}

// chips: links back to an earlier step, on to another row, or blocked
(L.chips ?? []).forEach((ch) => {
  const c = all.find((x) => x.id === ch.at && !x.ref);
  if (!c) throw new Error(`${flow}: chip on unknown node ${ch.at}`);
  const tgt = get(ch.to);
  // dashed links run back to an earlier step; solid ones join the main track further on
  c.chips.push({
    glyph: ch.style === 'x' ? '✕' : ch.style === 'dash' ? '↩' : '→', label: `${num(ch.to)} ${tgt.t}`.trim(), to: ch.to,
    style: ch.style, col: toneCol(ch.tone), cls: cid(), t: 0,
  });
});

// ── timeline ──
const TR = 1.1, ACT = 1.6;
const dwell = (c: Cell) => ACT + (c.n.tone === 'human' ? 1.2 : 0);
const half = (s: number, e: number, a: string, b: string, col: string): Half => ({ s, e, col, dash: dashed(a, b), cls: cid(), dot: cid() });
let t = 0.5;
const run = (cells: Cell[], startFrom?: Cell) => {
  cells.forEach((c, k) => {
    const prev = k > 0 ? cells[k - 1] : startFrom;
    if (prev) {
      const col = toneCol(prev.tone);
      prev.outH = half(t, t + TR / 2, prev.id, c.id, col);
      c.inH = half(t + TR / 2, t + TR, prev.id, c.id, col);
      t += TR;
    }
    c.arr = t;
    if (c.pills) {
      c.pills.forEach((p, j) => { p.t = c.arr + 0.4 + j * 0.6; });
      c.leave = c.arr + 0.4 + c.pills.length * 0.6 + 0.5;
    } else c.leave = c.arr + dwell(c);
    c.chips.forEach((ch) => { ch.t = c.arr + 0.4; });
    t = c.leave;
  });
};
run(main);
if (branch.length) {
  t += 0.4;
  const [b0, ...rest] = branch;
  if (b0.ref) { b0.arr = b0.leave = t; run(rest, b0); } else run(branch);
}
const E = t;
const T = f(E + 3.3);
const pc = (x: number) => `${f(Math.min(100, Math.max(0, (x / T) * 100)))}%`;

// ── keyframes ──
const sel = `.cf[data-flow="${flow}"]`;
const css: string[] = ['@property --cfp{syntax:"<number>";inherits:true;initial-value:1}'];
const rules: string[] = [];
let kn = 0;
const bind = (cls: string, frames: string) => {
  const k = `cf-${flow}-${kn++}`;
  css.push(`@keyframes ${k}{${frames}}`);
  rules.push(`${sel} .${cls}{animation:${k} ${T}s linear infinite}`);
};
const acc = TH.primary;
const IDLE = `background-color:#fff;border-color:#CFC6B8;color:${GREY}`;
const ON = `background-color:${acc};border-color:${acc};color:#fff`;
const DONE = `background-color:#EFEAE2;border-color:${INK};color:${INK}`;
const R0 = `box-shadow:0 0 0 0 ${rgba(acc, 0.42)}`, R1 = `box-shadow:0 0 0 9px ${rgba(acc, 0)}`, RZ = `box-shadow:0 0 0 0 ${rgba(acc, 0)}`;
all.forEach((c) => {
  if (!c.ref) {
    let fr = `0%,${pc(c.arr - 0.02)}{${IDLE};${RZ}}${pc(c.arr)}{${ON};${R0}}`;
    let p = c.arr;
    while (p + 0.7 <= c.leave - 0.15) { if (p > c.arr) fr += `${pc(p)}{${ON};${R0}}`; fr += `${pc(p + 0.7)}{${ON};${R1}}`; p += 0.75; }
    fr += `${pc(c.leave - 0.12)}{${ON};${RZ}}${pc(c.leave)}{${DONE};${RZ}}100%{${DONE};${RZ}}`;
    bind(c.cls, fr);
  }
  [c.inH, c.outH].forEach((h) => {
    if (!h) return;
    bind(h.cls, `0%,${pc(h.s)}{--cfp:0}${pc(h.e)}{--cfp:1}100%{--cfp:1}`);
    bind(h.dot, `0%,${pc(h.s - 0.01)}{opacity:0}${pc(h.s)}{opacity:1}${pc(h.e)}{opacity:1}${pc(h.e + 0.06)}{opacity:0}100%{opacity:0}`);
  });
  (c.pills ?? []).forEach((pl) => bind(pl.cls, `0%,${pc(pl.t - 0.01)}{--cfl:0}${pc(pl.t + 0.3)}{--cfl:1}100%{--cfl:1}`));
  c.chips.forEach((ch) => bind(ch.cls, `0%,${pc(ch.t - 0.01)}{opacity:.3}${pc(ch.t + 0.4)}{opacity:1}100%{opacity:1}`));
});
bind('cf-ft', `0%,${pc(E - 0.6)}{opacity:.3}${pc(E)}{opacity:1}100%{opacity:1}`);
bind('cf-bd', `0%{opacity:0}${pc(0.35)}{opacity:1}${pc(T - 0.7)}{opacity:1}100%{opacity:0}`);
css.push('@property --cfl{syntax:"<number>";inherits:true;initial-value:1}');
css.push(`@media (prefers-reduced-motion:no-preference){${rules.join('')}}`);

// columns: at most five per row, balanced (9 = 5 + 4, 7 = 4 + 3, 6 = 3 + 3)
const rowsOf = (n: number) => Math.ceil(n / 5);
const cols = Math.max(1, Math.ceil(main.length / rowsOf(main.length)));
const foot = (L.foot ?? []).map(get);
const vars = `--cf-acc:${TH.primary};--cf-acc-ink:${TH.primaryInk}`;
---
<div class="cf" role="img" aria-label={def.label} data-flow={flow} style={vars}>
  <div class="cf-hd">
    <div class="cf-hl">
      <span class="cf-ey">{def.eyebrow}</span>
      <span class="cf-ti">{def.title}</span>
    </div>
    <ul class="cf-lg">
      {def.legend.map(([tone, label]) => <li><i style={`background:${toneCol(tone)}`}></i>{label}</li>)}
    </ul>
  </div>
  <div class="cf-bd">
    {[main, branch].filter((cells) => cells.length).map((cells, row) => (
      <div class={row ? 'cf-row cf-br' : 'cf-row'}>
        {row === 1 && br?.lead && <span class="cf-lead">{br.lead}</span>}
        <ol class="cf-tr" style={`--cols:${cols}`}>
          {cells.map((c) => (
            <li class={`cf-st k-${c.kind}`}>
              <span class="cf-tg">{c.tag && <><i style={`background:${toneCol(c.tag)}`}></i>{legendOf.get(c.tag)}</>}</span>
              {c.inH && <span class={`cf-hf cf-in ${c.inH.cls}${c.inH.dash ? ' is-dash' : ''}`}><i class="cf-fl"></i><b class={`cf-dt ${c.inH.dot}`} style={`background:${c.inH.col}`}></b></span>}
              {c.outH && <span class={`cf-hf cf-out ${c.outH.cls}${c.outH.dash ? ' is-dash' : ''}`}><i class="cf-fl"></i><b class={`cf-dt ${c.outH.dot}`} style={`background:${c.outH.col}`}></b></span>}
              <span class={`cf-nd ${c.cls}`}>{c.num}</span>
              {c.pills ? (
                <span class="cf-pls">
                  {c.pills.map((p) => <span class={`cf-pl ${p.cls}`}><i></i><span>{p.n.t}</span>{p.n.s && <em><i></i>{p.n.s}</em>}</span>)}
                </span>
              ) : (
                <>
                  <span class="cf-tt">{c.n.t}</span>
                  {c.n.s && !c.ref && <span class="cf-sb">{c.n.s}</span>}
                </>
              )}
              {c.chips.map((ch) => (
                <span class={`cf-ch ${ch.cls}${ch.style === 'dash' ? ' is-dash' : ''}${ch.style === 'x' ? ' is-x' : ''}`}><i style={`background:${ch.col}`}></i><span class="cf-gl">{ch.glyph}</span><span class="cf-cl">{ch.label}</span></span>
              ))}
            </li>
          ))}
        </ol>
      </div>
    ))}
    {foot.length > 0 && (
      <div class="cf-ft">
        {foot.map((n) => (
          <div class={n.tone === 'next' ? 'cf-nx' : 'cf-nt'}><b>{n.t}</b>{n.s && <span>{n.s}</span>}</div>
        ))}
      </div>
    )}
  </div>
  <style is:inline set:html={css.join('')}></style>
</div>
<style>
  .cf{container-type:inline-size;display:block;background:#fff;border:1px solid var(--line,#E2DDD4);border-radius:6px;padding:26px 28px 24px;font-family:var(--fb);color:#1B1A18;text-align:left}
  /* the card is the panel: no extra shadow or lift from the figure around it */
  :global(.cs-vis:has(> .cf)),:global(.cs-herovis:has(> .cf)){box-shadow:none!important;transform:none!important;background:transparent!important}

  .cf-hd{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:12px 24px;margin-bottom:24px}
  .cf-hl{display:flex;flex-direction:column;gap:8px;min-width:0}
  .cf-ey{font-family:var(--mono);font-size:10.5px;line-height:1.4;letter-spacing:.2em;text-transform:uppercase;color:var(--cf-acc-ink)}
  .cf-ti{font-family:var(--fd);font-weight:300;font-size:clamp(19px,4.2cqi,26px);line-height:1.15;letter-spacing:-.012em;color:#1B1A18;text-wrap:balance}
  .cf-lg{list-style:none;margin:0;padding:0 0 3px;display:flex;flex-wrap:wrap;justify-content:flex-end;gap:5px 14px;font-family:var(--mono);font-size:10px;line-height:1.4;color:#5A544B}
  .cf-lg li{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
  .cf-lg i,.cf-tg i,.cf-ch>i{flex:none;width:7px;height:7px;border-radius:50%}

  .cf-row+.cf-row{margin-top:22px;padding-top:18px;border-top:1px dashed #DCD5CA}
  .cf-lead{display:block;margin:0 0 10px;font-family:var(--mono);font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:#8A7F72}
  .cf-tr{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));row-gap:22px}
  .cf-st{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 5px;min-width:0}
  .cf-tg{display:flex;align-items:center;justify-content:center;gap:5px;height:14px;margin-bottom:8px;font-family:var(--mono);font-size:9.5px;line-height:1;color:#5A544B;white-space:nowrap}

  /* track: every cell carries the half-line into its node and the half-line out of it */
  .cf-hf{position:absolute;top:35px;height:1px;background:#DCD5CA}
  .cf-in{left:0;right:50%}
  .cf-out{left:50%;right:0}
  .cf-fl{position:absolute;left:0;top:0;height:100%;width:calc(var(--cfp) * 100%);background:#1B1A18}
  .cf-hf.is-dash{background:repeating-linear-gradient(90deg,#BDB3A4 0 4px,transparent 4px 7px)}
  .cf-hf.is-dash .cf-fl{background:repeating-linear-gradient(90deg,#1B1A18 0 4px,transparent 4px 7px)}
  .cf-dt{position:absolute;top:50%;left:calc(var(--cfp) * 100%);width:9px;height:9px;margin:-4.5px 0 0 -4.5px;border-radius:50%;box-shadow:0 0 0 2px #fff;opacity:0}

  .cf-nd{position:relative;z-index:1;flex:none;box-sizing:border-box;width:26px;height:26px;border-radius:50%;border:1px solid #1B1A18;background:#EFEAE2;color:#1B1A18;display:grid;place-items:center;font-family:var(--mono);font-size:10px;line-height:1;letter-spacing:0}
  .k-person .cf-nd{border-radius:7px}
  .k-human .cf-nd{border-radius:7px;outline:1px solid #BDB3A4;outline-offset:2px}
  .cf-nd:empty::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor}
  .k-ref .cf-nd{background:#fff!important;border:1px dashed #A69B88;color:#8A7F72}
  .k-ref .cf-tt{color:#8A7F72}

  .cf-tt{margin-top:10px;font-size:14px;font-weight:400;line-height:1.25;color:#1B1A18;overflow-wrap:anywhere}
  .cf-sb{margin-top:4px;font-family:var(--mono);font-size:10px;line-height:1.4;color:#6B645A;letter-spacing:.01em;overflow-wrap:anywhere}

  .cf-ch{display:inline-flex;align-items:center;gap:5px;margin-top:8px;padding:3px 7px;border:1px solid #CFC6B8;border-radius:3px;font-family:var(--mono);font-size:9.5px;line-height:1.3;color:#4F4A42;text-align:left;max-width:none;white-space:nowrap;align-self:center}
  .cf-ch.is-dash{border-style:dashed;border-color:#A69B88}
  .cf-ch.is-x .cf-cl{text-decoration:line-through;text-decoration-color:var(--cf-acc)}
  .cf-ch.is-x .cf-gl{color:var(--cf-acc)}
  .cf-gl{flex:none}

  .cf-pls{display:flex;flex-direction:column;gap:6px;margin-top:10px;width:100%}
  .cf-pl{display:flex;flex-wrap:wrap;align-items:center;gap:2px 7px;padding:5px 8px;border:1px solid;border-color:rgb(calc(220 - var(--cfl) * 193) calc(213 - var(--cfl) * 187) calc(202 - var(--cfl) * 178));border-radius:4px;font-size:13px;line-height:1.25;text-align:left}
  .cf-pl>i{flex:none;width:7px;height:7px;border-radius:50%;background:#CFC6B8;position:relative;overflow:hidden}
  .cf-pl>i::after{content:"";position:absolute;inset:0;border-radius:50%;background:var(--cf-acc);opacity:var(--cfl)}
  .cf-pl em{display:inline-flex;align-items:center;gap:5px;font-style:normal;font-family:var(--mono);font-size:9.5px;color:#6B645A}
  .cf-pl em i{width:5px;height:5px;border-radius:50%;background:#8A7F72}

  .cf-ft{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 20px;margin-top:22px;padding-top:16px;border-top:1px solid var(--line,#E2DDD4)}
  .cf-nt{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 18px;width:100%}
  .cf-nt b{font-family:var(--fd);font-weight:300;font-size:clamp(19px,4cqi,25px);line-height:1.15;letter-spacing:-.012em}
  .cf-nt span{font-family:var(--mono);font-size:10.5px;line-height:1.4;color:#6B645A}
  .cf-nx{display:flex;flex-direction:column;gap:3px;width:100%;padding:10px 14px;border:1px dashed #A69B88;border-radius:4px}
  .cf-nx b{font-weight:400;font-size:14.5px;line-height:1.3}
  .cf-nx span{font-family:var(--mono);font-size:10px;line-height:1.4;color:#6B645A}

  /* narrow cards: one node per row, the track runs down the left */
  @container (max-width:439px){
    .cf-hd{margin-bottom:20px}
    .cf-lg{justify-content:flex-start}
    .cf-tr{grid-template-columns:minmax(0,1fr);row-gap:0}
    .cf-st{display:grid;grid-template-columns:26px minmax(0,1fr);column-gap:14px;align-items:start;justify-items:start;text-align:left;padding:0 0 16px}
    .cf-st>*:not(.cf-hf):not(.cf-nd){grid-column:2}
    .cf-nd{grid-column:1;grid-row:1 / span 6}
    .cf-tt{order:1;margin-top:4px}
    .cf-sb{order:2}
    .cf-tg{order:3;height:auto;margin:6px 0 0;justify-content:flex-start}
    .cf-tg:empty{display:none}
    .cf-ch,.cf-pls{order:4}
    .cf-pls{margin-top:6px}
    .cf-hf{top:0;bottom:auto;left:13px;right:auto;width:1px;height:auto}
    .cf-in{height:13px}
    .cf-out{top:13px;bottom:0}
    .cf-fl{width:100%;height:calc(var(--cfp) * 100%)}
    .cf-hf.is-dash{background:repeating-linear-gradient(180deg,#BDB3A4 0 4px,transparent 4px 7px)}
    .cf-hf.is-dash .cf-fl{background:repeating-linear-gradient(180deg,#1B1A18 0 4px,transparent 4px 7px)}
    .cf-dt{left:50%;top:calc(var(--cfp) * 100%)}
    .cf-st:last-child{padding-bottom:0}
  }
  @media (max-width:600px){.cf{padding:20px 18px 18px}}
</style>
