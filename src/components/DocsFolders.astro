---
/* "The approach" graphic: the dashboard as the single front door to one shared drive,
   one Process Documentation folder per department, one subfolder per business line.
   Inline SVG (illustration, not a screenshot) in the hairline language: a small dot travels
   from the Dashboard down the tree (SMIL, 10 s loop), the track turning solid behind it, and the
   subfolder pills' dots turn the page colour one by one. Reduced motion: the finished state.
   Folder names are the ones in the real library. */
import { THEMES, type ThemeName } from '../data/themes';
interface Props { theme?: ThemeName }
const { theme = 'documentation' } = Astro.props as Props;
const TH = THEMES[theme];
const subs = [
  { x: 56, y: 178, t: 'Grants' },
  { x: 198, y: 178, t: 'Community Fundraising' },
  { x: 56, y: 208, t: 'Systems & Automation' },
  { x: 198, y: 208, t: 'General' },
];
const folder = (x: number, y: number) => `M${x},${y + 3} h5.5 l1.6,-2.4 h5 v9.4 h-12.1 z`;
const T = 10, RESET = 9.3;
const k = (s: number) => (Math.min(T, s) / T).toFixed(4);
// the dot's route: dashboard -> shared drive -> down the tree to Operations -> into its subfolders
const legs = [
  { d: 'M180,58 V86', s: 0.4, e: 1.4 },
  { d: 'M26,126 V153 H40', s: 1.6, e: 2.5 },
  { d: 'M44,168 V191 H52', s: 2.7, e: 3.3 },
  { d: 'M44,191 V221 H52', s: 3.3, e: 3.9 },
];
const on = (s: number) => ({ v: '0;0;1;1;0;0', t: `0;${k(s)};${k(s + 0.3)};${k(RESET)};${k(RESET + 0.4)};1` });
const pillAt = [3.4, 3.7, 4.0, 4.3];
---
<svg class="dsf" viewBox="0 0 360 352" role="img" aria-label="Illustration: the dashboard sits on top as the single front door to the shared drive. In the shared drive, each department has one Process Documentation folder. Operations is open and shows a subfolder per business line, Grants, Community Fundraising and Systems and Automation, plus a General folder. Manufacturing and the other departments each have their own folder." style={`--p:${TH.primary}`}>
  <defs><marker id="dsf-a" viewBox="0 0 8 8" refX="4" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M1.5,1.5 L6,4 L1.5,6.5" fill="none" stroke="#A69B88" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" /></marker></defs>
  <rect class="dsf-panel" x=".5" y=".5" width="359" height="351" rx="5" />
  <rect class="dsf-dash" x="12" y="14" width="336" height="42" rx="5" />
  <text class="dsf-nt dsf-p" x="180" y="32" text-anchor="middle">Dashboard</text>
  <text class="dsf-ns" x="180" y="46" text-anchor="middle">the single front door</text>
  <path class="dsf-ar" d="M180,58 V84" marker-start="url(#dsf-a)" marker-end="url(#dsf-a)" />
  <text class="dsf-lg" x="192" y="75">find · start · edit</text>
  <rect class="dsf-root" x="12" y="88" width="336" height="36" rx="5" />
  <text class="dsf-nt dsf-w" x="180" y="110" text-anchor="middle">Shared drive</text>

  <path class="dsf-tree" d="M26,124 V261 M26,153 H40 M26,261 H40" />
  <path class="dsf-tree" d="M44,168 V221 M44,191 H52 M44,221 H52" />
  <g class="dsf-anim" aria-hidden="true">
    {legs.map((l) => (
      <path class="dsf-on" d={l.d} pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1">
        <animate attributeName="stroke-dashoffset" dur={`${T}s`} repeatCount="indefinite" values="1;1;0;0;1;1" keyTimes={`0;${k(l.s)};${k(l.e)};${k(RESET)};${k(RESET + 0.4)};1`} />
      </path>
    ))}
    {legs.map((l) => (
      <circle class="dsf-dot" r="3" opacity="0">
        <animateMotion path={l.d} dur={`${T}s`} repeatCount="indefinite" calcMode="linear" keyPoints="0;0;1;1" keyTimes={`0;${k(l.s)};${k(l.e)};1`} />
        <animate attributeName="opacity" dur={`${T}s`} repeatCount="indefinite" values="0;0;1;1;0;0" keyTimes={`0;${k(l.s - 0.05)};${k(l.s + 0.1)};${k(l.e - 0.1)};${k(l.e)};1`} />
      </circle>
    ))}
  </g>
  <g class="dsf-static" aria-hidden="true">{legs.map((l) => <path class="dsf-on" d={l.d} />)}</g>

  <rect class="dsf-dep" x="40" y="138" width="308" height="30" rx="4" />
  <path class="dsf-fo" d={folder(52, 148)} />
  <text class="dsf-nt" x="74" y="157">Operations Process Documentation</text>

  {subs.map((s, i) => (
    <g>
      <rect class="dsf-sub" x={s.x} y={s.y} width={s.t === 'Community Fundraising' || s.t === 'General' ? 142 : 136} height="24" rx="12" />
      <circle class="dsf-pd" cx={s.x + 14} cy={s.y + 12} r="2.6" />
      <circle class="dsf-pd dsf-pd-on dsf-static" cx={s.x + 14} cy={s.y + 12} r="2.6" />
      <circle class="dsf-pd dsf-pd-on dsf-anim" cx={s.x + 14} cy={s.y + 12} r="2.6" opacity="0">
        <animate attributeName="opacity" dur={`${T}s`} repeatCount="indefinite" values={on(pillAt[i]).v} keyTimes={on(pillAt[i]).t} />
      </circle>
      <text class="dsf-st" x={s.x + 25} y={s.y + 15.5}>{s.t}</text>
    </g>
  ))}

  <rect class="dsf-dep dsf-quiet" x="40" y="246" width="308" height="30" rx="4" />
  <path class="dsf-fo" d={folder(52, 256)} />
  <text class="dsf-nt" x="74" y="265">Manufacturing Process Documentation</text>

  <rect class="dsf-dep dsf-dash2" x="40" y="288" width="308" height="30" rx="4" />
  <text class="dsf-ns" x="194" y="307" text-anchor="middle">One Process Documentation folder per department</text>
  <text class="dsf-lg" x="44" y="340">Subfolders: one per business line, plus General</text>
</svg>
<style>
  .dsf{display:block;width:100%;height:auto;aspect-ratio:360/352;font-family:var(--fb);overflow:hidden}
  .dsf-panel{fill:#fff;stroke:var(--line,#E2DDD4)}
  .dsf-dash{fill:#fff;stroke:var(--p);stroke-width:1.2}
  .dsf-root{fill:var(--ink,#1B1A18)}
  .dsf-dep{fill:#fff;stroke:#CFC7BA;stroke-width:1}
  .dsf-quiet{fill:#FAF8F4}
  .dsf-dash2{fill:none;stroke:#A69B88;stroke-dasharray:3 4}
  .dsf-sub{fill:#fff;stroke:#CFC7BA}
  .dsf-tree{fill:none;stroke:#D9D2C6;stroke-width:1}
  .dsf-on{fill:none;stroke:var(--ink,#1B1A18);stroke-width:1.2}
  .dsf-dot{fill:var(--ink,#1B1A18)}
  .dsf-ar{fill:none;stroke:#A69B88;stroke-width:1}
  .dsf-fo{fill:#EFEAE2;stroke:#8A7F72;stroke-width:.8;stroke-linejoin:round}
  .dsf-pd{fill:#CFC7BA}
  .dsf-pd-on{fill:var(--p)}
  .dsf-nt{font-size:11.2px;font-weight:400;fill:var(--ink,#1B1A18)}
  .dsf-p{fill:var(--p)}
  .dsf-w{fill:#F4F0E8}
  .dsf-st{font-size:10.2px;fill:var(--ink,#1B1A18)}
  .dsf-ns{font-family:var(--mono);font-size:8.6px;fill:var(--muted,#6B665E);letter-spacing:.01em}
  .dsf-lg{font-family:var(--mono);font-size:8.4px;letter-spacing:.04em;fill:var(--muted,#6B665E)}
  .dsf-static{display:none}
  @media (prefers-reduced-motion:reduce){.dsf-anim{display:none}.dsf-static{display:inline}}
</style>
