---
/* "How data flows" diagram, in the hairline timeline language: numbered circular nodes on a
   thin track, one travelling dot per hop (SMIL, one 30 s clock), the track turning solid behind
   it, passed nodes filling cream and the node just reached pulsing in the accent.
   Two layouts (wide + narrow) so labels stay readable on phones. The visible list under the
   diagram (from dataFlows) is the text alternative. Reduced motion: a static, fully drawn state. */
import { dataFlows } from '../data/internal-dashboard';

type Place = 'a' | 'b' | 'r';
type Node = { id: string; x: number; y: number; n: string; t: string; s: string; kind?: 'core' | 'human'; at: Place };
type Edge = { id: string; d: string; style?: 'dash'; arrow?: boolean };
type Tone = 'ink' | 'light' | 'red';
type Move = { e: string; from: string; to: string; t0: number; t1: number; tone: Tone; label: string; rev?: boolean };
type Pin = { label: string; tone: Tone; at: [number, number]; lp?: 'u' | 'd' | 'r' };
type Layout = { key: string; w: number; h: number; nodes: Node[]; edges: Edge[]; note: { x: number; y: number; t: string; a?: 'end' }; pins: Pin[]; lp: { u: 'u' | 'r'; d: 'd' | 'r' }; lpe?: Record<string, 'u' | 'd' | 'r'> };

const T = 30; // one loop
const RESET = 29.2; // everything fades back to the start between RESET and T

const wide: Layout = {
  key: 'w', w: 1000, h: 404, lp: { u: 'u', d: 'd' },
  nodes: [
    { id: 'user', x: 84, y: 190, n: '01', t: 'Team member', s: 'Browser · phone · kiosk', at: 'a' },
    { id: 'access', x: 260, y: 190, n: '02', t: 'Cloudflare Access', s: 'Work Google sign-in', at: 'a' },
    { id: 'dash', x: 436, y: 190, n: '03', t: 'Dashboard', s: 'React + Vite', at: 'a' },
    { id: 'api', x: 612, y: 190, n: '04', t: 'API', s: 'Hono · same Worker', at: 'a' },
    { id: 'air', x: 900, y: 190, n: '05', t: 'Airtable', s: 'System of record', kind: 'core', at: 'a' },
    { id: 'docs', x: 900, y: 60, n: '06', t: 'Google Docs', s: 'Documentation', at: 'a' },
    { id: 'cal', x: 900, y: 340, n: '07', t: 'Google Calendar', s: 'One way · shifts, PTO', at: 'b' },
    { id: 'otis', x: 436, y: 340, n: '08', t: 'Ask Otis', s: 'Claude-powered', at: 'b' },
    { id: 'human', x: 612, y: 340, n: '09', t: 'Human approval', s: 'Required to save', kind: 'human', at: 'b' },
  ],
  edges: [
    { id: 'e12', d: 'M97,190 H247' },
    { id: 'e23', d: 'M273,190 H423' },
    { id: 'e34', d: 'M449,190 H599' },
    { id: 'e45', d: 'M625,190 H882' },
    { id: 'docs', d: 'M625,190 H728 Q740,190 740,178 V72 Q740,60 752,60 H887', arrow: true },
    { id: 'cal', d: 'M625,190 H728 Q740,190 740,202 V328 Q740,340 752,340 H887', arrow: true },
    { id: 'built', d: 'M436,204 V326', style: 'dash' },
    { id: 'sug', d: 'M449,340 H598', arrow: true },
    { id: 'ok', d: 'M612,326 V204', arrow: true },
  ],
  note: { x: 426, y: 270, t: 'built into the dashboard', a: 'end' },
  pins: [
    { label: 'task', tone: 'ink', at: [172, 190] }, { label: 'shift', tone: 'ink', at: [348, 190] },
    { label: 'task', tone: 'light', at: [524, 190], lp: 'd' },
    { label: 'doc', tone: 'ink', at: [740, 118], lp: 'r' }, { label: 'shift', tone: 'ink', at: [740, 270], lp: 'r' },
    { label: 'suggestion', tone: 'red', at: [524, 340] }, { label: 'approved', tone: 'red', at: [612, 266], lp: 'r' },
  ],
};

const narrow: Layout = {
  key: 'n', w: 360, h: 540, lp: { u: 'r', d: 'r' }, lpe: { ok: 'u', docs: 'u' },
  nodes: [
    { id: 'user', x: 26, y: 24, n: '01', t: 'Team member', s: 'Browser · phone · kiosk', at: 'r' },
    { id: 'access', x: 26, y: 100, n: '02', t: 'Cloudflare Access', s: 'Work Google sign-in', at: 'r' },
    { id: 'dash', x: 26, y: 176, n: '03', t: 'Dashboard', s: 'React + Vite', at: 'r' },
    { id: 'otis', x: 228, y: 236, n: '08', t: 'Ask Otis', s: 'Claude-powered', at: 'r' },
    { id: 'human', x: 228, y: 306, n: '09', t: 'Human approval', s: 'Required to save', kind: 'human', at: 'r' },
    { id: 'api', x: 26, y: 380, n: '04', t: 'API', s: 'Hono · same Worker', at: 'r' },
    { id: 'docs', x: 228, y: 432, n: '06', t: 'Docs', s: 'Google', at: 'r' },
    { id: 'air', x: 26, y: 470, n: '05', t: 'Airtable', s: 'System of record', kind: 'core', at: 'r' },
    { id: 'cal', x: 228, y: 512, n: '07', t: 'Calendar', s: 'Google · one way', at: 'r' },
  ],
  edges: [
    { id: 'e12', d: 'M26,37 V87' },
    { id: 'e23', d: 'M26,113 V163' },
    { id: 'e34', d: 'M26,189 V367' },
    { id: 'e45', d: 'M26,393 V453' },
    { id: 'docs', d: 'M26,393 V412 Q26,432 46,432 H215', arrow: true },
    { id: 'cal', d: 'M26,393 V412 Q26,432 46,432 H186 Q200,432 200,446 V498 Q200,512 214,512 H215', arrow: true },
    { id: 'built', d: 'M26,192 V216 Q26,236 46,236 H215', style: 'dash' },
    { id: 'sug', d: 'M228,249 V293', arrow: true },
    { id: 'ok', d: 'M228,319 V338 Q228,354 212,354 H42 Q26,354 26,367', arrow: true },
  ],
  note: { x: 128, y: 230, t: 'built in' },
  pins: [
    { label: 'task', tone: 'ink', at: [26, 62], lp: 'r' }, { label: 'PTO', tone: 'ink', at: [26, 290], lp: 'r' },
    { label: 'task', tone: 'light', at: [26, 320], lp: 'r' },
    { label: 'doc', tone: 'ink', at: [120, 432], lp: 'u' }, { label: 'shift', tone: 'ink', at: [200, 472], lp: 'r' },
    { label: 'suggestion', tone: 'red', at: [228, 271], lp: 'r' }, { label: 'approved', tone: 'red', at: [120, 354], lp: 'u' },
  ],
};

// The story, hop by hop (~2.4 s each): a request travels in and lands in Airtable, the API also
// saves a doc and pushes a shift to the calendar, Ask Otis suggests, a person approves, the
// approved change is written, then the read comes back to the team member. Then a pause.
const moves: Move[] = [
  { e: 'e12', from: 'user', to: 'access', t0: 0.8, t1: 3.2, tone: 'ink', label: 'task' },
  { e: 'e23', from: 'access', to: 'dash', t0: 3.2, t1: 5.6, tone: 'ink', label: 'task' },
  { e: 'e34', from: 'dash', to: 'api', t0: 5.6, t1: 8.0, tone: 'ink', label: 'task' },
  { e: 'e45', from: 'api', to: 'air', t0: 8.0, t1: 10.4, tone: 'ink', label: 'task' },
  { e: 'docs', from: 'api', to: 'docs', t0: 10.8, t1: 13.4, tone: 'ink', label: 'doc' },
  { e: 'cal', from: 'api', to: 'cal', t0: 10.8, t1: 13.4, tone: 'ink', label: 'shift' },
  { e: 'sug', from: 'otis', to: 'human', t0: 14.2, t1: 16.6, tone: 'red', label: 'suggestion' },
  { e: 'ok', from: 'human', to: 'api', t0: 16.6, t1: 19.0, tone: 'red', label: 'approved' },
  { e: 'e45', from: 'api', to: 'air', t0: 19.0, t1: 21.4, tone: 'red', label: 'approved' },
  { e: 'e45', from: 'air', to: 'api', t0: 21.8, t1: 23.4, tone: 'light', label: 'task', rev: true },
  { e: 'e34', from: 'api', to: 'dash', t0: 23.4, t1: 25.0, tone: 'light', label: 'task', rev: true },
  { e: 'e23', from: 'dash', to: 'access', t0: 25.0, t1: 26.6, tone: 'light', label: 'task', rev: true },
  { e: 'e12', from: 'access', to: 'user', t0: 26.6, t1: 28.2, tone: 'light', label: 'task', rev: true },
];
// senders that start a stream keep the accent fill (like the reference's first node)
const origins: Record<string, number> = { user: 0.2, otis: 13.6 };

// ── SMIL helpers: stops are [seconds, value] ──
const kt = (s: number) => Math.min(1, Math.max(0, s / T)).toFixed(4);
const anim = (attr: string, stops: [number, string | number][]) => {
  const st = [...stops].sort((a, b) => a[0] - b[0]);
  if (st[0][0] > 0) st.unshift([0, st[0][1]]);
  if (st[st.length - 1][0] < T) st.push([T, st[st.length - 1][1]]);
  // keep key times strictly increasing
  for (let i = 1; i < st.length; i++) if (st[i][0] <= st[i - 1][0]) st[i][0] = st[i - 1][0] + 0.001;
  return `<animate attributeName="${attr}" dur="${T}s" repeatCount="indefinite" values="${st.map((s) => s[1]).join(';')}" keyTimes="${st.map((s) => kt(s[0])).join(';')}"/>`;
};
const arrivals = (id: string) => moves.filter((m) => m.to === id).map((m) => m.t1);
const firstArrival = (id: string) => Math.min(...arrivals(id), Infinity);

// opacity of the cream "passed" layer
const passOp = (id: string) => {
  const a = firstArrival(id);
  if (!isFinite(a) || id in origins) return anim('opacity', [[0, 0]]);
  return anim('opacity', [[a + 0.7, 0], [a + 1.1, 1], [RESET, 1], [RESET + 0.6, 0]]);
};
// opacity of the accent "active" layer: on briefly at each arrival; origins stay on
const actOp = (id: string) => {
  if (id in origins) { const o = origins[id]; return anim('opacity', [[o, 0], [o + 0.4, 1], [RESET, 1], [RESET + 0.6, 0]]); }
  const st: [number, number][] = [[0, 0]];
  arrivals(id).sort((a, b) => a - b).forEach((a) => st.push([a - 0.05, 0], [a + 0.15, 1], [a + 0.9, 1], [a + 1.3, 0]));
  return anim('opacity', st);
};
const pulse = (id: string, r: number) => {
  const st: [number, number, number][] = [];
  arrivals(id).sort((a, b) => a - b).forEach((a) => st.push([a - 0.02, r, 0], [a + 0.02, r, 0.5], [a + 1.3, r + 9, 0]));
  if (!st.length) return '';
  return anim('r', st.map(([t, rr]) => [t, rr])) + anim('opacity', [[0, 0], ...st.map(([t, , o]) => [t, o] as [number, number])]);
};
// the track turns solid behind the first dot to pass along it
const draw = (e: Edge) => {
  const m = moves.find((x) => x.e === e.id);
  if (!m) return '';
  const from = m.rev ? -1 : 1;
  return anim('stroke-dashoffset', [[m.t0, from], [m.t1, 0], [RESET, 0], [RESET + 0.5, from]]) + anim('opacity', [[RESET, 1], [RESET + 0.5, 0], [T - 0.05, 0], [T, 1]]);
};
const firstMove = (e: Edge) => moves.find((x) => x.e === e.id);
const dotAnim = (L: Layout, m: Move) =>
  `<animateMotion dur="${T}s" repeatCount="indefinite" calcMode="linear" keyPoints="${m.rev ? '1;1;0;0' : '0;0;1;1'}" keyTimes="0;${kt(m.t0)};${kt(m.t1)};1"><mpath href="#df-${L.key}-${m.e}"/></animateMotion>` +
  anim('opacity', [[m.t0 - 0.2, 0], [m.t0 + 0.1, 1], [m.t1 - 0.25, 1], [m.t1, 0]]);

// label beside a moving or static dot: u = above, d = below, r = right
const lab = (txt: string, p: 'u' | 'd' | 'r') =>
  p === 'r' ? `<text class="dl" x="9" y="3.5">${txt}</text>` : `<text class="dl" y="${p === 'u' ? -10 : 17}" text-anchor="middle">${txt}</text>`;
const dotShape = (tone: Tone) => `<circle class="dd t-${tone}" r="${tone === 'light' ? 3.8 : 4.4}"/>`;

const nodeShape = (n: Node, cls: string, grow = 0) => {
  const r = 13 + grow;
  return n.kind === 'human'
    ? `<rect class="${cls}" x="${n.x - r}" y="${n.y - r}" width="${r * 2}" height="${r * 2}" rx="${4 + grow / 2}"/>`
    : `<circle class="${cls}" cx="${n.x}" cy="${n.y}" r="${r}"/>`;
};
const num = (n: Node, cls: string) => `<text class="nn ${cls}" x="${n.x}" y="${n.y + 3.6}" text-anchor="middle">${n.n}</text>`;
const nodeLabel = (n: Node) => {
  if (n.at === 'r') return `<text class="nt" x="${n.x + 22}" y="${n.y - 1}">${n.t}</text><text class="ns" x="${n.x + 22}" y="${n.y + 13}">${n.s}</text>`;
  const up = n.at === 'a';
  return `<text class="nt" x="${n.x}" y="${up ? n.y - 37 : n.y + 36}" text-anchor="middle">${n.t}</text><text class="ns" x="${n.x}" y="${up ? n.y - 22 : n.y + 51}" text-anchor="middle">${n.s}</text>`;
};

const svgBody = (L: Layout) => {
  const base = L.edges.map((e) => `<path class="ln${e.style === 'dash' ? ' ln-dash' : ''}" d="${e.d}"${e.arrow ? ` marker-end="url(#df-a-${L.key})"` : ''}/>`).join('');
  const note = `<text class="df-note" x="${L.note.x}" y="${L.note.y}"${L.note.a ? ' text-anchor="end"' : ''}>${L.note.t}</text>`;
  const solidStatic = L.edges.filter((e) => e.style !== 'dash').map((e) => `<path class="ln-on${['sug', 'ok'].includes(e.id) ? ' t-red' : ''}" d="${e.d}"/>`).join('');
  const solidAnim = L.edges.filter((e) => firstMove(e)).map((e) => `<path class="ln-on${firstMove(e)!.tone === 'red' ? ' t-red' : ''}" d="${e.d}" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1">${draw(e)}</path>`).join('');
  const pins = L.pins.map((p) => `<g transform="translate(${p.at[0]} ${p.at[1]})">${dotShape(p.tone)}${lab(p.label, p.lp ?? L.lp.u)}</g>`).join('');
  const dots = moves.map((m) => `<g opacity="0">${dotShape(m.tone)}${lab(m.label, L.lpe?.[m.e] ?? (m.tone === 'light' ? L.lp.d : L.lp.u))}${dotAnim(L, m)}</g>`).join('');
  const nodesBase = L.nodes.map((n) => (n.kind === 'core' ? nodeShape(n, 'ring', 4) : '') + (n.kind === 'human' ? nodeShape(n, 'ring', 4) : '') + nodeShape(n, 'nb') + num(n, 'n0')).join('');
  const nodesStatic = L.nodes.map((n) => (n.id in origins ? nodeShape(n, 'na') + num(n, 'n2') : nodeShape(n, 'np') + num(n, 'n1'))).join('');
  const nodesAnim = L.nodes.map((n) =>
    `<g opacity="0">${nodeShape(n, 'np')}${num(n, 'n1')}${passOp(n.id)}</g>` +
    `<g opacity="0">${nodeShape(n, 'na')}${num(n, 'n2')}${actOp(n.id)}</g>` +
    (pulse(n.id, 13) ? `<circle class="pz" cx="${n.x}" cy="${n.y}" r="13" opacity="0">${pulse(n.id, 13)}</circle>` : '')).join('');
  const labels = L.nodes.map(nodeLabel).join('');
  return { base, note, solidStatic, solidAnim, pins, dots, nodesBase, nodesStatic, nodesAnim, labels };
};
const parts = [wide, narrow].map((L) => ({ L, p: svgBody(L) }));
---
<figure class="df" data-dataflow>
  <figcaption class="df-head">
    <span class="tag">Illustration · not a screenshot</span>
    <span class="df-legend">
      <span><i class="t-ink"></i>Requests &amp; writes</span>
      <span><i class="t-light"></i>Reads coming back</span>
      <span><i class="t-red"></i>Ask Otis, gated by a person</span>
    </span>
  </figcaption>
  {parts.map(({ L, p }) => (
    <svg class={`df-svg df-${L.key}`} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`df-t-${L.key} df-d-${L.key}`}>
      <title id={`df-t-${L.key}`}>How data flows through the Internal Dashboard</title>
      <desc id={`df-d-${L.key}`}>A team member signs in with a work Google account through Cloudflare Access. Requests go from the Dashboard to the API, which runs on the same Cloudflare Worker. The API checks permissions, then reads and writes Airtable and saves docs to Google Docs. Shifts, PTO and sick days are pushed one way to Google Calendar; nothing comes back from the calendar. Ask Otis suggestions go to a person, and only what that person approves is written to Airtable. A text version follows the diagram.</desc>
      <defs>
        <marker id={`df-a-${L.key}`} viewBox="0 0 8 8" refX="6" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M1.5,1.5 L6,4 L1.5,6.5" fill="none" stroke="#A69B88" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" /></marker>
        {L.edges.map((e) => <path id={`df-${L.key}-${e.id}`} d={e.d} />)}
      </defs>
      <g aria-hidden="true">
        <g class="df-lines" set:html={p.base + p.note} />
        <g class="df-static" set:html={p.solidStatic + p.pins} />
        <g class="df-anim" set:html={p.solidAnim + p.dots} />
        <g class="df-nodes" set:html={p.nodesBase} />
        <g class="df-nodes df-static" set:html={p.nodesStatic} />
        <g class="df-nodes df-anim" set:html={p.nodesAnim} />
        <g class="df-labels" set:html={p.labels} />
      </g>
    </svg>
  ))}
</figure>
<details class="df-text">
  <summary>Text version of the diagram</summary>
  <ol>{dataFlows.map((f) => <li><b>{f.from} → {f.to}.</b> {f.carries}.</li>)}</ol>
</details>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-dataflow]').forEach((fig) => {
    const svgs = [...fig.querySelectorAll('svg')] as SVGSVGElement[];
    // reduced motion: CSS swaps the animated layers for the static, fully drawn state; stop the clock too
    const freeze = () => svgs.forEach((s) => s.pauseAnimations());
    if (reduce.matches) return freeze();
    // start the story from the top the first time it comes into view; pause off-screen
    let started = false;
    new IntersectionObserver(([e]) => {
      svgs.forEach((s) => {
        if (e.isIntersecting && !started) s.setCurrentTime(0);
        e.isIntersecting ? s.unpauseAnimations() : s.pauseAnimations();
      });
      if (e.isIntersecting) started = true;
    }, { threshold: 0.25 }).observe(fig);
    reduce.addEventListener?.('change', (e) => e.matches && freeze());
  });
</script>

<style>
  .df{margin:0;background:#fff;border:1px solid var(--line);border-radius:6px;padding:26px 32px 30px}
  .df-head{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:10px 24px;margin-bottom:22px}
  .df-head .tag{font-family:var(--mono);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--accent)}
  .df-legend{display:flex;flex-wrap:wrap;gap:6px 20px;font-family:var(--mono);font-size:11px;letter-spacing:.02em;color:var(--muted)}
  .df-legend i{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:8px;vertical-align:0}
  .df-legend i.t-ink{background:var(--ink)}
  .df-legend i.t-light{background:#fff;box-shadow:inset 0 0 0 1.2px var(--ink)}
  .df-legend i.t-red{background:var(--accent)}
  .df-svg{display:block;width:100%;height:auto;font-family:var(--fb);overflow:visible}
  .df-n{display:none;max-width:420px;margin:0 auto}
  @media (max-width:860px){.df{padding:20px 14px 22px}.df-head{margin-bottom:16px}.df-w{display:none}.df-n{display:block}}
  .df-svg :global(.ln){fill:none;stroke:#D9D2C6;stroke-width:1}
  .df-svg :global(.ln-dash){stroke:#A69B88;stroke-dasharray:3 4}
  .df-svg :global(.ln-on){fill:none;stroke:var(--ink);stroke-width:1.2}
  .df-svg :global(.ln-on.t-red){stroke:var(--accent)}
  .df-svg :global(.df-note){font-family:var(--mono);font-size:10.5px;fill:var(--muted);letter-spacing:.02em}
  .df-svg :global(.nb){fill:#fff;stroke:#CFC7BA;stroke-width:1}
  .df-svg :global(.ring){fill:none;stroke:#CFC7BA;stroke-width:1}
  .df-svg :global(.np){fill:#EFEAE2;stroke:var(--ink);stroke-width:1}
  .df-svg :global(.na){fill:var(--accent);stroke:var(--accent);stroke-width:1}
  .df-svg :global(.pz){fill:none;stroke:var(--accent);stroke-width:1.2}
  .df-svg :global(.nn){font-family:var(--mono);font-size:10px;letter-spacing:.02em}
  .df-svg :global(.n0){fill:#A69B88}
  .df-svg :global(.n1){fill:var(--ink)}
  .df-svg :global(.n2){fill:#fff}
  .df-svg :global(.nt){font-size:15px;font-weight:400;fill:var(--ink);letter-spacing:.005em}
  .df-svg :global(.ns){font-family:var(--mono);font-size:10.5px;fill:var(--muted);letter-spacing:.01em}
  .df-n :global(.nt){font-size:14px}
  .df-n :global(.ns){font-size:9.5px}
  .df-svg :global(.dd.t-ink){fill:var(--ink)}
  .df-svg :global(.dd.t-light){fill:#fff;stroke:var(--ink);stroke-width:1.2}
  .df-svg :global(.dd.t-red){fill:var(--accent)}
  .df-svg :global(.dl){font-family:var(--mono);font-size:10px;fill:var(--ink);letter-spacing:.02em;paint-order:stroke;stroke:#fff;stroke-width:3px;stroke-linejoin:round}
  .df-static{display:none}
  @media (prefers-reduced-motion:reduce){.df-anim{display:none}.df-static{display:inline}}
  .df-text{margin-top:16px;font-size:15px;border-bottom:1px solid var(--line);padding-bottom:12px}
  .df-text summary{cursor:pointer;font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
  .df-text summary:hover{color:var(--ink)}
  .df-text ol{margin:12px 0 0 1.3em;max-width:72ch}
  .df-text li{margin:.35em 0}.df-text li::marker{color:var(--accent)}
  .df-text b{font-weight:500}
</style>
