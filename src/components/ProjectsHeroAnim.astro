<g class="pha-a2"><line x1="434" y1="160" x2="474" y2="160"></line><path d="M467 154 L475 160 L467 166"></path></g>
<g class="pha-a3"><line x1="654" y1="160" x2="694" y2="160"></line><path d="M687 154 L695 160 L687 166"></path></g>
</g>
<path class="pha-fbk" d="M785 254 C785 330 565 330 565 254" fill="none" stroke="#7E2320" stroke-width="2" stroke-dasharray="300"></path>
<g class="pha-fbl"><path d="M558 264 L565 253 L572 264" fill="none" stroke="#7E2320" stroke-width="2"></path><text class="pha-mono" x="675" y="336" text-anchor="middle" font-size="11" fill="#7E2320" letter-spacing="1.5">BUILD IN FEEDBACK</text></g>
</svg>

<div class="pha-nd pha-n1" style="left: 40px"><span class="pha-num pha-mono">01</span><b>Ideate</b><span class="pha-sub pha-mono">a new process</span>
<svg width="138" height="56" viewBox="0 0 138 56" aria-hidden="true"><rect x="0" y="10" width="38" height="38" rx="3" fill="#F1ECE6" transform="rotate(-5 19 29)"></rect><rect x="48" y="6" width="38" height="38" rx="3" fill="#F1ECE6" transform="rotate(4 67 25)"></rect><rect x="96" y="12" width="38" height="38" rx="3" fill="#FFFFFF" stroke="#7E2320" stroke-width="1.5"></rect><rect x="104" y="22" width="22" height="4" rx="2" fill="#7E2320"></rect><rect x="104" y="31" width="16" height="4" rx="2" fill="#CFC7BA"></rect></svg>
</div>
<div class="pha-nd pha-n2" style="left: 260px"><span class="pha-num pha-mono">02</span><b>Design</b><span class="pha-sub pha-mono">with Claude</span>
<svg width="138" height="56" viewBox="0 0 138 56" aria-hidden="true"><rect x="0" y="4" width="92" height="22" rx="11" fill="#F1ECE6"></rect><rect x="12" y="13" width="60" height="4" rx="2" fill="#B8AFA2"></rect><rect x="36" y="32" width="102" height="22" rx="11" fill="#1C1A19"></rect><rect x="48" y="41" width="70" height="4" rx="2" fill="#CFC7BA"></rect></svg>
</div>
<div class="pha-nd pha-n3" style="left: 480px"><span class="pha-num pha-mono">03</span><b>Build</b><span class="pha-sub pha-mono">Grok Bot · Cursor</span>
<svg width="138" height="56" viewBox="0 0 138 56" aria-hidden="true"><rect x="0" y="0" width="138" height="56" rx="6" fill="#1C1A19"></rect><rect class="pha-ty pha-ty1" x="12" y="12" width="62" height="5" rx="2.5" fill="#CFC7BA"></rect><rect class="pha-ty pha-ty2" x="12" y="25" width="78" height="5" rx="2.5" fill="#C9625C"></rect><rect class="pha-ty pha-ty3" x="12" y="38" width="54" height="5" rx="2.5" fill="#CFC7BA"></rect><rect x="104" y="26" width="24" height="20" rx="4" fill="#F1ECE6"></rect><circle cx="111" cy="35" r="2.5" fill="#1C1A19"></circle><circle cx="121" cy="35" r="2.5" fill="#1C1A19"></circle><line x1="116" y1="20" x2="116" y2="26" stroke="#F1ECE6" stroke-width="2"></line></svg>
</div>
<div class="pha-nd pha-n4" style="left: 700px"><span class="pha-num pha-mono">04</span><b>Feedback</b><span class="pha-sub pha-mono">from the team</span>
<svg width="138" height="56" viewBox="0 0 138 56" aria-hidden="true"><circle cx="14" cy="38" r="13" fill="#CFC7BA" stroke="#FFFFFF" stroke-width="2"></circle><circle cx="34" cy="38" r="13" fill="#8C8478" stroke="#FFFFFF" stroke-width="2"></circle><circle cx="54" cy="38" r="13" fill="#1C1A19" stroke="#FFFFFF" stroke-width="2"></circle><rect x="74" y="4" width="64" height="30" rx="8" fill="#FFFFFF" stroke="#1C1A19" stroke-width="1.5"></rect><rect x="84" y="13" width="40" height="4" rx="2" fill="#7E2320"></rect><rect x="84" y="22" width="28" height="4" rx="2" fill="#CFC7BA"></rect></svg>
</div>

<div class="pha-doc pha-mono">
<div class="pha-hd"><span><b>Changelog</b> · v2</span><span>Docs synced</span></div>
<div class="pha-dl pha-d1"><i></i><span></span></div>
<div class="pha-dl pha-d2"><i></i><span></span></div>
<div class="pha-dl pha-d3"><i></i><span></span></div>
<span class="pha-dp"><svg width="12" height="10" viewBox="0 0 12 10" aria-hidden="true"><path d="M1 5l3.5 3.5L11 1.5" fill="none" stroke="#FFFFFF" stroke-width="2"></path></svg>Documented</span>
</div>
</div>
      </div>
    </div>
    <div class="pha-cap pha-mono">
<div class="pha-lab pha-l1"><b>01</b> Messy data, broken handoffs</div>
<div class="pha-lab pha-l2"><b>02</b> Lasso it together, build new links</div>
<div class="pha-lab pha-l3"><b>03</b> One flow that runs in seconds</div>
<div class="pha-lab pha-l4"><b>04</b> Ideate · design · build · feedback</div>
<div class="pha-lab pha-l5"><b>05</b> Build in feedback, document it</div>
<div class="pha-tagr">Operations · Systems</div>
<div class="pha-prog"></div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-pha]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-pha-stage]')!;
    const fit = () => {
      const w = stage.clientWidth, h = stage.clientHeight;
      if (w && h) root.style.setProperty('--s', String(Math.min(w / 900, h / 512)));
    };
    fit();
    new ResizeObserver(fit).observe(stage);
    let onScreen = true, tabShown = !document.hidden;
    const sync = () => root.classList.toggle('pha-paused', !(onScreen && tabShown));
    new IntersectionObserver((e) => { onScreen = e[e.length - 1].isIntersecting; sync(); }, { threshold: 0.05 }).observe(root);
    document.addEventListener('visibilitychange', () => { tabShown = !document.hidden; sync(); });
  });
</script>

<style>

