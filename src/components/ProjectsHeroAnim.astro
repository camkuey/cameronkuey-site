---
/* Projects hero animation (Cam's artifact, ported). 900x512 arena scaled to the column by a tiny script
   (--s), captions + progress bar kept at native size below it so they stay legible. 15 s CSS loop, paused off-screen
   and in hidden tabs. Reduced motion: final frame, caption 05, full bar. Fills its parent (.pj-hero-media). */
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
const label = 'Fifteen-second animation: scattered tools with broken links get lassoed together, line up into one fast automated flow, then a build loop runs from ideate to design in Claude, build with Grok Bot and Cursor, team feedback, a rebuild, and a documented changelog.';
---
<div class:list={['pha', { 'pha-dark': dark }]} data-pha role="img" aria-label={label}>
  <div class="pha-st" aria-hidden="true">
    <div class="pha-stage" data-pha-stage>
      <div class="pha-ar">
<svg class="pha-ov pha-brk" width="900" height="512" viewBox="0 0 900 512" aria-hidden="true">
<g stroke="#B8AFA2" stroke-width="2" stroke-dasharray="6 8" fill="none">
<line x1="150" y1="98" x2="390" y2="68"></line>
<line x1="390" y1="68" x2="490" y2="278"></line>
<line x1="200" y1="328" x2="490" y2="278"></line>
<line x1="680" y1="118" x2="720" y2="348"></line>
<line x1="150" y1="98" x2="200" y2="328"></line>
</g>
<g stroke="#7E2320" stroke-width="2.5" stroke-linecap="round">
<path d="M264 77 l12 12 M276 77 l-12 12"></path>
<path d="M339 297 l12 12 M351 297 l-12 12"></path>
<path d="M694 227 l12 12 M706 227 l-12 12"></path>
</g>
</svg>

<svg class="pha-ov" width="900" height="512" viewBox="0 0 900 512" aria-hidden="true">
<line class="pha-rail" x1="90" y1="238" x2="810" y2="238" stroke="#1C1A19" stroke-width="2"></line>
<g class="pha-lk" stroke="#1C1A19" stroke-width="2">
<line x1="340" y1="188" x2="390" y2="188"></line><line x1="510" y1="188" x2="560" y2="188"></line>
<line x1="340" y1="288" x2="390" y2="288"></line><line x1="510" y1="288" x2="560" y2="288"></line>
<line x1="280" y1="216" x2="280" y2="260"></line><line x1="450" y1="216" x2="450" y2="260"></line><line x1="620" y1="216" x2="620" y2="260"></line>
</g>
</svg>

<div class="pha-cards">
<div class="pha-cd pha-k1"><i style="background: #1C1A19"></i>Sheet<span class="pha-bad">!</span></div>
<div class="pha-cd pha-k2"><i style="background: #8C8478"></i>Email</div>
<div class="pha-cd pha-k3"><i style="background: #7E2320"></i>Zendesk</div>
<div class="pha-cd pha-k4"><i style="background: #CFC7BA"></i>Slack</div>
<div class="pha-cd pha-k5"><i style="background: #1C1A19"></i>Docs<span class="pha-bad">!</span></div>
<div class="pha-cd pha-k6"><i style="background: #7E2320"></i>Airtable</div>
</div>

<svg class="pha-ov" width="900" height="512" viewBox="0 0 900 512" aria-hidden="true">
<ellipse class="pha-las" cx="450" cy="238" rx="420" ry="215" fill="none" stroke="#7E2320" stroke-width="3" stroke-linecap="round"></ellipse>
<g class="pha-pk"><circle cx="90" cy="238" r="8" fill="#7E2320" stroke="#FFFFFF" stroke-width="3"></circle></g>
</svg>

<div class="pha-pill pha-mono">Runs on its own · <b>seconds</b></div>

<div class="pha-sd">
<svg class="pha-ov" width="900" height="512" viewBox="0 0 900 512" aria-hidden="true">
<g stroke="#1C1A19" stroke-width="2" fill="none">
