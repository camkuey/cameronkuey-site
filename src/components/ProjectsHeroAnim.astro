@media (prefers-reduced-motion: reduce){
*{animation:none !important}
.pha-cards,.pha-brk,.pha-las,.pha-lk,.pha-rail,.pha-pk,.pha-pill{display:none}
.pha-lab{display:none}.pha-l5{display:flex}
.pha-prog{width:100%}
}

/* component frame: fills .pj-hero-media; native-size caption bar under the scaled arena */
.pha{position:absolute;inset:0;--capH:48px;container-type:inline-size}
.pha-paused *{animation-play-state:paused !important}
@container (max-width:640px){.pha-tagr{display:none}}
@container (max-width:480px){.pha-lab{left:16px;font-size:11px;letter-spacing:.1em;gap:8px}}
@container (max-width:360px){.pha-lab{font-size:10.5px;letter-spacing:.08em;gap:6px}}
@media (max-width:520px){.pha{--capH:44px}}

/* Dark variant for the blueprint hero on /projects: cream and sage linework on ink, the accent lifted for contrast.
   Overrides the inline SVG colours by attribute (CSS beats presentation attributes). */
.pha-dark{--ln:#A9C2A1;--tx:#EFEAE1;--ac:#E08A7C;--sf:rgba(239,234,225,.06)}
.pha-dark .pha-st{background:transparent;color:var(--tx)}
.pha-dark .pha-cd,.pha-dark .pha-nd,.pha-dark .pha-pill,.pha-dark .pha-doc{background:var(--sf);border-color:rgba(169,194,161,.55);color:var(--tx);box-shadow:none}
.pha-dark .pha-nd{box-shadow:inset 0 3px 0 var(--ac)}
.pha-dark .pha-nd .pha-num,.pha-dark .pha-nd .pha-sub,.pha-dark .pha-doc .pha-hd,.pha-dark .pha-tagr{color:rgba(239,234,225,.62)}
