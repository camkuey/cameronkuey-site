---
/* Decorative motif for the case-study hero bands and the /case-studies cards, in the hairline
   timeline language: four numbered circular nodes on a thin track, one small oxblood dot
   travelling along it (SMIL, ~3 s per hop, then a pause). Passed nodes fill cream; the last
   node (the result) keeps a thin oxblood ring. Hidden dot under reduced motion; purely
   decorative, so aria-hidden. */
interface Props { kind: 'circles' | 'contract' | 'roadmap'; variant?: 'hero' | 'card' }
const { kind, variant = 'hero' } = Astro.props as Props;
const K = { red: '#881919', ink: '#1B1A18', cream: '#EFEAE2', line: '#CFC7BA', grey: '#A69B88' };
const pts: [number, number][] = kind === 'contract' ? [[90, 200], [205, 120], [320, 190], [420, 110]] : kind === 'roadmap' ? [[70, 190], [190, 130], [300, 196], [414, 118]] : [[70, 200], [190, 140], [292, 196], [414, 118]];
const path = 'M' + pts.map((p) => p.join(',')).join(' L');
const T = 12; // 3 hops of 3 s, then a 3 s pause
// cumulative length along the track, so the dot moves at a steady pace and the nodes fill on arrival
const segs = pts.slice(1).map((p, i) => Math.hypot(p[0] - pts[i][0], p[1] - pts[i][1]));
const total = segs.reduce((a, b) => a + b, 0);
const kp = ['0']; let acc = 0; segs.forEach((l) => { acc += l; kp.push((acc / total).toFixed(4)); });
const hop = 3 / T;
const arrive = (i: number) => +(i * hop).toFixed(4);
---
<svg class={`cm cm-${variant}`} viewBox="0 0 480 300" aria-hidden="true" focusable="false">
  <path d={path} fill="none" stroke={K.line} stroke-width="1.5" stroke-linejoin="round" />
  <path class="cm-anim" d={path} fill="none" stroke={K.ink} stroke-width="1.5" stroke-linejoin="round" pathLength="1" stroke-dasharray="1 1" stroke-dashoffset="1">
    <animate attributeName="stroke-dashoffset" dur={`${T}s`} repeatCount="indefinite" values="1;0;0;1" keyTimes={`0;${arrive(3)};0.96;1`} />
  </path>
  {pts.map(([x, y], i) => (
    <g>
      <circle cx={x} cy={y} r="22" fill="#fff" stroke={i === 3 ? K.red : K.line} stroke-width={i === 3 ? 1.5 : 1.2} />
      {i > 0 && (
        <circle class="cm-anim" cx={x} cy={y} r="22" fill={K.cream} stroke={K.ink} stroke-width="1.2" opacity="0">
          <animate attributeName="opacity" dur={`${T}s`} repeatCount="indefinite" values="0;0;1;1;0" keyTimes={`0;${(arrive(i) - 0.01).toFixed(4)};${(arrive(i) + 0.02).toFixed(4)};0.96;1`} />
        </circle>
      )}
      {i === 0 && <circle cx={x} cy={y} r="22" fill={K.red} />}
      <text x={x} y={y + 5} text-anchor="middle" font-size="14" fill={i === 0 ? '#fff' : K.ink} font-family="ui-monospace, SFMono-Regular, Menlo, Consolas, monospace">{`0${i + 1}`}</text>
    </g>
  ))}
  <circle class="cm-dot" r="6" fill={K.red}>
    <animateMotion path={path} dur={`${T}s`} repeatCount="indefinite" calcMode="linear" keyPoints={`${kp.join(';')};1`} keyTimes={`0;${arrive(1)};${arrive(2)};${arrive(3)};1`} />
    <animate attributeName="opacity" dur={`${T}s`} repeatCount="indefinite" values="0;1;1;0;0" keyTimes={`0;0.03;${(arrive(3) - 0.02).toFixed(4)};${arrive(3)};1`} />
  </circle>
</svg>
<style>
  .cm{display:block;width:100%;height:auto;aspect-ratio:480/300}
  /* reduced motion: the finished state, line solid and nodes passed, no moving dot */
  @media (prefers-reduced-motion:reduce){.cm-dot{display:none}.cm-anim{opacity:1!important;stroke-dashoffset:0!important}}
</style>
