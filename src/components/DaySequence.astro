---
/* "A day in the dashboard": steps that auto-advance (and can be clicked).
   Without JS, or with reduced motion, it degrades to a static, readable sequence.
   Each step shows a real screenshot (sample data) from daySequence.screenshots
   in src/data/internal-dashboard.ts; a step without one shows a plain placeholder. */
import Pic from './Pic.astro';
import { daySequence } from '../data/internal-dashboard';
const { steps, screenshots } = daySequence;
const n2 = (i: number) => String(i + 1).padStart(2, '0');
---
<div class="dy" data-day style={`--n:${steps.length}`}>
  <div class="dy-nav" role="tablist" aria-label="A day in the dashboard" hidden>
    {steps.map((s, i) => (
      <button class="dy-tab" role="tab" id={`dy-tab-${s.id}`} aria-controls={`dy-step-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="dy-bar" aria-hidden="true"><i class="dy-fill"></i></span>
        <span class="dy-n">{n2(i)}</span><span class="dy-t">{s.title}</span>
      </button>
    ))}
  </div>
  <button class="dy-pause" type="button" hidden aria-pressed="false">Pause</button>
  <ol class="dy-steps">
    {steps.map((s, i) => {
      const shot = screenshots[s.id];
      return (
        <li class={`dy-step${i === 0 ? ' is-active' : ''}`} id={`dy-step-${s.id}`} aria-labelledby={`dy-h-${s.id}`}>
          <div class="dy-copy">
            <p class="dy-num">{n2(i)}</p>
            <h3 id={`dy-h-${s.id}`}>{s.title}</h3>
            <p>{s.body}</p>
          </div>
          <div class={`dy-art${shot ? ' has-shot' : ''}`} data-screenshot-slot={s.id}>
            {shot ? (
              <>
                <span class="tag">Sample data</span>
                <Pic id={shot.id} alt={shot.alt} sizes="(max-width: 900px) 100vw, 760px" />
              </>
            ) : (
              <span class="tag">Screenshot coming soon</span>
            )}
          </div>
        </li>
      );
    })}
  </ol>
  <div class="dy-ctrl" hidden>
    <button class="dy-arrow dy-prev" type="button" aria-label="Previous step"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <span class="dy-count" aria-live="polite"><b class="dy-cur">01</b> / {String(steps.length).padStart(2, '0')}</span>
    <button class="dy-arrow dy-next" type="button" aria-label="Next step"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <span class="dy-dots" aria-hidden="true">{steps.map(() => <i></i>)}</span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-day]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.dy-tab')];
    const steps = [...root.querySelectorAll<HTMLElement>('.dy-step')];
    const nav = root.querySelector<HTMLElement>('.dy-nav')!;
    const btn = root.querySelector<HTMLButtonElement>('.dy-pause')!;
    const ctrl = root.querySelector<HTMLElement>('.dy-ctrl')!;
    const cnt = root.querySelector<HTMLElement>('.dy-cur')!;
    const dots = [...root.querySelectorAll<HTMLElement>('.dy-dots i')];
    const track = root.querySelector<HTMLElement>('.dy-steps')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, userPaused = false, hover = false, seen = false;
    root.classList.add('is-live');
    if (still) root.classList.add('is-static');
    nav.hidden = false;
    ctrl.hidden = false;
    ctrl.appendChild(btn);
    btn.hidden = still;
    steps.forEach((s) => s.setAttribute('role', 'tabpanel'));
    const sync = () => { root.classList.toggle('is-paused', still || userPaused || hover || !seen); };
    const show = (i: number, focus = false, dir = 0) => {
      const prev = cur;
      cur = (i + steps.length) % steps.length;
      const d = dir || (cur >= prev ? 1 : -1);
      root.style.setProperty('--dir', String(d));
      cnt.textContent = String(cur + 1).padStart(2, '0');
      dots.forEach((x, k) => x.classList.toggle('on', k === cur));
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === cur)); t.tabIndex = k === cur ? 0 : -1; });
      steps.forEach((s, k) => { s.hidden = k !== cur; s.classList.toggle('is-active', k === cur); });
      if (focus) tabs[cur].focus();
    };
    const pause = (p: boolean) => { userPaused = p; btn.textContent = p ? 'Play' : 'Pause'; btn.setAttribute('aria-pressed', String(p)); sync(); };
    tabs.forEach((t, k) => {
      t.addEventListener('click', () => { show(k); pause(true); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); show(cur + d, true); pause(true); }
      });
    });
    btn.addEventListener('click', () => pause(!userPaused));
    root.querySelector('.dy-prev')!.addEventListener('click', () => { show(cur - 1, false, -1); pause(true); });
    root.querySelector('.dy-next')!.addEventListener('click', () => { show(cur + 1, false, 1); pause(true); });
    let x0 = 0;
    track.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => { const dx = e.changedTouches[0].clientX - x0; if (Math.abs(dx) > 50) { show(cur + (dx < 0 ? 1 : -1), false, dx < 0 ? 1 : -1); pause(true); } }, { passive: true });
    // the progress bar's CSS animation drives auto-advance
    root.addEventListener('animationend', (e) => { if (!still && (e.target as Element).classList.contains('dy-fill')) show(cur + 1, false, 1); });
    const art = track;
    art.addEventListener('pointerenter', () => { hover = true; sync(); });
    art.addEventListener('pointerleave', () => { hover = false; sync(); });
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }, { threshold: 0.35 }).observe(root);
    show(0); sync();
  });
</script>

<style>
  .dy-nav{display:grid;grid-template-columns:repeat(var(--n),1fr);gap:14px;margin-bottom:28px}
  .dy-nav[hidden]{display:none}
  .dy-tab{all:unset;cursor:pointer;display:grid;grid-template-columns:auto 1fr;gap:4px 10px;align-items:baseline;padding-top:14px;position:relative;color:var(--muted)}
  .dy-tab:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
  .dy-tab:hover,.dy-tab[aria-selected=true]{color:var(--ink)}
  .dy-bar{position:absolute;left:0;right:0;top:0;height:2px;background:var(--line);overflow:hidden}
  .dy-fill{position:absolute;inset:0;background:var(--accent);transform:scaleX(0);transform-origin:left}
  .dy-tab[aria-selected=true] .dy-fill{animation:dy-fill 7s linear forwards}
  .is-paused .dy-fill{animation-play-state:paused!important}
  .is-static .dy-tab[aria-selected=true] .dy-fill{animation:none;transform:none}
  .dy-n{font-size:12px;letter-spacing:.24em;font-weight:500;color:var(--accent)}
  .dy-t{font-size:14px;line-height:1.35}
  .dy-pause{all:unset;cursor:pointer;float:right;margin:-12px 0 8px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:500;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:6px 14px}
  .dy-pause:hover{color:var(--ink);border-color:var(--ink)}
  .dy-pause:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .dy-pause[hidden]{display:none}
  .dy-steps{list-style:none;clear:both}
  .dy-step{display:grid;grid-template-columns:minmax(220px,1fr) 2fr;gap:24px 64px;align-items:center;border-top:1px solid var(--line);padding:28px 0}
  .is-live .dy-step{border-top:0;padding:0}
  /* stack panels in one cell so the block keeps the tallest panel's height (no jumps) */
  .is-live .dy-steps{display:grid}
  .is-live .dy-step{grid-area:1/1;align-content:start}
  .is-live .dy-step[hidden]{display:grid;visibility:hidden}
  .is-live .dy-step.is-active{animation:dy-in .45s ease-out}
  .dy-num{font-size:12px;letter-spacing:.24em;font-weight:500;color:var(--accent)}
  .dy-copy h3{font-weight:300;font-size:clamp(26px,2.4vw,34px);letter-spacing:-.02em;line-height:1.12;margin:8px 0 12px}
  .dy-copy p:last-child{color:var(--muted);max-width:38ch}
  .dy-art{background:#EDE7DC;position:relative;padding:56px 40px 40px;border-radius:4px;min-height:240px;display:flex;align-items:center;justify-content:center}
  .dy-art .tag{position:absolute;top:16px;left:16px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;background:#fff;color:var(--muted);padding:6px 10px;border:1px dashed #B9B2A6}
  .dy-art.has-shot{padding:52px 16px 16px}
  .dy-art :global(picture){display:block;width:100%}
  .dy-art :global(img){display:block;width:100%;height:auto;border-radius:6px;box-shadow:0 20px 40px -24px rgba(40,30,20,.4)}
  @keyframes dy-fill{to{transform:scaleX(1)}}
  @keyframes dy-in{from{opacity:0;transform:translateX(calc(var(--dir,1) * 36px))}}
  .dy-ctrl{display:flex;align-items:center;gap:14px;margin-top:20px;justify-content:flex-end}
  .dy-ctrl[hidden]{display:none}
  .dy-arrow{all:unset;cursor:pointer;width:44px;height:44px;border:1px solid var(--ink);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;color:var(--ink);transition:background .15s,color .15s}
  .dy-arrow:hover{background:var(--ink);color:var(--bg)}
  .dy-arrow:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .dy-count{font-size:13px;letter-spacing:.18em;color:var(--muted);min-width:70px;text-align:center}
  .dy-count b{color:var(--ink);font-weight:500}
  .dy-dots{display:flex;gap:6px;margin-left:8px}
  .dy-dots i{width:6px;height:6px;border-radius:50%;background:var(--line);transition:background .2s,transform .2s}
  .dy-dots i.on{background:var(--accent);transform:scale(1.4)}
  .dy-ctrl .dy-pause{float:none;margin:0 0 0 8px}

  @media (max-width:900px){
    .dy-step{grid-template-columns:1fr;gap:18px}
    .dy-nav{gap:8px}
    .dy-t{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .dy-ctrl{justify-content:space-between}
    .dy-dots{display:none}
  }
  @media (max-width:560px){
    .dy-art.has-shot{padding:44px 8px 8px}
  }
</style>
