---
/* "A day in the dashboard": 5 steps that auto-advance (and can be clicked).
   Without JS, or with reduced motion, it degrades to a static, readable sequence.
   Screenshot slots: add a path to daySequence.screenshots[stepId] in
   src/data/internal-dashboard.ts and it replaces that step's illustration. */
import { daySequence } from '../data/internal-dashboard';
const { steps, screenshots } = daySequence;
const n2 = (i: number) => String(i + 1).padStart(2, '0');
const alt: Record<string, string> = {
  meeting: 'Illustration: transcript lines on the left turn into proposed tasks on the right, each marked approved.',
  focus: 'Illustration: three team members, each given a daily focus.',
  today: 'Illustration: a phone showing the Today view with the person’s focus at the top and their tasks below.',
  work: 'Illustration: the person clocks in, checks off tasks, and each update is saved to Airtable.',
  otis: 'Illustration: Ask Otis suggests a milestone and flags a possible duplicate; a person presses Approve.',
};
---
<div class="dy" data-day>
  <div class="dy-nav" role="tablist" aria-label="A day in the dashboard" hidden>
    {steps.map((s, i) => (
      <button class="dy-tab" role="tab" id={`dy-tab-${s.id}`} aria-controls={`dy-step-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
        <span class="dy-bar" aria-hidden="true"><i class="dy-fill"></i></span>
        <span class="dy-n">{n2(i)}</span><span class="dy-t">{s.title}</span>
      </button>
    ))}
  </div>
  <button class="dy-pause" type="button" hidden aria-pressed="false">Pause</button>
  <ol class="dy-steps">
    {steps.map((s, i) => {
      const shot = screenshots[s.id];
      return (
        <li class={`dy-step${i === 0 ? ' is-active' : ''}`} id={`dy-step-${s.id}`} aria-labelledby={`dy-h-${s.id}`}>
          <div class="dy-copy">
            <p class="dy-num">{n2(i)}</p>
            <h3 id={`dy-h-${s.id}`}>{s.title}</h3>
            <p>{s.body}</p>
          </div>
          <div class={`dy-art${shot ? ' has-shot' : ''}`} data-screenshot-slot={s.id}>
            {shot ? (
              <>
                <span class="tag">Sample data</span>
                <img src={shot} alt={`${s.title}: dashboard screenshot, sample data`} loading="lazy" />
              </>
            ) : (
              <>
                <span class="tag">Illustration · not a screenshot</span>
                <div class={`dy-ui u-${s.id}`} role="img" aria-label={alt[s.id]}>
                  {s.id === 'meeting' && (
                    <div class="mt" aria-hidden="true">
                      <div class="col"><p class="lbl">Transcript</p>
                        {[78, 92, 64, 86, 55].map((w, k) => <div class="ln" style={`--d:${k * 0.18}s`}><i class="spk"></i><i class="bar" style={`width:${w}%`}></i></div>)}
                      </div>
                      <div class="mt-arrow"><span>→</span></div>
                      <div class="col"><p class="lbl">Proposed tasks</p>
                        {[70, 85, 60].map((w, k) => <div class="task" style={`--d:${1.2 + k * 0.3}s;--d2:${2.6 + k * 0.35}s`}><i class="box"></i><i class="bar" style={`width:${w}%`}></i><span class="chip"><span class="c1">Approve</span><span class="c2">Approved</span></span></div>)}
                      </div>
                    </div>
                  )}
                  {s.id === 'focus' && (
                    <div class="fc" aria-hidden="true">
                      <p class="lbl">Daily focus <span>assigned by the dashboard’s AI</span></p>
                      {[62, 48, 70].map((w, k) => <div class="person" style={`--d:${0.4 + k * 0.5}s`}><i class="av"></i><i class="nm"></i><span class="focus"><b>Focus</b><i style={`width:${w}%`}></i></span></div>)}
                    </div>
                  )}
                  {s.id === 'today' && (
                    <div class="td" aria-hidden="true">
                      <div class="phone"><i class="notch"></i>
                        <p class="h">Today</p>
                        <div class="fcard"><b>Your focus</b><i></i><i style="width:60%"></i></div>
                        {[80, 65, 72].map((w) => <div class="row"><i class="box"></i><i class="bar" style={`width:${w}%`}></i></div>)}
                      </div>
                      <ul class="where"><li>Browser</li><li class="on">Phone</li><li>Shop-floor kiosk</li></ul>
                    </div>
                  )}
                  {s.id === 'work' && (
                    <div class="wk" aria-hidden="true">
                      <div class="clock"><span class="c-in">Clock in</span><span class="c-on"><i></i>Clocked in</span></div>
                      <div class="wk-main">
                        <div class="list">
                          {[76, 58, 84].map((w, k) => <div class="row" style={`--d:${1.2 + k * 0.9}s`}><i class="box"></i><i class="bar" style={`width:${w}%`}></i><span class="pill">done</span></div>)}
                        </div>
                        <div class="air"><b>Airtable</b><span>Saved</span></div>
                      </div>
                    </div>
                  )}
                  {s.id === 'otis' && (
                    <div class="ot" aria-hidden="true">
                      <div class="msg me"><i></i><i style="width:60%"></i></div>
                      <div class="msg otis"><p class="who">Ask Otis</p>
                        <div class="sg"><b>Suggested milestone</b><i></i></div>
                        <div class="sg"><b>Possible duplicate</b><i style="width:70%"></i></div>
                      </div>
                      <div class="acts"><span class="ok">Approve</span><span>Edit</span><span>Reject</span><em class="saved">Approved · saved</em></div>
                    </div>
                  )}
                </div>
              </>
            )}
          </div>
        </li>
      );
    })}
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-day]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.dy-tab')];
    const steps = [...root.querySelectorAll<HTMLElement>('.dy-step')];
    const nav = root.querySelector<HTMLElement>('.dy-nav')!;
    const btn = root.querySelector<HTMLButtonElement>('.dy-pause')!;
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, userPaused = false, hover = false, seen = false;
    root.classList.add('is-live');
    if (still) root.classList.add('is-static');
    nav.hidden = false;
    btn.hidden = still;
    steps.forEach((s) => s.setAttribute('role', 'tabpanel'));
    const sync = () => { root.classList.toggle('is-paused', still || userPaused || hover || !seen); root.classList.toggle('is-away', !seen); };
    const show = (i: number, focus = false) => {
      cur = (i + steps.length) % steps.length;
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === cur)); t.tabIndex = k === cur ? 0 : -1; });
      steps.forEach((s, k) => { s.hidden = k !== cur; s.classList.toggle('is-active', k === cur); });
      if (focus) tabs[cur].focus();
    };
    const pause = (p: boolean) => { userPaused = p; btn.textContent = p ? 'Play' : 'Pause'; btn.setAttribute('aria-pressed', String(p)); sync(); };
    tabs.forEach((t, k) => {
      t.addEventListener('click', () => { show(k); pause(true); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); show(cur + d, true); pause(true); }
      });
    });
    btn.addEventListener('click', () => pause(!userPaused));
    // the progress bar's CSS animation drives auto-advance
    root.addEventListener('animationend', (e) => { if (!still && (e.target as Element).classList.contains('dy-fill')) show(cur + 1); });
    const art = root.querySelector('.dy-steps')!;
    art.addEventListener('pointerenter', () => { hover = true; sync(); });
    art.addEventListener('pointerleave', () => { hover = false; sync(); });
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }, { threshold: 0.35 }).observe(root);
    show(0); sync();
  });
</script>

<style>
  .dy-nav{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-bottom:28px}
  .dy-nav[hidden]{display:none}
  .dy-tab{all:unset;cursor:pointer;display:grid;grid-template-columns:auto 1fr;gap:4px 10px;align-items:baseline;padding-top:14px;position:relative;color:var(--muted)}
  .dy-tab:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
  .dy-tab:hover,.dy-tab[aria-selected=true]{color:var(--ink)}
  .dy-bar{position:absolute;left:0;right:0;top:0;height:2px;background:var(--line);overflow:hidden}
  .dy-fill{position:absolute;inset:0;background:var(--accent);transform:scaleX(0);transform-origin:left}
  .dy-tab[aria-selected=true] .dy-fill{animation:dy-fill 7s linear forwards}
  .is-paused .dy-fill{animation-play-state:paused!important}
  /* hold the illustration at its first frame until it scrolls into view */
  .is-away .dy-step,.is-away .dy-step *{animation-play-state:paused!important}
  .is-static .dy-tab[aria-selected=true] .dy-fill{animation:none;transform:none}
  .dy-n{font-size:12px;letter-spacing:.24em;font-weight:500;color:var(--accent)}
  .dy-t{font-size:15px;line-height:1.35}
  .dy-pause{all:unset;cursor:pointer;float:right;margin:-12px 0 8px;font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:500;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:6px 14px}
  .dy-pause:hover{color:var(--ink);border-color:var(--ink)}
  .dy-pause:focus-visible{outline:2px solid var(--accent);outline-offset:3px}
  .dy-pause[hidden]{display:none}
  .dy-steps{list-style:none;clear:both}
  .dy-step{display:grid;grid-template-columns:minmax(220px,1fr) 2fr;gap:24px 64px;align-items:center;border-top:1px solid var(--line);padding:28px 0}
  .is-live .dy-step{border-top:0;padding:0}
  /* stack panels in one cell so the block keeps the tallest panel's height (no jumps) */
  .is-live .dy-steps{display:grid}
  .is-live .dy-step{grid-area:1/1;align-content:start}
  .is-live .dy-step[hidden]{display:grid;visibility:hidden}
  .is-live .dy-step.is-active{animation:dy-in .45s ease-out}
  .dy-num{font-size:12px;letter-spacing:.24em;font-weight:500;color:var(--accent)}
  .dy-copy h3{font-weight:300;font-size:clamp(26px,2.4vw,34px);letter-spacing:-.02em;line-height:1.12;margin:8px 0 12px}
  .dy-copy p:last-child{color:var(--muted);max-width:38ch}
  .dy-art{background:#EDE7DC;position:relative;padding:56px 40px 40px;border-radius:4px;min-height:340px;display:flex;align-items:center;justify-content:center}
  .dy-art .tag{position:absolute;top:16px;left:16px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;background:#fff;color:var(--muted);padding:6px 10px;border:1px dashed #B9B2A6}
  .dy-art.has-shot{padding:52px 16px 16px}
  .dy-art img{width:100%;height:auto;border-radius:6px;box-shadow:0 20px 40px -24px rgba(40,30,20,.4)}
  .dy-ui{width:100%;max-width:520px;background:#fff;border-radius:10px;box-shadow:0 24px 48px -24px rgba(40,30,20,.35);padding:20px;font-size:12px;color:var(--ink)}
  .dy-ui i{display:block}
  .lbl{font-size:10px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--muted);margin-bottom:10px}
  .bar{height:7px;border-radius:4px;background:#E7E0D5}
  .box{width:12px;height:12px;border:1.5px solid #CFC5B5;border-radius:3px;flex:none}

  /* 1 meeting → tasks */
  .mt{display:grid;grid-template-columns:1fr 28px 1.1fr;gap:12px;align-items:start}
  .mt .ln{display:flex;gap:8px;align-items:center;margin:9px 0}
  .mt .spk{width:14px;height:14px;border-radius:50%;background:#E7E0D5;flex:none}
  .mt .ln .bar{flex:none;max-width:calc(100% - 22px)}
  .mt-arrow{display:flex;align-items:center;justify-content:center;height:100%;color:var(--accent);font-size:18px}
  .mt .task{display:flex;gap:8px;align-items:center;border:1px solid #EFEAE2;border-radius:6px;padding:8px;margin-bottom:8px}
  .mt .task .bar{flex:1 1 auto;max-width:none}
  .chip{position:relative;flex:none;font-size:9.5px;font-weight:500;letter-spacing:.04em;width:64px;height:20px}
  .chip span{position:absolute;inset:0;display:grid;place-items:center;border-radius:999px}
  .chip .c1{border:1px solid #D9CFC0;color:var(--muted);opacity:0}
  .chip .c2{background:var(--ink);color:#fff}
  .is-live:not(.is-static) .is-active .mt .ln{animation:dy-up .4s ease-out var(--d) both}
  .is-live:not(.is-static) .is-active .mt .task{animation:dy-left .45s ease-out var(--d) both}
  .is-live:not(.is-static) .is-active .mt .chip .c1{opacity:1;animation:dy-out .3s ease-in var(--d2) both}
  .is-live:not(.is-static) .is-active .mt .chip .c2{animation:dy-pop .35s ease-out var(--d2) both}

  /* 2 focus */
  .fc .lbl span{text-transform:none;letter-spacing:.02em;font-weight:400;margin-left:8px;color:#9C9488}
  .person{display:grid;grid-template-columns:28px 70px 1fr;gap:12px;align-items:center;padding:10px 0;border-top:1px solid #F1ECE4}
  .av{width:28px;height:28px;border-radius:50%;background:#E7E0D5}
  .person:nth-child(3) .av{background:#D9CFC0}
  .nm{height:8px;border-radius:4px;background:#2A2724;width:100%}
  .focus{display:flex;align-items:center;gap:8px;border:1px solid #EFEAE2;border-left:3px solid var(--accent);border-radius:4px;padding:7px 10px}
  .focus b{font-weight:500;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent)}
  .focus i{height:7px;border-radius:4px;background:#E7E0D5}
  .is-live:not(.is-static) .is-active .focus{animation:dy-left .5s cubic-bezier(.2,.7,.3,1) var(--d) both}

  /* 3 today */
  .u-today{background:transparent;box-shadow:none;padding:0;display:flex;justify-content:center}
  .td{display:flex;gap:28px;align-items:center}
  .phone{width:190px;background:#fff;border-radius:22px;padding:14px 14px 18px;box-shadow:0 24px 48px -24px rgba(40,30,20,.45);border:1px solid #E2DDD4}
  .notch{width:46px;height:5px;border-radius:3px;background:#E7E0D5;margin:0 auto 12px}
  .phone .h{font-size:20px;font-weight:300;letter-spacing:-.01em;margin-bottom:10px}
  .fcard{border-left:3px solid var(--accent);background:#FBF9F6;border-radius:4px;padding:10px;margin-bottom:12px}
  .fcard b{display:block;font-weight:500;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);margin-bottom:8px}
  .fcard i{height:7px;border-radius:4px;background:#2A2724;margin-top:6px}
  .phone .row{display:flex;gap:8px;align-items:center;padding:7px 0;border-top:1px solid #F1ECE4}
  .where{list-style:none;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);display:grid;gap:10px}
  .where li{border-left:1px solid #CFC5B5;padding-left:10px}
  .where li.on{color:var(--ink);border-color:var(--accent)}
  .is-live:not(.is-static) .is-active .phone{animation:dy-up .6s cubic-bezier(.2,.7,.3,1) both}
  .is-live:not(.is-static) .is-active .fcard{animation:dy-ring 1.4s ease-out .7s}

  /* 4 work */
  .clock{position:relative;height:30px;width:130px;margin-bottom:14px;font-weight:500;font-size:11px;letter-spacing:.1em;text-transform:uppercase}
  .clock span{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:8px;border-radius:999px}
  .c-in{border:1px solid var(--ink);opacity:0}
  .c-on{background:var(--ink);color:#fff}
  .c-on i{width:7px;height:7px;border-radius:50%;background:#E7A0A0}
  .wk-main{display:grid;grid-template-columns:1fr 104px;gap:18px;align-items:center}
  .wk .row{position:relative;display:flex;gap:10px;align-items:center;border:1px solid #EFEAE2;border-radius:6px;padding:10px;margin-bottom:8px}
  .wk .row .bar{flex:none;max-width:calc(100% - 30px);opacity:.45}
  .wk .row .box{background:var(--ink);border-color:var(--ink);position:relative}
  .wk .row .box::after{content:"";position:absolute;left:3px;top:0;width:3px;height:6px;border:solid #fff;border-width:0 1.5px 1.5px 0;transform:rotate(45deg)}
  .wk .pill{position:absolute;right:-6px;top:50%;margin-top:-9px;height:18px;padding:0 9px;border-radius:9px;background:var(--ink);color:#fff;font-size:9.5px;font-weight:500;display:grid;place-items:center;opacity:0}
  .air{background:var(--ink);color:#F4F0E8;border-radius:8px;padding:14px 10px;text-align:center}
  .air b{display:block;font-weight:500;font-size:13px}
  .air span{font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:#B9B2A6}
  .is-live:not(.is-static) .is-active .c-in{animation:dy-flash 1s ease-out .2s both}
  .is-live:not(.is-static) .is-active .c-on{animation:dy-pop .3s ease-out 1s both}
  .is-live:not(.is-static) .is-active .wk .row .box{animation:dy-check .3s ease-out var(--d) both}
  .is-live:not(.is-static) .is-active .wk .row .bar{animation:dy-dim .3s ease-out var(--d) both}
  .is-live:not(.is-static) .is-active .wk .pill{animation:dy-send 1.1s ease-in-out var(--d) both}
  .is-live:not(.is-static) .is-active .air{animation:dy-ring 1.2s ease-out 2.2s,dy-ring 1.2s ease-out 3.1s,dy-ring 1.2s ease-out 4s}

  /* 5 otis */
  .msg{border-radius:10px;padding:10px 12px;margin-bottom:10px;max-width:82%}
  .msg.me{background:#2A2724;margin-left:auto;width:52%}
  .msg.me i{height:6px;border-radius:3px;background:#6B665E;margin:4px 0}
  .msg.otis{background:#F5F1EA}
  .who{font-size:10px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--accent);margin-bottom:6px}
  .sg{background:#fff;border:1px solid #EFEAE2;border-radius:6px;padding:8px 10px;margin-top:6px}
  .sg b{display:block;font-weight:500;font-size:11.5px;margin-bottom:6px}
  .sg i{height:6px;border-radius:3px;background:#E7E0D5}
  .acts{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  .acts span{font-size:10px;padding:4px 10px;border-radius:999px;border:1px solid #D9CFC0;color:var(--muted)}
  .acts .ok{background:var(--ink);color:#fff;border-color:var(--ink)}
  .saved{font-style:normal;font-size:10px;letter-spacing:.12em;text-transform:uppercase;font-weight:500;color:var(--accent);margin-left:auto}
  .is-live:not(.is-static) .is-active .msg.me{animation:dy-up .4s ease-out .1s both}
  .is-live:not(.is-static) .is-active .msg.otis{animation:dy-up .45s ease-out .7s both}
  .is-live:not(.is-static) .is-active .sg:nth-child(3){animation:dy-up .4s ease-out 1.3s both}
  .is-live:not(.is-static) .is-active .acts .ok{animation:dy-press .5s ease-out 2.6s both}
  .is-live:not(.is-static) .is-active .saved{animation:dy-pop .4s ease-out 3.1s both}

  @keyframes dy-fill{to{transform:scaleX(1)}}
  @keyframes dy-in{from{opacity:0;transform:translateY(8px)}}
  @keyframes dy-up{from{opacity:0;transform:translateY(10px)}}
  @keyframes dy-left{from{opacity:0;transform:translateX(-14px)}}
  @keyframes dy-pop{from{opacity:0;transform:scale(.85)}}
  @keyframes dy-out{to{opacity:0}}
  @keyframes dy-flash{0%,60%{opacity:1}100%{opacity:0}}
  @keyframes dy-check{from{background:#fff;border-color:#CFC5B5}}
  @keyframes dy-dim{from{opacity:1}}
  @keyframes dy-ring{0%{box-shadow:0 0 0 0 rgba(136,25,25,.35)}100%{box-shadow:0 0 0 10px rgba(136,25,25,0)}}
  @keyframes dy-send{0%{opacity:0;transform:translateX(0)}15%{opacity:1}85%{opacity:1;transform:translateX(80px)}100%{opacity:0;transform:translateX(84px)}}
  @keyframes dy-press{0%{background:#fff;color:var(--muted);border-color:#D9CFC0}60%{transform:scale(.92)}100%{transform:none}}

  @media (max-width:900px){
    .dy-step{grid-template-columns:1fr;gap:18px}
    .dy-nav{gap:8px;grid-template-columns:repeat(5,1fr)}
    .dy-t{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    .dy-pause{float:none;display:inline-block;margin:0 0 24px}
  }
  @media (max-width:560px){
    .dy-art{padding:60px 12px 16px;min-height:0}
    .dy-ui{padding:14px}
    .mt{grid-template-columns:1fr;gap:4px}
    .mt-arrow{transform:rotate(90deg);height:auto}
    .person{grid-template-columns:24px 44px 1fr;gap:10px}
    .av{width:24px;height:24px}
    .td{gap:16px}
    .phone{width:170px}
    .where{font-size:10px}
    .wk-main{grid-template-columns:1fr 84px;gap:12px}
    @keyframes dy-send{0%{opacity:0;transform:translateX(0)}15%{opacity:1}85%{opacity:1;transform:translateX(62px)}100%{opacity:0;transform:translateX(66px)}}
  }
</style>
