---
/* Privacy-friendly, click-to-load embeds. Nothing third-party loads until the
   visitor presses play / load (YouTube uses youtube-nocookie.com, Vimeo dnt=1). */
interface Props { b: any; }
const { b } = Astro.props;
const VIMEO_THUMBS: Record<string, string> = {
  '325314612': 'https://i.vimeocdn.com/video/769005069-6ea358e59ff35d766c013a4b06d6f46c3baa4aec088d59ee84bfc26faa38b6f4-d_640?region=us',
  '323306832': 'https://i.vimeocdn.com/video/766717031-2d743a12f304c881441a914213036bce8e192001ceefa7276f3359cfe2cb1c6f-d_640?region=us',
};
// Facebook gives no public thumbnail, so each video's poster is saved locally (public/media/video-thumbs/fb-<id>.webp).
const FB_THUMBS = new Set(['2294804577202088', '2148828268466387', '2125823920766822', '2139810302701517']);
const kind: string = b.kind;
let src = b.embed as string;
let thumb: string | null = null;
let title: string = b.title || '';
let label = 'Play video';
let provider = '';
let allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
let tall = false;
if (kind === 'youtube') {
  const id = (b.watch.match(/v=([\w-]{11})/) || b.embed.match(/embed\/([\w-]{11})/))[1];
  src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
  thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
  provider = 'YouTube';
} else if (kind === 'vimeo') {
  const id = b.embed.match(/video\/(\d+)/)[1];
  src = b.embed + (b.embed.includes('?') ? '&' : '?') + 'dnt=1&autoplay=1';
  thumb = VIMEO_THUMBS[id] ?? null;
  provider = 'Vimeo';
} else if (kind === 'facebook') {
  src = b.embed + '&autoplay=true';
  title = title || 'The Cultivation Project video on Facebook';
  provider = 'Facebook';
  const fbId = decodeURIComponent(b.embed).match(/videos\/(\d+)/)?.[1];
  if (fbId && FB_THUMBS.has(fbId)) thumb = `/media/video-thumbs/fb-${fbId}.webp`;
} else if (kind === 'spotify') {
  src = b.embed;
  title = title || 'Podcast on Spotify';
  label = 'Load Spotify player';
  provider = 'Spotify';
  allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
} else if (kind === 'figma') {
  title = title || 'Interactive Figma prototype';
  label = 'Load interactive prototype';
  provider = 'Figma';
  tall = true;
} else if (kind === 'adobe-xd') {
  title = title || 'Interactive Adobe XD prototype';
  label = 'Load interactive prototype';
  provider = 'Adobe XD';
} else if (kind === 'apple-podcasts') {
  title = title || 'Coffee Meets Bible on Apple Podcasts';
  label = 'Load podcast player';
  provider = 'Apple Podcasts';
  allow = 'autoplay *; encrypted-media *; clipboard-write';
}
const ratio = tall && b.ratio ? `100 / ${b.ratio}` : kind === 'apple-podcasts' ? '16 / 9' : '16 / 9';
const narrow = tall;
const mw = narrow ? `${Math.min(b.maxWidth || 440, 440)}px` : undefined;
const isVideo = ['youtube', 'vimeo', 'facebook'].includes(kind);
const watchText = kind === 'facebook' ? 'Watch on Facebook' : isVideo ? `Watch on ${provider}` : `Open in ${provider}`;
---
<figure class:list={['embed', { narrow }]} style={mw ? `--mw:${mw}` : undefined}>
  <div class:list={['frame', { tall, spotify: kind === 'spotify' }]} style={tall ? `--ratio:${ratio}` : undefined}>
    <button type="button" class:list={['facade', { plain: !thumb }]} data-embed={src} data-title={title} data-allow={allow}
      aria-label={`${label}: ${title}`}>
      {thumb && <img src={thumb} alt="" loading="lazy" decoding="async" width="480" height="360" />}
      <span class="play" aria-hidden="true"></span>
      {!thumb && <small>{provider}</small>}
      <span class="ft">{title}</span>
    </button>
  </div>
  <figcaption class="meta">
    <span>{b.caption && b.caption !== b.title ? b.caption : isVideo ? provider : `${provider} · loads on click`}</span>
    <a href={b.watch} target="_blank" rel="noopener">{watchText} ↗</a>
  </figcaption>
</figure>
