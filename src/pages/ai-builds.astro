---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import { shot } from '../data/internal-dashboard';
const minis = [
  { title: 'Ask Otis', body: 'A Claude-powered assistant in the Internal Dashboard. It creates and updates tasks, suggests milestones and catches duplicates. Nothing saves until a person approves.', tag: 'Claude · human-in-the-loop' },
  { title: 'Meeting-to-task pipeline', body: 'Turns meeting transcripts into approved tasks, which the dashboard’s AI then assigns as each person’s daily focus. Saves about 5 hours a week.', tag: 'Claude Code · Grok Bot' },
  { title: '~20 AI agents, mapped to the org chart', body: 'An agentic operating model that defines which work belongs to AI, people or both, with about 20 AI agents mapped to org-chart roles across all six departments.', tag: 'Operating model' },
  { title: 'Four connected Airtable bases', body: 'The data layer behind the Foundation, including a 30-table operations backbone and a 32-table manufacturing ERP.', tag: 'Airtable · schema design' },
];
// "How I build": the four parts of the lede below, in its own words.
const steps = [
  { sub: 'Decide', title: 'The problem', text: 'I decide what gets built and how it works.' },
  { sub: 'Design', title: 'Workflow, data, approvals', text: 'The workflow, the data and the approvals.' },
  { sub: 'Direct', title: 'AI agents build it', text: 'Far faster than I could alone.' },
  { sub: 'Review', title: 'Every change', text: 'I review every change.' },
];
---
<Base title="AI & technical builds" section="ai"
  description="AI and technical builds by Cameron Kuey: the Internal Dashboard, Ask Otis, a meeting-to-task pipeline, ~20 AI agents mapped to org roles, and four connected Airtable bases.">
  <header class="pg"><div class="cs-stripe" aria-hidden="true"></div><div class="wrap pg-grid">
    <div>
      <p class="ey">AI &amp; Technical Builds</p>
      <h1>I design the tools. <em>AI helps me build them fast.</em></h1>
      <p class="intro">I decide what gets built and how it works: the problem, the workflow, the data and the approvals. Then I direct AI agents to build it far faster than I could alone, and I review every change.</p>
    </div>
    <dl class="spec-t">
      <div><dt>Agents</dt><dd>Cursor cloud agents</dd></div>
      <div><dt>Assistant</dt><dd>Claude (Ask Otis)</dd></div>
      <div><dt>Data</dt><dd>Airtable</dd></div>
      <div><dt>Hosting</dt><dd>Cloudflare Workers</dd></div>
      <div><dt>Review</dt><dd>152 pull requests, 1,218 tests</dd></div>
    </dl>
  </div></header>

  <section class="sec" aria-labelledby="how-h"><div class="wrap">
    <div class="sec-top"><h2 class="ey" id="how-h"><b>01</b> / How I build</h2></div>
    <ol class="proc">
      {steps.map((s, i) => (
        <li>
          <span class={`badge${i === steps.length - 1 ? ' on' : ''}`} aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <span class="sub">{s.sub}</span>
          <b>{s.title}</b>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div></section>

  <section class="feat" aria-labelledby="case-h"><div class="wrap">
    <div class="feat-grid">
      <figure class="feat-shot">
        <Pic id={shot.myWork.id} sizes="(max-width: 900px) 100vw, 600px" alt={shot.myWork.alt} />
      </figure>
      <div>
        <p class="ey"><b>02</b> / Featured case study · Doodle Pirates Foundation</p>
        <h3 id="case-h">An all-in-one Internal Dashboard, <em>concept to production in under two weeks.</em></h3>
        <p class="desc">Designed by me and built fast with Cursor cloud agents on an Airtable ERP, including Ask Otis, a Claude-powered assistant with human-in-the-loop approval.</p>
        <div class="nums">
          <div><b>&lt;2 wks</b><span>Concept to production</span></div>
          <div><b>152</b><span>Reviewed pull requests</span></div>
          <div><b>1,218</b><span>Automated tests</span></div>
          <div><b>~20</b><span>AI agents</span></div>
        </div>
        <div class="btns"><a class="btn solid" href="/case-studies/internal-dashboard">Read the case study →</a></div>
      </div>
    </div>
  </div></section>

  <section class="sec" aria-labelledby="more-h"><div class="wrap">
    <div class="sec-top"><div><p class="ey"><b>03</b> / Doodle Pirates Foundation</p><h2 id="more-h">More builds</h2></div></div>
    <ul class="rows">
      {minis.map((m, i) => (
        <li><div class="row">
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{m.title}</h3>
          <p>{m.body}</p>
          <span class="tag">{m.tag}</span>
        </div></li>
      ))}
    </ul>
    <div class="btns" style="margin-top:40px"><a class="btn" href="/operations">Operations experience →</a><a class="btn" href="/resume.pdf">Résumé (PDF)</a></div>
  </div></section>
</Base>
