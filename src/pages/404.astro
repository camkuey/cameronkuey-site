---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn’t exist." noindex>
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">404</p>
      <h1>That page <em>isn’t here.</em></h1>
      <p class="lede">It may have moved when the site was rebuilt. Try one of these:</p>
      <div class="btns"><a class="btn solid" href="/">Home</a><a class="btn" href="/creative">Creative work</a><a class="btn" href="/experience">Experience</a><a class="btn" href="/projects">Projects</a></div>
    </header>
  </div>
</Base>
