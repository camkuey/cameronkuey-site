---
import Base from '../layouts/Base.astro';
import CreativeNav from '../components/CreativeNav.astro';
import Pic from '../components/Pic.astro';
import { CATEGORIES, IMAGES, page, fullSrc } from '../lib/site';
import '../styles/cinema.css';

// ---- Mosaic ----------------------------------------------------------------------------------
// Every photo opens in the lightbox, with a link out to its category page.
const KIND: Record<string, { href: string; k: string; s: string; more: string }> = {
  wed:  { href: '/wedding-photography',    k: 'Wedding',          s: 'Cosie Co.',          more: 'More weddings →' },
  eng:  { href: '/engagement-proposals',   k: 'Engagement',       s: 'Cosie Co.',          more: 'More engagements →' },
  fam:  { href: '/family-photoshoots',     k: 'Family',           s: 'Cosie Co.',          more: 'More family shoots →' },
  grad: { href: '/graduation-photoshoots', k: 'Graduation',       s: 'Cosie Co.',          more: 'More graduations →' },
  vid:  { href: '/video-production',       k: 'Video production', s: '',                   more: 'More video work →' },
  aud:  { href: '/coffee-meets-bible-podcast', k: 'Audio',       s: 'Coffee Meets Bible', more: 'Listen to the podcast →' },
};
const FULL: Record<string, string> = { wed: 'wedding-photography', eng: 'engagement-proposals', fam: 'family-photoshoots', grad: 'graduation-photoshoots' };
const find = (prefix: string, n: number) => {
  const k = Object.keys(IMAGES).find((x) => x.startsWith(`${prefix}/${String(n).padStart(2, '0')}-`));
  if (!k) throw new Error(`creative: no image ${prefix} #${n}`);
  return k;
};
// "w2" = existing wedding photo #2, "W1" = new Cosie Co. wedding #1 (cosie-wed-01), "v2" = video cover #2, "a" = podcast cover.
const CODE: Record<string, string> = { w: 'wed', e: 'eng', f: 'fam', g: 'grad', v: 'vid' };
const resolve = (t: string) => {
  if (t === 'a') return { kind: 'aud', id: 'audio-production/coffee-meets-bible-logo' };
  const m = t.match(/^([a-zA-Z])(\d+)$/)!;
  const kind = CODE[m[1].toLowerCase()], n = +m[2];
  if (kind === 'vid') return { kind, id: find('video-production', n) };
  if (m[1] === m[1].toUpperCase()) return { kind, id: `cosie-${kind}-${String(n).padStart(2, '0')}` };
  return { kind, id: find(FULL[kind], n) };
};
const MOSAIC_SRC = [
  'w2', 'E6', 'g10', 'f2', 'W3', 'e9', 'f5', 'G3', 'w39', 'e20', 'v1',
  'g9', 'F6', 'w12', 'E12', 'g19', 'a', 'W8', 'e3', 'E9', 'f24', 'g18',
  'w35', 'F7', 'v2', 'e25', 'w22', 'G5', 'f11', 'E10', 'w40', 'g20', 'F4',
  'v4', 'g1', 'e28', 'w36', 'E5', 'e15',
];
const mosaic = MOSAIC_SRC.map((t) => {
  const r = resolve(t);
  const i = IMAGES[r.id];
  return { kind: r.kind, id: r.id, w: i.w, h: i.h, ar: +(i.w / i.h).toFixed(4), color: i.color, ...KIND[r.kind] };
});

// ---- Showreel: creative-only cut of the home reel (scripted with ffmpeg; cue times match the cut) ----
const reelCues: [number, string][] = [[0, 'Photography'], [1.67, 'Wedding film'], [5.56, 'Commercial'], [6.86, 'Engagements'], [8.33, 'Wedding film'], [10.86, 'Documentary'], [12.22, 'Wedding film'], [13.49, 'Commercial'], [14.7, 'Graduations'], [16.16, 'Documentary'], [17.63, 'Wedding film'], [18.79, 'Photography']];

// ---- Category panels: one cover each, shoot types listed underneath ----
const panels = CATEGORIES.map((c) => {
  const img = page(c.slug).covers.find((x: any) => x.image)?.image ?? null;
  return { title: c.title, href: c.href, id: img?.id as string | undefined, children: c.children };
});

// ---- Kind words: short excerpts from Cosie Co. reviews on WeddingWire ----
const WW = 'https://www.weddingwire.com/reviews/cameron-kuey-productions-san-diego/9b01103d6f1bea3d.html';
const quotes = [
  { q: 'They even went the extra mile (literally) by hiking up a steep trail for us, just so we could get a couple of good photos at this one spot.', who: 'Timothy', what: 'Engagement, Yosemite' },
  { q: 'He helped make my husband and I (and bridal party) feel comfortable throughout our entire wedding day, which shows in our final photos.', who: 'Emily', what: 'Wedding photography' },
  { q: 'Cameron’s undergraduate studies in film clearly manifest in his crisp editing.', who: 'Daniel', what: 'Wedding film' },
];
---
<Base title="Creative work" section="creative"
  description="Creative work by Cameron Kuey: wedding, engagement, family and graduation photography; video production; and the Coffee Meets Bible podcast.">
<div class="cine">
  <header class="cv-hero" aria-labelledby="cv-h">
    <Pic id="photography/02-3f39fcda" class="cv-bg" sizes="100vw" eager
      alt="A couple laughing on a granite outcrop above Yosemite Valley as he lifts her off the ground, with pines and snowy peaks behind them" />
    <div class="cv-scrim" aria-hidden="true"></div>
    <div class="wrap cv-copy">
      <p class="ey">Creative · Since 2012</p>
      <h1 id="cv-h">Photography, film<br />&amp; audio.</h1>
      <p class="cv-intro">Weddings, engagements, families and films, made through Cosie Co. and The Cultivation Project.</p>
      <div class="btns"><a class="btn solid" href="#reel">Watch the reel ↓</a><a class="btn cv-ghost" href="#types">Browse by type</a></div>
    </div>
  </header>

  <dl class="cv-stats wrap">
    <div><dt>200+</dt><dd>Clients served</dd></div>
    <div><dt>100+</dt><dd>Films and podcast episodes</dd></div>
    <div><dt>5.0</dt><dd><a href={WW} target="_blank" rel="noopener">19 reviews on WeddingWire ↗</a></dd></div>
    <div><dt>2012</dt><dd>Behind the camera since</dd></div>
  </dl>

  <CreativeNav current="creative" />

  <section id="reel" class="cv-sec" aria-labelledby="reel-h"><div class="wrap">
    <div class="sec-top"><div><p class="ey"><b>01</b> / Showreel</p><h2 id="reel-h">Ten years, <em>twenty seconds.</em></h2></div></div>
    <div class="cv-reel" data-cues={JSON.stringify(reelCues)}>
      <video muted loop playsinline preload="none" poster="/media/creative-reel/poster.webp" aria-label="Silent showreel: wedding films, engagement and graduation photos, commercials and documentary interviews" disablepictureinpicture></video>
      <span class="cv-chip" aria-hidden="true">{reelCues[0][1]}</span>
      <button type="button" class="cv-pp" aria-pressed="false">Pause</button>
    </div>
  </div></section>

  <section class="cv-sec" aria-labelledby="pics-h" style="padding-top:0"><div class="wrap">
    <div class="sec-top"><div><p class="ey"><b>02</b> / Photography</p><h2 id="pics-h">Selected frames</h2></div><p class="cv-hint">Click any photo to view it full size</p></div>
    <div class="cl-mosaic" data-gallery>
      {mosaic.map((t, n) => (
        <a class="cl-ph" href={fullSrc(t.id)} data-lb data-w={t.w} data-h={t.h} data-cap={t.s ? `${t.k} · ${t.s}` : t.k}
          data-more={t.href} data-more-text={t.more} style={`--ar:${t.ar};--c:${t.color}`}>
          <span class="cl-img"><Pic id={t.id} sizes="(max-width: 700px) 50vw, 340px" eager={n < 4} /></span>
          <span class="cap-row"><span class="k">{t.k}</span>{t.s && <span class="s">{t.s}</span>}</span>
        </a>
      ))}
    </div>
  </div></section>

  <section class="cv-film" aria-labelledby="film-h">
    <div class="wrap">
      <p class="ey"><b>03</b> / Featured film</p>
      <div class="cv-film-frame">
        <button type="button" class="cv-film-play" data-embed="https://www.youtube-nocookie.com/embed/YqMJTaWYBIw?autoplay=1&rel=0"
          data-title="Silent Night, a short film for Alabaster Co." data-allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          aria-label="Play Silent Night, a short film for Alabaster Co.">
          <Pic id="home-film-silent-night" sizes="(max-width: 1240px) 100vw, 1200px" alt="" />
          <span class="cv-film-copy">
            <span class="cv-play" aria-hidden="true"></span>
            <span><b id="film-h">Silent Night</b><small>A short film for Alabaster Co. · Plays from YouTube</small></span>
          </span>
        </button>
      </div>
    </div>
  </section>

  <section class="cv-sec" aria-labelledby="words-h"><div class="wrap">
    <div class="sec-top"><div><p class="ey"><b>04</b> / Kind words</p><h2 id="words-h">From the couples <em>and families.</em></h2></div><a class="more" href={WW} target="_blank" rel="noopener">All 19 reviews ↗</a></div>
    <ul class="cv-quotes">
      {quotes.map((x) => <li><blockquote>“{x.q}”</blockquote><p><b>{x.who}</b> · {x.what}</p></li>)}
    </ul>
  </div></section>

  <section id="types" class="cv-sec" aria-labelledby="types-h" style="padding-top:0"><div class="wrap">
    <div class="sec-top"><div><p class="ey"><b>05</b> / By type</p><h2 id="types-h">Browse the work</h2></div><a class="more" href="/home">About me →</a></div>
    <ul class="cv-panels">
      {panels.map((p) => (
        <li>
          <a class="cv-panel" href={p.href}>
            {p.id && IMAGES[p.id] && <Pic id={p.id} sizes="(max-width: 900px) 100vw, 400px" />}
            <span class="cv-panel-t">{p.title} <span aria-hidden="true">→</span></span>
          </a>
          <ul class="cv-sub">{p.children.map((ch) => <li><a href={`/${ch.slug}`}>{ch.title}</a></li>)}</ul>
        </li>
      ))}
    </ul>
  </div></section>
</div>
</Base>

<style is:global>
/* /creative only: stats, showreel, featured film, quotes. Shared cinema-mode rules live in styles/cinema.css. */
/* stats strip */
.cv-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:24px;padding-top:28px;padding-bottom:36px}
.cv-stats div{border-top:1px solid var(--line-2);padding-top:14px}
.cv-stats div:first-child{border-top:2px solid var(--accent)}
.cv-stats dt{font-weight:300;font-size:clamp(28px,2.8vw,40px);line-height:1;letter-spacing:-.02em}
.cv-stats dd{margin-top:8px;font-family:var(--mono);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);line-height:1.5}
.cv-stats dd a{color:var(--muted);text-decoration:none;border-bottom:1px solid var(--line-2)}
.cv-stats dd a:hover{color:var(--ink)}

.cv-sec{padding:88px 0}
.cv-hint{font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}

/* showreel */
.cv-reel{position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:6px;background:#0c0b0a url(/media/creative-reel/poster.webp) center/cover}
.cv-reel video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.cv-chip{position:absolute;top:16px;left:16px;padding:6px 11px 5px;font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:#FAF8F4;border:1px solid rgba(250,248,244,.55);border-radius:2px;background:rgba(20,18,16,.45)}
.cv-pp{position:absolute;right:14px;bottom:14px;padding:8px 14px;background:rgba(20,18,16,.5);border:1px solid rgba(250,248,244,.5);border-radius:999px;color:#FAF8F4;font:500 11px/1 var(--fb);letter-spacing:.16em;text-transform:uppercase;cursor:pointer}
.cv-pp:hover{background:rgba(20,18,16,.75)}

/* mosaic on dark */
.cine .cl-ph{border-radius:2px}

/* featured film: letterboxed panel, plays in place */
.cv-film{padding:24px 0 96px}
.cv-film-frame{position:relative;aspect-ratio:2.39/1;overflow:hidden;border-radius:6px;background:#000}
.cv-film-frame:has(iframe){aspect-ratio:16/9}
.cv-film-frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.cv-film-play{position:absolute;inset:0;width:100%;height:100%;padding:0;border:0;background:none;cursor:pointer;color:#FAF8F4;text-align:left;font:inherit}
.cv-film-play picture,.cv-film-play img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
.cv-film-play:hover img{transform:scale(1.03)}
.cv-film-play::after{content:"";position:absolute;inset:0;background:linear-gradient(to top,rgba(10,9,8,.8),rgba(10,9,8,.1) 60%)}
.cv-film-copy{position:absolute;z-index:1;left:clamp(20px,4vw,48px);bottom:clamp(20px,4vw,44px);display:flex;align-items:center;gap:22px}
.cv-film-copy b{display:block;font-weight:300;font-size:clamp(30px,4vw,56px);line-height:1;letter-spacing:-.03em}
.cv-film-copy small{display:block;margin-top:8px;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(250,248,244,.8)}
.cv-play{flex:none;width:72px;height:72px;border-radius:50%;border:1.5px solid rgba(250,248,244,.9);display:grid;place-items:center;transition:background-color .25s,transform .25s}
.cv-play::before{content:"";margin-left:5px;border-left:18px solid #FAF8F4;border-top:11px solid transparent;border-bottom:11px solid transparent}
.cv-film-play:hover .cv-play{background:#A32121;border-color:#A32121;transform:scale(1.06)}
.cv-film-play:focus-visible{outline:2px solid var(--accent);outline-offset:4px}

/* kind words */
.cv-quotes{list-style:none;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px}
.cv-quotes li{border-top:1px solid var(--line-2);padding-top:22px}
.cv-quotes blockquote{font-weight:300;font-size:clamp(19px,1.6vw,23px);line-height:1.4;letter-spacing:-.01em}
.cv-quotes p{margin-top:16px;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.cv-quotes p b{color:var(--ink);font-weight:500}

@media (max-width:900px){
  .cv-stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 16px}
  .cv-sec{padding:64px 0}
  .cv-reel{aspect-ratio:4/5}
  .cv-quotes{grid-template-columns:1fr;gap:28px}
  .cv-film-frame{aspect-ratio:16/10}
  .cv-play{width:56px;height:56px}
  .cine .sec-top .cv-hint{display:none}
}
@media (prefers-reduced-motion:reduce){.cv-pp{display:none}}
</style>

<script>
  // Showreel: plays muted while on screen (phones get the vertical cut), chip follows the cue list, Pause/Play toggle.
  const reel = document.querySelector<HTMLElement>('.cv-reel');
  const vid = reel?.querySelector('video');
  if (reel && vid && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const chip = reel.querySelector<HTMLElement>('.cv-chip')!;
    const pp = reel.querySelector<HTMLButtonElement>('.cv-pp')!;
    const cues: [number, string][] = JSON.parse(reel.dataset.cues || '[]');
    let loaded = false, paused = false, visible = false, last = -1;
    const load = () => {
      if (loaded) return; loaded = true;
      const m = matchMedia('(max-width: 900px)').matches ? '-m' : '';
      if (m) vid.poster = '/media/creative-reel/poster-m.webp';
      [['webm', 'video/webm'], ['mp4', 'video/mp4']].forEach(([ext, type]) => {
        const s = document.createElement('source'); s.src = `/media/creative-reel/creative-reel${m}.${ext}`; s.type = type; vid.appendChild(s);
      });
      vid.load();
    };
    const sync = () => {
      if (paused || !visible || document.hidden) { vid.pause(); return; }
      load(); vid.play().catch(() => {});
    };
    vid.addEventListener('timeupdate', () => {
      let i = 0; while (i + 1 < cues.length && cues[i + 1][0] <= vid.currentTime) i++;
      if (i !== last) { last = i; chip.textContent = cues[i][1]; }
    });
    pp.addEventListener('click', () => {
      paused = !paused; pp.textContent = paused ? 'Play' : 'Pause'; pp.setAttribute('aria-pressed', String(paused)); sync();
    });
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.25 }).observe(reel);
  }
</script>
