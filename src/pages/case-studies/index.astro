---
import Base from '../../layouts/Base.astro';
import { CASES } from '../../data/case-list';
---
<Base title="Case studies" section="cases"
  description="Case studies by Cameron Kuey: major operations workflows and systems he designed and built, from Modern Health automations to the Doodle Pirates Foundation Internal Dashboard.">
  <header class="pg"><div class="cs-stripe" aria-hidden="true"></div><div class="wrap pg-grid">
    <div>
      <p class="ey">Case studies</p>
      <h1>The workflows and systems <em>I designed and built.</em></h1>
      <p class="intro">Each starts with a messy real-world problem and ends with a process that runs on its own.</p>
    </div>
    <dl class="spec-t">
      {CASES.map((c) => <div><dt>{c.kind}</dt><dd>{c.org}</dd></div>)}
    </dl>
  </div></header>
  <section class="sec"><div class="wrap">
    <ul class="rows">
      {CASES.map((c, i) => (
        <li><a class="row" href={`/case-studies/${c.slug}`}>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <div><p class="ey" style="margin-bottom:8px">{c.kind} · {c.org}</p><h3>{c.title}</h3></div>
          <p>{c.summary}</p>
          <span class="tag">{c.tags.join(' · ')}<span class="go">Read the case study →</span></span>
        </a></li>
      ))}
    </ul>
  </div></section>
</Base>
