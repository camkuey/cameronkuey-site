---
import Base from '../../layouts/Base.astro';
import { themeVars } from '../../data/themes';
import CaseFlow from '../../components/CaseFlow.astro';
import Pic from '../../components/Pic.astro';
import { fullSrc, IMAGES } from '../../lib/site';
import { meta, stats, problem, design, copies, flows, owner, clientSteps, friendly, screens, results, limits } from '../../data/growth-roadmap';
const shot = (id: string) => screens.find((s) => s.id === id)!;
const pair = [shot('growth-overview-light'), shot('growth-overview-dark')];
const gallery = screens.filter((s) => !pair.includes(s));
---
<Base title={meta.title} section="projects" description={meta.description}>
  <article class="cs-page" data-theme="roadmap" style={themeVars('roadmap')}>
    <div class="cs-heroband">
      <div class="cs-stripe" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <div class="wrap cs-herogrid">
        <header class="page-head wide">
          <ol class="crumbs eyebrow mono" aria-label="Breadcrumb"><li><a href="/projects">Projects</a></li><li>Strategy Growth Roadmap</li></ol>
          <h1>From sticky notes to <em>a roadmap in a Google Sheet.</em></h1>
          <p class="lede">A freelance build: the Strategy Growth Roadmap, a planning tool on Google Sheets and Apps Script. One master Sheet, and each new client makes a copy for their own private Sheet, with nothing to install.</p>
          <dl class="spec-t"><div><dt>Type</dt><dd>Freelance build</dd></div><div><dt>Client</dt><dd>Anonymous</dd></div><div><dt>Tools</dt><dd>Google Sheets, Apps Script</dd></div></dl>
        </header>
        <figure class="cs-herovis is-shot"><Pic id={pair[0].id} alt={pair[0].alt} eager sizes="(max-width: 900px) 100vw, 720px" /><figcaption>{pair[0].label}. Preview render with invented example data.</figcaption></figure>
      </div>
      <div class="wrap">
        <div class="cs-tiles hl">
          {stats.map((s, i) => <div class={`cs-tile t${i}`}><b>{s.title}</b><span>{s.text}</span></div>)}
        </div>
      </div>
    </div>

    <section class="cs-sec c-red"><div class="wrap">
      <div class="cs-split">
        <div class="cs-text">
          <span class="cs-no" aria-hidden="true">01</span>
          <h2>The problem</h2>
          {problem.map((p) => <p>{p}</p>)}
        </div>
        <figure class="cs-vis cs-platforms cs-notes">
          <span class="tag">Illustration · not a screenshot</span>
          <svg viewBox="0 0 480 300" role="img" aria-label="Illustration: a loose scatter of tilted sticky notes joined by a hand-drawn arrow.">
            <path class="gn-arrow" d="M70,236 C150,286 230,232 290,246 S400,262 438,214" fill="none" stroke="#A69B88" stroke-width="1.5" stroke-dasharray="5 6" stroke-linecap="round" />
            <path d="M427,210 L440,212 L432,223" fill="none" stroke="#A69B88" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            <circle class="gn-dot" r="4.5" fill="#881919"><animateMotion path="M70,236 C150,286 230,232 290,246 S400,262 438,214" dur="9s" repeatCount="indefinite" calcMode="linear" keyPoints="0;1;1" keyTimes="0;.7;1" /><animate attributeName="opacity" values="0;1;1;0;0" keyTimes="0;.05;.66;.7;1" dur="9s" repeatCount="indefinite" /></circle>
            <g class="gn-note" style="--r:-5deg;--d:0s"><rect x="28" y="44" width="104" height="96" rx="4" fill="#FFFFFF" stroke="#CFC7BA" stroke-width="1.2" /><path d="M46,72 H112 M46,90 H104 M46,108 H80" stroke="#D9D2C6" stroke-width="2.5" stroke-linecap="round" /><circle cx="118" cy="58" r="4" fill="#881919" /></g>
            <g class="gn-note" style="--r:4deg;--d:-1.4s"><rect x="170" y="30" width="104" height="96" rx="4" fill="#FFFFFF" stroke="#CFC7BA" stroke-width="1.2" /><path d="M188,58 H254 M188,76 H246 M188,94 H222" stroke="#D9D2C6" stroke-width="2.5" stroke-linecap="round" /></g>
            <g class="gn-note" style="--r:-3deg;--d:-2.8s"><rect x="318" y="50" width="104" height="96" rx="4" fill="#FFFFFF" stroke="#CFC7BA" stroke-width="1.2" /><path d="M336,78 H402 M336,96 H394 M336,114 H366" stroke="#D9D2C6" stroke-width="2.5" stroke-linecap="round" /></g>
            <g class="gn-note" style="--r:6deg;--d:-4.2s"><rect x="96" y="150" width="96" height="84" rx="4" fill="#FFFFFF" stroke="#CFC7BA" stroke-width="1.2" /><path d="M112,176 H174 M112,194 H162" stroke="#D9D2C6" stroke-width="2.5" stroke-linecap="round" /></g>
            <g class="gn-note" style="--r:-4deg;--d:-5.6s"><rect x="260" y="148" width="96" height="84" rx="4" fill="#FFFFFF" stroke="#CFC7BA" stroke-width="1.2" /><path d="M276,174 H338 M276,192 H322" stroke="#D9D2C6" stroke-width="2.5" stroke-linecap="round" /></g>
          </svg>
          <figcaption>Where the plan started.</figcaption>
        </figure>
      </div>
    </div></section>

    <section class="cs-sec c-blue tint"><div class="wrap">
      <div class="cs-grid">
        <div class="cs-label"><span class="cs-no" aria-hidden="true">02</span><h2>From sketch to tool</h2></div>
        <div class="cs-prose">
          <p>Designed like a planning sketch that edits itself: yearly numbers on top, swimlanes below, one shared year axis.</p>
          <ol class="numbered">{design.map((d) => <li><b>{d.title}</b><p>{d.text}</p></li>)}</ol>
        </div>
      </div>
      <div class="cs-gal two" data-gallery>
        {pair.map((s) => (
          <figure>
            <a class="cs-shotlink" href={fullSrc(s.id)} data-lb data-w={IMAGES[s.id].w} data-h={IMAGES[s.id].h} data-cap={s.label} aria-label={`View larger: ${s.label}`}>
              <Pic id={s.id} alt={s.alt} sizes="(max-width: 900px) 100vw, 560px" />
            </a>
            <figcaption><b>{s.label}</b>{s.note && <span>{s.note}</span>}</figcaption>
          </figure>
        ))}
      </div>
      <p class="cs-note">Preview render with invented example data, not a live Google deployment.</p>
    </div></section>

    <section class="cs-sec c-gold"><div class="wrap">
      <div class="cs-split rev">
        <div class="cs-text">
          <span class="cs-no" aria-hidden="true">03</span>
          <h2>{flows.sync.title}</h2>
          {flows.sync.body.map((p) => <p>{p}</p>)}
        </div>
        <figure class="cs-vis cs-flow"><CaseFlow flow="growth-sync" theme="roadmap" /></figure>
      </div>
    </div></section>

    <section class="cs-sec c-red tint"><div class="wrap">
      <div class="cs-split">
        <div class="cs-text">
          <span class="cs-no" aria-hidden="true">04</span>
          <h2>{copies.title}</h2>
          {copies.body.map((p) => <p>{p}</p>)}
        </div>
        <figure class="cs-vis cs-flow"><CaseFlow flow="growth-copies" theme="roadmap" /></figure>
      </div>
      <div class="cs-split rev cs-row2">
        <div class="cs-text">
          <p class="eyebrow">{flows.rollout.title}</p>
          {flows.rollout.body.map((p) => <p>{p}</p>)}
        </div>
        <figure class="cs-vis cs-flow"><CaseFlow flow="growth-rollout" theme="roadmap" /></figure>
      </div>
      <div class="cs-two">
        <div class="cs-card2 k-ink"><p class="eyebrow">Me, once</p><ol class="numbered">{owner.map((o) => <li><b>{o.title}</b><p>{o.text}</p></li>)}</ol></div>
        <div class="cs-card2 k-blue"><p class="eyebrow">Each client</p><ol class="numbered">{clientSteps.map((o) => <li><b>{o.title}</b><p>{o.text}</p></li>)}</ol></div>
      </div>
    </div></section>

    <section class="cs-sec c-blue"><div class="wrap">
      <div class="cs-grid">
        <div class="cs-label"><span class="cs-no" aria-hidden="true">05</span><h2>{friendly.title}</h2></div>
        <div class="cs-prose">
          {friendly.body.map((p) => <p>{p}</p>)}
          <ul class="chips" style="margin-top:18px!important">{friendly.chips.map(([t, c]) => <li class={`chip ch-${c}`}>{t}</li>)}</ul>
        </div>
      </div>
      <div class="cs-gal" data-gallery>
        {gallery.map((s) => (
          <figure>
            <a class="cs-shotlink" href={fullSrc(s.id)} data-lb data-w={IMAGES[s.id].w} data-h={IMAGES[s.id].h} data-cap={s.label} aria-label={`View larger: ${s.label}`}>
              <Pic id={s.id} alt={s.alt} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 380px" />
            </a>
            <figcaption><b>{s.label}</b>{s.note && <span>{s.note}</span>}</figcaption>
          </figure>
        ))}
      </div>
    </div></section>

    <section class="cs-sec is-key c-gold tint"><div class="wrap">
      <div class="cs-grid">
        <div class="cs-label"><span class="cs-no" aria-hidden="true">06</span><h2>What I can show</h2></div>
        <ol class="numbered">{results.map((r) => <li><b>{r.title}</b><p>{r.text}</p></li>)}</ol>
      </div>
      <p class="cs-note">No client outcomes or speed measurements claimed. These checks cover the build itself, including that the code has no Sheet IDs and asks only for the Sheets and menu permissions.</p>
    </div></section>

    <section class="cs-sec c-ink tint"><div class="wrap">
      <div class="cs-grid">
        <div class="cs-label"><span class="cs-no" aria-hidden="true">07</span><h2>Honest limits</h2></div>
        <ol class="numbered">{limits.map((l) => <li><p>{l}</p></li>)}</ol>
      </div>
    </div></section>

    <section class="cs-cta"><div class="wrap">
      <p class="eyebrow">Keep reading</p>
      <div class="btns"><a class="btn solid" href="/projects">All projects →</a><a class="btn" href="/contact">Ask me about it</a></div>
    </div></section>
  </article>
</Base>
