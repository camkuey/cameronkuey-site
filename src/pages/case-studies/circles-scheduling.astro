---
import Base from '../../layouts/Base.astro';
import { themeVars } from '../../data/themes';
import HoursToClick from '../../components/HoursToClick.astro';
import CaseFlow from '../../components/CaseFlow.astro';
import { meta, stats, note, problem, built, flows, results, success, differently } from '../../data/circles-scheduling';
---
<Base title={meta.title} section="projects" description={meta.description}>
  <article class="cs-page" data-theme="brand" style={themeVars('brand')}>
    <div class="cs-heroband">
      <div class="cs-stripe" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <div class="wrap cs-herogrid">
        <header class="page-head wide">
        <ol class="crumbs eyebrow mono" aria-label="Breadcrumb"><li><a href="/projects">Projects</a></li><li>Circles scheduling</li></ol>
        <h1>Turning a manual, multi-tab Circles setup into <em>a one-step workflow.</em></h1>
        <p class="lede">At Modern Health I produced online workshops and webinars called Circles. Setup took hours across many tools, so I mapped the process and automated it with Zapier and Airtable.</p>
          <dl class="spec-t"><div><dt>Org</dt><dd>Modern Health</dd></div><div><dt>Role</dt><dd>Creative Producer</dd></div><div><dt>Tools</dt><dd>Zapier, Airtable, Zendesk, Zoom, Google Slides</dd></div></dl>
      </header>
        <figure class="cs-herovis is-flow"><HoursToClick /></figure>
      </div>
      <div class="wrap">
        <div class="cs-tiles">
          {stats.map((s, i) => <div class={`cs-tile t${i}`}><b>{s.value}</b><span>{s.label}</span></div>)}
        </div>
      </div>
    </div>
    <div class="wrap"><p class="cs-note">{note}</p></div>

    <section class="cs-sec c-red"><div class="wrap">
      <div class="cs-grid">
        <div class="cs-label"><span class="cs-no" aria-hidden="true">01</span><h2>The problem</h2></div>
        <div class="cs-prose">{problem.map((p) => <p>{p}</p>)}</div>
      </div>
    </div></section>
    <section class="cs-sec c-blue tint"><div class="wrap">
      <div class="cs-grid">
        <div class="cs-label"><span class="cs-no" aria-hidden="true">02</span><h2>What I built</h2></div>
        <div class="cs-prose">{built.map((p) => <p>{p}</p>)}</div>
      </div>
    </div></section>
    <section class="cs-sec c-gold"><div class="wrap">
      <div class="cs-split rev">
        <div class="cs-text">
          <span class="cs-no" aria-hidden="true">03</span>
          <h2>{flows.schedule.title}</h2>
          {flows.schedule.body.map((p) => <p>{p}</p>)}
        </div>
        <figure class="cs-vis cs-flow"><CaseFlow flow="circles-schedule" /></figure>
      </div>
    </div></section>
    <section class="cs-sec c-red tint"><div class="wrap">
      <div class="cs-split">
        <div class="cs-text">
          <span class="cs-no" aria-hidden="true">04</span>
          <h2>{flows.harden.title}</h2>
          {flows.harden.body.map((p) => <p>{p}</p>)}
        </div>
        <figure class="cs-vis cs-flow"><CaseFlow flow="circles-harden" /></figure>
      </div>
    </div></section>
    <section class="cs-sec c-blue"><div class="wrap">
      <div class="cs-split rev">
        <div class="cs-text">
          <span class="cs-no" aria-hidden="true">05</span>
          <h2>{flows.deck.title}</h2>
          {flows.deck.body.map((p) => <p>{p}</p>)}
          <p>{flows.deck.related}</p>
        </div>
        <figure class="cs-vis cs-flow"><CaseFlow flow="circles-deck" /></figure>
      </div>
    </div></section>
    <section class="cs-sec is-key c-gold tint"><div class="wrap">
      <div class="cs-grid">
        <div class="cs-label"><span class="cs-no" aria-hidden="true">06</span><h2>Results</h2></div>
        <ol class="numbered">{results.map((r) => <li><p>{r}</p></li>)}</ol>
      </div>
    </div></section>
    <section class="cs-sec c-ink"><div class="wrap">
      <div class="cs-grid">
        <div class="cs-label"><span class="cs-no" aria-hidden="true">07</span><h2>How I define success</h2></div>
        <ul class="cs-big">{success.map((r, i) => <li class={`b${i}`}><span>{r}</span></li>)}</ul>
      </div>
    </div></section>
    <section class="cs-sec c-red tint"><div class="wrap">
      <div class="cs-grid">
        <div class="cs-label"><span class="cs-no" aria-hidden="true">08</span><h2>What I’d do differently</h2></div>
        <ol class="numbered">{differently.map((d) => <li><p>{d}</p></li>)}</ol>
      </div>
    </div></section>
    <section class="cs-cta"><div class="wrap">
      <p class="eyebrow">Keep reading</p>
      <div class="btns"><a class="btn solid" href="/case-studies/contract-automation">Next: contract automation →</a><a class="btn" href="/projects">All projects</a><a class="btn" href="/contact">Ask me about it</a></div>
    </div></section>
  </article>
</Base>
