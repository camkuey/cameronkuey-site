---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import DataFlowDiagram from '../components/DataFlowDiagram.astro';
import { SITE, page } from '../lib/site';
import { shot } from '../data/internal-dashboard';

const work = [
  { cls: 'w1', id: 'photography/01-7fe5208b', href: '/wedding-photography', title: 'Wedding Photography', tag: 'Cosie Co.', alt: 'Bride and groom in a forest clearing', sizes: '(max-width: 900px) 100vw, 720px' },
  { cls: 'w2', id: 'video-production/02-49466d51', href: '/documentaries', title: 'Documentaries & Short Stories', tag: 'The Cultivation Project', play: true, alt: 'Two people in conversation during a filmed interview', sizes: '(max-width: 900px) 100vw, 520px' },
  { cls: 'w3', id: 'engagement-proposals/03-9554103e', href: '/engagement-proposals', title: 'Engagements & Proposals', tag: 'Photo', alt: 'Black and white portrait of an engaged couple', sizes: '(max-width: 900px) 50vw, 410px' },
  { cls: 'w4', id: 'video-production/03-4e826515', href: '/commercials-social-media-ads', title: 'Commercials & Social Ads', tag: 'Video', play: true, alt: 'Hand holding Bible book covers for Alabaster Co.', sizes: '(max-width: 900px) 50vw, 410px' },
  { cls: 'w5', id: 'family-photoshoots/02-081697bb', href: '/family-photoshoots', title: 'Family Photoshoots', tag: 'Photo', alt: 'Toddler playing in autumn leaves', sizes: '(max-width: 900px) 100vw, 410px' },
  { cls: 'w6', id: 'audio-production/01-0bcb341f', href: '/coffee-meets-bible-podcast', title: 'Coffee Meets Bible', tag: 'Podcast', alt: 'Coffee Meets Bible podcast cover art', sizes: '(max-width: 900px) 100vw, 520px' },
  { cls: 'w7', id: 'graduation-photoshoots/10-2322cd02', href: '/graduation-photoshoots', title: 'Graduation Photoshoots', tag: 'Photo', alt: 'Graduates jumping on the beach', sizes: '(max-width: 900px) 100vw, 720px' },
];
const paths = [
  { href: '/experience', title: 'Experience', text: 'My work history since 2012, from founding two businesses to running operations: roles, hats worn and highlights.', tag: 'Work history' },
  { href: '/projects', title: 'Projects', text: 'Case studies and builds: the Internal Dashboard, Modern Health automations and more.', tag: 'Case studies' },
  { href: '/creative', title: 'Creative Work', text: 'Photography, video and podcasting. 200+ clients served as a freelancer through Cosie Co., and 100+ documentaries, videos and podcast episodes produced with The Cultivation Project.', tag: 'Creative' },
];

const aboutParas = (page('home').blocks.find((b: any) => b.t === 'html').html as string).split(/(?<=<\/p>)\s*/).filter((x: string) => x.startsWith('<p>'));
const aboutLead = aboutParas[0];
const aboutToday = aboutParas[1].replace(/ That includes.*?(?=<\/p>)/s, '');

const cues = [[0.0, "PHOTOGRAPHY"], [1.8, "WEDDING FILM"], [3.3, "WEDDING FILM"], [4.7, "DASHBOARD"], [6.5, "WEDDING FILM"], [7.9, "FLOW CHART"], [9.8, "COMMERCIAL"], [11.23, "ENGAGEMENTS"], [12.83, "WEDDING FILM"], [14.23, "THE SITE"], [15.83, "WEDDING FILM"], [17.23, "FLOW CHART"], [19.13, "DOCUMENTARY"], [20.63, "FLOW CHART"], [22.43, "WEDDING FILM"], [23.83, "COMMERCIAL"], [25.17, "GRADUATIONS"], [26.77, "DOCUMENTARY"], [28.37, "FLOW CHART"], [30.07, "WEDDING FILM"], [31.37, "PHOTOGRAPHY"]];
const dur = 33.37;
// Rotating titles for the h1 blank. Article lives inside the unit so a/an always agrees. No AI framing.
const titles = ['a photographer', 'a director of business operations', 'a wedding filmmaker', 'a systems builder', 'a documentary maker', 'an operations manager', 'a video editor', 'a workflow architect', 'a wedding photographer', 'an internal tool builder', 'a filmmaker', 'a process designer', 'a storyteller', 'a dashboard designer', 'a podcast producer', 'an automation builder', 'a creative director for small teams', 'a nonprofit operator', 'a project lead', 'a data organizer', 'a problem solver'];
// Glue the last two words of each title with a no-break space so a wrapped phrase never leaves a single word alone on a line.
const glue = (t: string) => t.replace(/ (?=[^ ]+$)/, '\u00A0');
const h1Name = 'Hi, I’m Cameron. I’m a photographer, filmmaker and operations leader.';
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Cameron Kuey',
  url: SITE.url,
  image: `${SITE.url}/og.jpg`,
  email: `mailto:${SITE.email}`,
  jobTitle: 'Director of Business Operations',
  worksFor: { '@type': 'Organization', name: 'Doodle Pirates Foundation' },
  sameAs: [SITE.linkedin, SITE.github, SITE.cosie, SITE.tcp],
  knowsAbout: ['Business operations', 'Airtable', 'AI-assisted software development', 'Photography', 'Video production'],
};
---
<Base title="Cameron Kuey" description="Cameron Kuey, Director of Business Operations at Doodle Pirates Foundation, builder of internal tools with AI agents, and a photographer and filmmaker (Cosie Co., The Cultivation Project)." jsonld={jsonld}>
<header class="hx" aria-labelledby="h">
  <div class="hx-media" data-dur={dur} data-cues={JSON.stringify(cues)}>
    <picture class="hx-poster">
      <source media="(max-width: 640px)" srcset="/media/hero-reel/poster-m.webp" />
      <img src="/media/hero-reel/poster.webp" width="1600" height="900" fetchpriority="high" decoding="async" alt="A couple embracing on a granite outcrop above Yosemite Valley: he lifts her off the ground as she laughs, with pine trees and snowy mountains behind them" />
    </picture>
    <video class="hx-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture disableremoteplayback></video>
    <div class="hx-scrim" aria-hidden="true"></div>
    <div class="wrap hx-copy">
      <p class="hx-ey">Experience · Projects · Photo, film &amp; audio</p>
      <h1 id="h"><span class="sr-only">{h1Name}</span><span class="hx-vis" aria-hidden="true"><span class="hx-l1">Hi, I’m Cameron.</span><span class="hx-l2 hx-st">I’m a <span class="hx-u">photographer, filmmaker and operations leader.</span></span><span class="hx-l2 hx-rotl">I’m <span class="hx-rot" data-titles={JSON.stringify(titles.map((t) => { const [a, ...r] = t.split(' '); return [a, glue(r.join(' '))]; }))}><span class="hx-art">{titles[0].split(' ')[0]} </span><span class="hx-u">{glue(titles[0].split(' ').slice(1).join(' '))}</span></span></span></span></h1>
      <script is:inline>document.querySelector('.hx').classList.add('hx-js')</script>
      <p class="hx-intro">Director of Business Operations at Doodle Pirates Foundation, designing internal tools and building them fast with AI agents. Photographer and filmmaker since 2012.</p>
      <div class="btns"><a class="btn solid" href="/contact">Get in touch</a><a class="btn hx-ghost" href="/resume.pdf">Resume (PDF)</a></div>
    </div>
    <p class="hx-chip" aria-hidden="true" hidden></p>
    <button type="button" class="hx-pp" aria-label="Pause background reel" aria-pressed="false" hidden><i aria-hidden="true"></i><span>Pause</span></button>
    <div class="hx-prog" aria-hidden="true"><i></i></div>
    <a class="hx-cue" href="#paths" aria-label="Scroll to the next section"><span>Scroll</span><i aria-hidden="true"></i></a>
  </div>
  <dl class="hx-spec wrap">
    <div class="hx-now"><dt>Now</dt><dd>Director of Business Operations, Doodle Pirates Foundation</dd></div>
    <div><dt>Build</dt><dd>Cursor cloud agents, Claude Code</dd></div>
    <div><dt>Data</dt><dd>Airtable</dd></div>
    <div><dt>Hosting</dt><dd>Cloudflare Workers</dd></div>
    <div><dt>Creative</dt><dd>Photo and film since 2012</dd></div>
  </dl>
</header>

<section id="paths" class="sec" aria-labelledby="paths-h"><div class="wrap">
  <div class="sec-top"><div><p class="ey"><b>01</b> / Choose a path</p><h2 id="paths-h">Three ways I work</h2></div></div>
  <ul class="rows">
    {paths.map((p, i) => (
      <li><a class="row" href={p.href}>
        <span class="n">{String(i + 1).padStart(2, '0')}</span>
        <h3>{p.title}</h3>
        <p>{p.text}</p>
        <span class="tag">{p.tag}<span class="go" aria-hidden="true">→</span></span>
      </a></li>
    ))}
  </ul>
</div></section>

<section id="case" class="feat" aria-labelledby="case-h"><div class="wrap">
  <div class="feat-grid">
    <figure class="feat-shot">
      <Pic id={shot.myWork.id} sizes="(max-width: 900px) 100vw, 600px" alt={shot.myWork.alt} />
    </figure>
    <div>
      <p class="ey"><b>02</b> / Featured project · Doodle Pirates Foundation</p>
      <h3 id="case-h">An all-in-one Internal Dashboard, <em>concept to production in under two weeks.</em></h3>
      <p class="desc">Designed by me and built fast with Cursor cloud agents on an Airtable ERP, including Ask Otis, a Claude-powered assistant with human-in-the-loop approval.</p>
      <div class="nums">
        <div><b>&lt;2 wks</b><span>Concept to production</span></div>
        <div><b>152</b><span>Reviewed pull requests</span></div>
        <div><b>1,218</b><span>Automated tests</span></div>
        <div><b>~20</b><span>AI agents</span></div>
      </div>
      <div class="btns"><a class="btn solid" href="/case-studies/internal-dashboard">Read the case study →</a></div>
    </div>
  </div>
</div></section>

<section id="flow" class="sec" aria-labelledby="flow-h" style="padding-bottom:0"><div class="wrap">
  <div class="sec-top"><div><p class="ey"><b>03</b> / Part of the case study above</p><h2 id="flow-h">Under the hood: how the data flows</h2></div></div>
  <DataFlowDiagram />
</div></section>

<section id="work" class="sec" aria-labelledby="work-h"><div class="wrap">
  <div class="sec-top"><div><p class="ey"><b>04</b> / Creative</p><h2 id="work-h">Selected work</h2></div><a class="more" href="/creative">Photography · Film · Audio →</a></div>
  <div class="work">
    {work.map((w) => (
      <figure class={w.cls}>
        <a href={w.href}>
          <span class="ph"><Pic id={w.id} alt={w.alt} sizes={w.sizes} />{w.play && <span class="play" aria-hidden="true"></span>}</span>
          <figcaption><b>{w.title}</b><span>{w.tag}</span></figcaption>
        </a>
      </figure>
    ))}
  </div>
</div></section>

<section class="sec" aria-label="About" style="padding-top:0"><div class="wrap about">
  <Pic id="home/01-b8f082cc" alt="Portrait of Cameron Kuey" sizes="(max-width: 900px) 280px, 360px" />
  <div class="about-copy">
    <p class="ey"><b>05</b> / About</p>
    <div set:html={aboutLead} />
    <div set:html={aboutToday.replace(/<\/p>$/, ' <a href="/home">Read more about me</a>.</p>')} />
  </div>
</div></section>
</Base>

<style is:global>
/* Home hero variant. Everything is scoped to .hx or to pages that contain it. */
.hx{--hx-strip:84px;background:var(--tan,#F0EBE4);color:var(--ink)}
.hx-media{position:relative;isolation:isolate;overflow:hidden;background:#1b1815;color:#FAF8F4;
  height:clamp(560px,calc(100svh - var(--hx-strip)),980px);display:flex;align-items:flex-end}
.hx-poster{display:block}
.hx-poster,.hx-video{position:absolute;inset:0;width:100%;height:100%;z-index:-2}
.hx-poster img{width:100%;height:100%;max-width:none;object-fit:cover;object-position:50% 40%;display:block}
.hx-video{object-fit:cover;object-position:50% 40%;opacity:0;transition:opacity .5s ease;background:transparent}
.hx-media.is-playing .hx-video{opacity:1}
/* Scrim for varied brightness (white UI cuts included): flat dim over the whole frame, a strong left gradient under the headline, soft top and bottom ramps */
.hx-scrim{position:absolute;inset:0;z-index:-1;pointer-events:none;
  background:
    linear-gradient(to bottom,rgba(20,18,16,.5) 0,rgba(20,18,16,0) 150px),
    linear-gradient(to right,rgba(20,18,16,.84) 0,rgba(20,18,16,.72) 32%,rgba(20,18,16,.5) 50%,rgba(20,18,16,.18) 68%,rgba(20,18,16,0) 80%),
    linear-gradient(to top,rgba(20,18,16,.55) 0,rgba(20,18,16,0) 42%),
    rgba(20,18,16,.24)}
.hx-chip{position:absolute;z-index:3;top:96px;right:max(40px,calc((100vw - 1200px)/2));margin:0;padding:6px 11px 5px;font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:#FAF8F4;border:1px solid rgba(250,248,244,.55);border-radius:2px;background:rgba(20,18,16,.4);pointer-events:none}
.hx-chip[hidden],.hx-pp[hidden]{display:none}
.hx-pp{position:absolute;z-index:3;left:max(40px,calc((100vw - 1200px)/2 + 40px));bottom:22px;margin-left:-8px;display:flex;align-items:center;gap:8px;height:30px;padding:0 10px;background:none;border:0;color:rgba(250,248,244,.9);font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;cursor:pointer;text-shadow:0 1px 8px rgba(20,18,16,.5)}
.hx-pp i{display:block;width:9px;height:11px;border-left:2.5px solid currentColor;border-right:2.5px solid currentColor}
.hx-pp[aria-pressed="true"] i{width:0;height:0;border:0;border-top:6px solid transparent;border-bottom:6px solid transparent;border-left:9px solid currentColor}
.hx-pp:hover{color:#fff}.hx-pp:focus-visible{outline:2px solid #FAF8F4;outline-offset:1px;border-radius:2px}
.hx-prog{position:absolute;z-index:3;left:0;right:0;bottom:0;height:2px;background:rgba(250,248,244,.16)}
.hx-prog i{display:block;height:100%;background:rgba(250,248,244,.8);transform-origin:0 50%;transform:scaleX(0)}

.hx-copy{position:relative;z-index:2}
.hx-copy{width:100%;padding-top:140px;padding-bottom:84px}
.hx-copy>*{max-width:600px}
.hx-ey{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:rgba(250,248,244,.86);margin-bottom:16px}
.hx h1{font-weight:300;font-size:clamp(38px,4.8vw,68px);line-height:1.04;letter-spacing:-.03em;color:#FAF8F4;text-wrap:balance;text-shadow:0 1px 24px rgba(20,18,16,.35)}
.hx h1 em{display:block;width:fit-content;white-space:nowrap;font-style:normal;font-weight:400;color:#FAF8F4;text-decoration:underline;text-decoration-color:#A32121;text-decoration-thickness:2px;text-underline-offset:.14em;text-decoration-skip-ink:none}
.hx h1{max-width:780px}
.hx-l1,.hx-l2{display:block}
.hx-l2{margin-top:.04em}
.hx-st{max-width:9.6em}
.hx-u{font-weight:400;color:#FAF8F4;text-decoration:underline;text-decoration-color:#A32121;text-decoration-thickness:2px;text-underline-offset:.14em;text-decoration-skip-ink:none}
.hx-rotl{display:none;min-height:2.08em}
/* Rotation runs only when JS is on and motion is allowed; otherwise the static readable line shows (no JS, reduced motion) */
@media (prefers-reduced-motion:no-preference){.hx-js .hx-st{display:none}.hx-js .hx-rotl{display:block}}
.hx-rot{position:relative;top:0;opacity:1;transition:opacity .22s ease-in,top .22s ease-in}
.hx-rot.is-out{opacity:0;top:-.16em}
.hx-rot.is-pre{opacity:0;top:.16em;transition:none}
.hx-rot.is-in{transition:opacity .23s ease-out,top .23s ease-out}
.hx-intro{font-weight:300;font-size:19px;line-height:1.55;max-width:48ch;margin-top:22px;color:rgba(250,248,244,.94);text-wrap:pretty}
.hx .btns{margin-top:30px}
.hx .btn.hx-ghost{border-color:rgba(250,248,244,.85);color:#FAF8F4;background:rgba(20,18,16,.18)}
.hx .btn.hx-ghost:hover{background:#FAF8F4;color:var(--ink);border-color:#FAF8F4}
.hx-cue{position:absolute;right:max(40px,calc((100vw - 1200px)/2));bottom:26px;display:flex;flex-direction:column;align-items:center;gap:8px;text-decoration:none;color:#FAF8F4;font-family:var(--mono);font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;text-shadow:0 1px 8px rgba(20,18,16,.5)}
.hx-cue i{width:10px;height:10px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg);margin-top:-2px;animation:hx-bob 2.2s ease-in-out infinite}
@keyframes hx-bob{0%,100%{transform:translateY(0) rotate(45deg)}50%{transform:translateY(5px) rotate(45deg)}}
.hx-spec{margin:0 auto;display:grid;grid-template-columns:1.7fr 1.2fr .7fr 1fr 1.1fr;gap:0 28px;font-family:var(--mono);min-height:var(--hx-strip);align-items:center;padding-top:14px;padding-bottom:14px}
.hx-spec div{display:grid;gap:4px;align-content:center;min-width:0}
.hx-spec dt{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.hx-spec dd{font-size:12px;line-height:1.4;color:var(--ink)}
/* nav: transparent over the photo at the top, normal cream bar once scrolled (Base already toggles .scrolled) */
body:has(.hx) header.nav{margin-bottom:-69px;transition:background-color .25s ease,box-shadow .25s ease,border-color .25s ease}
body:has(.hx) header.nav:not(.scrolled){background:transparent;border-bottom-color:transparent;-webkit-backdrop-filter:none;backdrop-filter:none;box-shadow:none}
body:has(.hx) header.nav:not(.scrolled) .logo{color:#FAF8F4;text-shadow:0 1px 10px rgba(20,18,16,.4)}
body:has(.hx) header.nav:not(.scrolled) .logo span{color:#FAF8F4}
body:has(.hx) header.nav:not(.scrolled) nav.primary a{color:rgba(250,248,244,.9);text-shadow:0 1px 10px rgba(20,18,16,.45)}
body:has(.hx) header.nav:not(.scrolled) nav.primary a:hover{color:#fff;border-bottom-color:#fff}
body:has(.hx) header.nav:not(.scrolled) .menu-btn{color:#FAF8F4;border-color:rgba(250,248,244,.85);background:rgba(20,18,16,.22)}
body.menu-open:has(.hx) header.nav{background:rgba(250,248,244,.97);border-bottom-color:var(--line)}
body.menu-open:has(.hx) header.nav:not(.scrolled) .logo{color:var(--ink);text-shadow:none}
body.menu-open:has(.hx) header.nav:not(.scrolled) .logo span{color:var(--accent)}
body.menu-open:has(.hx) header.nav:not(.scrolled) .menu-btn{color:var(--ink);border-color:var(--ink);background:none}
@media (max-width:1100px){
  .hx-spec{grid-template-columns:repeat(4,1fr);gap:12px 24px;padding-top:18px;padding-bottom:18px}
  .hx-now{grid-column:1/-1}
  .hx{--hx-strip:130px}
}
@media (max-width:900px){
  .hx-copy{padding-bottom:76px}
  .hx-cue{right:20px}
  .hx-pp{left:20px;margin-left:-8px}
}
@media (max-width:640px){
  .hx{--hx-strip:0px}
  .hx-media{height:clamp(600px,100svh,860px)}
  .hx-scrim{background:
    linear-gradient(to bottom,rgba(20,18,16,.5) 0,rgba(20,18,16,0) 110px),
    linear-gradient(to top,rgba(20,18,16,.94) 0,rgba(20,18,16,.84) 38%,rgba(20,18,16,.4) 62%,rgba(20,18,16,.1) 80%),
    rgba(20,18,16,.3)}
  .hx-chip{top:84px;right:20px}
  .hx-pp{left:12px;margin-left:0;bottom:12px}

  .hx-copy{padding-top:96px;padding-bottom:64px}
  .hx-ey{font-size:10.5px;margin-bottom:12px}
  .hx h1{font-size:clamp(34px,9.6vw,44px);max-width:none}
  .hx-intro{font-size:16.5px;margin-top:16px}
  .hx .btns{margin-top:22px}
  .hx-cue{right:50%;transform:translateX(50%);bottom:14px}
  .hx-spec{grid-template-columns:1fr 1fr;align-items:start;padding-top:22px;padding-bottom:22px}
}
@media (max-width:360px){.hx-l2{font-size:.9em}}
@media (prefers-reduced-motion:reduce){.hx-video,.hx-pp,.hx-chip,.hx-prog{display:none}}
</style>

<script>
  // Home hero reel: quick-cut looping video (photos, film, dashboard, flow charts, site). Poster only under reduced motion or data saver.
  const media = document.querySelector<HTMLElement>('.hx-media');
  const vid = media?.querySelector<HTMLVideoElement>('.hx-video');
  if (media && vid) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const chip = media.querySelector<HTMLElement>('.hx-chip')!;
    const pp = media.querySelector<HTMLButtonElement>('.hx-pp')!;
    const bar = media.querySelector<HTMLElement>('.hx-prog i')!;
    const cues: [number, string][] = JSON.parse(media.dataset.cues || '[]');
    const dur = parseFloat(media.dataset.dur || '0');
    const conn = (navigator as any).connection;
    let loaded = false, userPaused = false, visible = true, last = -1;
    const mobile = () => matchMedia('(max-width: 640px)').matches;
    const load = () => {
      if (loaded) return;
      loaded = true;
      const m = mobile() ? '-m' : '';
      [['webm', 'video/webm'], ['mp4', 'video/mp4']].forEach(([ext, type]) => {
        const s = document.createElement('source'); s.src = `/media/hero-reel/hero-reel${m}.${ext}`; s.type = type; vid.appendChild(s);
      });
      vid.load();
    };
    const tick = () => {
      const t = vid.currentTime; let i = 0;
      while (i + 1 < cues.length && cues[i + 1][0] <= t) i++;
      if (i !== last) { last = i; chip.textContent = cues[i][1]; }
      if (dur) bar.style.transform = `scaleX(${Math.min(t / dur, 1)})`;
    };
    const frame = () => { tick(); if ('requestVideoFrameCallback' in vid) (vid as any).requestVideoFrameCallback(frame); };
    if ('requestVideoFrameCallback' in vid) (vid as any).requestVideoFrameCallback(frame); else vid.addEventListener('timeupdate', tick);
    // Rotating h1 titles: ~450ms swap (soft fade plus small vertical slide), ~2.4s hold. Paused with the reel, a hidden tab, off-screen, or reduced motion.
    const rot = media.querySelector<HTMLElement>('.hx-rot');
    const titles: string[][] = rot ? JSON.parse(rot.dataset.titles || '[]') : [];
    const HOLD = 2400, OUT = 220;
    let ri = 0, rt = 0, rdue = 0, rrun = false, rbusy = false;
    const rhold = (ms: number) => { clearTimeout(rt); rdue = Date.now() + ms; rt = window.setTimeout(rstep, ms); };
    const rstep = () => {
      if (!rot) return;
      rbusy = true; rot.classList.add('is-out');
      rt = window.setTimeout(() => {
        ri = (ri + 1) % titles.length; rot.innerHTML = ''; const ar = document.createElement('span'); ar.textContent = titles[ri][0] + ' '; const nn = document.createElement('span'); nn.className = 'hx-u'; nn.textContent = titles[ri][1]; rot.append(ar, nn);
        rot.classList.remove('is-out'); rot.classList.add('is-pre'); void rot.offsetWidth;
        rot.classList.remove('is-pre'); rot.classList.add('is-in');
        rt = window.setTimeout(() => { rot.classList.remove('is-in'); rbusy = false; if (rrun) rhold(HOLD); }, 240);
      }, OUT);
    };
    let rrem = HOLD;
    const rsync = (go: boolean) => {
      if (!rot || titles.length < 2 || go === rrun) return;
      rrun = go;
      if (go) { if (!rbusy) rhold(rrem); }
      else if (!rbusy) { clearTimeout(rt); rrem = Math.max(400, rdue - Date.now()); }
      else rrem = HOLD;
    };
    const sync = () => {
      rsync(!reduce.matches && !userPaused && !document.hidden && visible);
      if (reduce.matches || conn?.saveData) return;
      if (userPaused || document.hidden || !visible) { vid.pause(); return; }
      load();
      vid.play().catch(() => {});
    };
    vid.addEventListener('playing', () => { media.classList.add('is-playing'); chip.hidden = false; pp.hidden = false; });
    pp.addEventListener('click', () => {
      userPaused = !userPaused;
      pp.setAttribute('aria-pressed', String(userPaused));
      pp.setAttribute('aria-label', userPaused ? 'Play background reel' : 'Pause background reel');
      pp.querySelector('span')!.textContent = userPaused ? 'Play' : 'Pause';
      sync();
    });
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.1 }).observe(media);
    reduce.addEventListener('change', () => {
      if (reduce.matches) { vid.pause(); media.classList.remove('is-playing'); chip.hidden = true; pp.hidden = true; } else sync();
    });
    document.readyState === 'complete' ? sync() : addEventListener('load', sync, { once: true });
  }
</script>
