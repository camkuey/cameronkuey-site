---
/* Every page from the original Adobe Portfolio site, at its original URL. */
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import Covers from '../components/Covers.astro';
import CreativeNav from '../components/CreativeNav.astro';
import { PAGES, CATEGORIES, IMAGES } from '../lib/site';

export function getStaticPaths() {
  return PAGES.filter((p) => p.slug !== 'contact').map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: any };

const strip = (h: string) => h.replace(/<[^>]+>/g, ' ').replace(/&amp;/g, '&').replace(/&nbsp;|\u00a0/g, ' ').replace(/&#39;|&rsquo;/g, '’').replace(/\s+/g, ' ').trim();
const firstText = p.blocks.filter((b: any) => b.t === 'html').map((b: any) => strip(b.html)).find((t: string) => t.length > 40);
const cat = CATEGORIES.find((c) => c.slug === p.categorySlug);
const isCategory = p.type === 'gallery';
const isAbout = p.slug === 'home';

let description: string;
if (isAbout) description = 'About Cameron Kuey, from his original portfolio: Cosie Co., The Cultivation Project, skills and software.';
else if (isCategory) description = `${p.title} by Cameron Kuey: ${CATEGORIES.find((c) => c.slug === p.slug)!.children.map((c) => c.title).join(', ')}.`;
else description = firstText ? (firstText.length > 155 ? firstText.slice(0, 152).replace(/\s+\S*$/, '') + '…' : firstText) : `${p.title} — ${p.category} work by Cameron Kuey.`;
if (description.length < 70 && !isCategory) description = `${p.title} — ${p.category ?? 'creative'} work by Cameron Kuey. ${description}`.slice(0, 158);

// Social image: first image on the page, else the site default.
const firstImg = (p.blocks.find((b: any) => b.t === 'images' && b.items.some((i: any) => IMAGES[i.id]))?.items ?? []).find((i: any) => IMAGES[i.id]) ?? (p.covers[0]?.image && IMAGES[p.covers[0].image.id] ? p.covers[0].image : null);
const image = firstImg ? `${IMAGES[firstImg.id].base}-${IMAGES[firstImg.id].webp.filter((w: number) => w <= 1600).pop()}.webp` : '/og.jpg';

// prev / next within category
const sibs = cat ? cat.children : [];
const k = sibs.findIndex((c) => c.slug === p.slug);
const prev = k > 0 ? sibs[k - 1] : null;
const next = k >= 0 && k < sibs.length - 1 ? sibs[k + 1] : null;
const catCovers = isCategory
  ? p.covers.map((c: any) => ({ ...c, tag: 'View →' }))
  : [];
---
<Base title={isAbout ? 'About Me (original portfolio)' : p.title} description={description} section="creative" image={image}>
  <CreativeNav current={isAbout ? 'home' : p.categorySlug ?? p.slug} />
  <div class="wrap">
    <header class:list={['page-head', { wide: isCategory }]}>
      <ol class="crumbs eyebrow" aria-label="Breadcrumb">
        <li><a href="/creative">Creative</a></li>
        {cat && <li><a href={`/${cat.slug}`}>{cat.title}</a></li>}
        {isAbout && <li>Original portfolio</li>}
      </ol>
      <h1>{p.title}</h1>
      {isAbout && <p class="lede">This is the About page from my original portfolio, kept as it was written in 2022. For what I’m doing now, see <a href="/operations">Operations</a> and <a href="/ai-builds">AI Builds</a>.</p>}
    </header>
  </div>
  <section style="padding-top:8px"><div class="wrap">
    {isCategory ? <Covers covers={catCovers} eager /> : <Blocks blocks={isAbout ? p.blocks.filter((b: any) => !(b.t === 'html' && /My Resume/.test(b.html))) : p.blocks} />}
  </div></section>
  {(prev || next) && (
    <nav class="wrap" aria-label={`More ${cat!.title}`} style="padding-bottom:96px">
      <div class="pager">
        {prev && <a href={`/${prev.slug}`}><span class="eyebrow">← Previous</span><b>{prev.title}</b></a>}
        {next && <a class="next" href={`/${next.slug}`}><span class="eyebrow">Next →</span><b>{next.title}</b></a>}
      </div>
    </nav>
  )}
</Base>
