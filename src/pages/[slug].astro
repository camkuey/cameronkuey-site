---
/* Every page from the original Adobe Portfolio site, at its original URL. */
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import Covers from '../components/Covers.astro';
import Pic from '../components/Pic.astro';
import CreativeNav from '../components/CreativeNav.astro';
import { PAGES, CATEGORIES, IMAGES } from '../lib/site';

export function getStaticPaths() {
  return PAGES.filter((p) => p.slug !== 'contact').map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: any };

const strip = (h: string) => h.replace(/<[^>]+>/g, ' ').replace(/&amp;/g, '&').replace(/&nbsp;|\u00a0/g, ' ').replace(/&#39;|&rsquo;/g, '’').replace(/\s+/g, ' ').trim();
const firstText = p.blocks.filter((b: any) => b.t === 'html').map((b: any) => strip(b.html)).find((t: string) => t.length > 40);
const cat = CATEGORIES.find((c) => c.slug === p.categorySlug);
const isCategory = p.type === 'gallery';
const isAbout = p.slug === 'home';
const aboutHtml = isAbout ? p.blocks.filter((b: any) => b.t === 'html').map((b: any) => b.html) : [];
const aboutIntro = aboutHtml[0] ?? '';
const aboutSkills = isAbout ? (aboutHtml[1] ?? '').replace(/^<h3>Skills<\/h3>/, '').split(/(?=<h3>)/).filter((g: string) => g.trim()).map((g: string) => g.replace(/<h3>/, '<h2>').replace(/<\/h3>/, '</h2>')) : [];
const aboutImg = isAbout ? p.blocks.find((b: any) => b.t === 'images')?.items?.[0]?.id : null;

let description: string;
if (isAbout) description = 'About Cameron Kuey: operations leader, systems builder, photographer and filmmaker.';
else if (isCategory) description = `${p.title} by Cameron Kuey: ${CATEGORIES.find((c) => c.slug === p.slug)!.children.map((c) => c.title).join(', ')}.`;
else description = firstText ? (firstText.length > 155 ? firstText.slice(0, 152).replace(/\s+\S*$/, '') + '…' : firstText) : `${p.title}: ${p.category} work by Cameron Kuey.`;
if (description.length < 70 && !isCategory) description = `${p.title}: ${p.category ?? 'creative'} work by Cameron Kuey. ${description}`.slice(0, 158);

// Social image: first image on the page, else the site default.
const firstImg = (p.blocks.find((b: any) => b.t === 'images' && b.items.some((i: any) => IMAGES[i.id]))?.items ?? []).find((i: any) => IMAGES[i.id]) ?? (p.covers[0]?.image && IMAGES[p.covers[0].image.id] ? p.covers[0].image : null);
const image = firstImg ? `${IMAGES[firstImg.id].base}-${IMAGES[firstImg.id].webp.filter((w: number) => w <= 1600).pop()}.webp` : '/og.jpg';

// prev / next within category
const sibs = cat ? cat.children : [];
const k = sibs.findIndex((c) => c.slug === p.slug);
const prev = k > 0 ? sibs[k - 1] : null;
const next = k >= 0 && k < sibs.length - 1 ? sibs[k + 1] : null;
const rangeCat = cat ?? CATEGORIES.find((c) => c.slug === p.slug);
const noun: Record<string, string> = { photography: 'photography', 'video-production': 'video', work: 'product design', 'graphic-design': 'design and graphics' };
const showRange = !!rangeCat && rangeCat.children.length > 1 && !isAbout;
const catCovers = isCategory
  ? p.covers.map((c: any) => ({ ...c, tag: 'View →' }))
  : [];
---
<Base title={isAbout ? 'About Me' : p.title} description={description} section="creative" image={image}>
  <CreativeNav current={isAbout ? 'home' : p.categorySlug ?? p.slug} />
  <header class="pg wide"><div class="wrap pg-grid">
    <div>
      <ol class="crumbs" aria-label="Breadcrumb">
        <li><a href="/creative">Creative</a></li>
        {cat && <li><a href={`/${cat.slug}`}>{cat.title}</a></li>}
      </ol>
      <h1>{p.title}</h1>
      {showRange && (
        <nav aria-label={`Types of ${noun[rangeCat!.slug] ?? rangeCat!.title}`} style="margin-top:26px">
          <ul class="pills">{rangeCat!.children.map((c) => <li><a href={`/${c.slug}`} aria-current={c.slug === p.slug ? 'page' : undefined}>{c.title}</a></li>)}</ul>
        </nav>
      )}
    </div>
  </div></header>
  <section class="sec" style="padding-top:48px"><div class="wrap">
    {isAbout ? (
      <div class="about-page">
        <div class="about-top">
          <figure class="about-portrait">{aboutImg && <Pic id={aboutImg} eager alt="Portrait of Cameron Kuey" sizes="(max-width: 900px) 70vw, 380px" />}</figure>
          <div class="about-body">
            <div class="prose about-intro" set:html={aboutIntro} />
            <div class="btns"><a class="btn solid" href="/resume.pdf">Download my resume (PDF)</a><a class="btn" href="/contact">Get in touch</a></div>
          </div>
        </div>
        <section class="about-skills" aria-label="Skills">
          <p class="eyebrow">Skills</p>
          <div class="about-skill-grid">{aboutSkills.map((g: string) => <div class="prose" set:html={g} />)}</div>
        </section>
      </div>
    ) : isCategory ? <Covers covers={catCovers} eager /> : <Blocks blocks={p.blocks} />}
  </div></section>
  {(prev || next) && (
    <nav class="wrap" aria-label={`More ${cat!.title}`} style="padding-bottom:96px">
      <div class="pager">
        {prev && <a href={`/${prev.slug}`}><span class="eyebrow">← Previous</span><b>{prev.title}</b></a>}
        {next && <a class="next" href={`/${next.slug}`}><span class="eyebrow">Next →</span><b>{next.title}</b></a>}
      </div>
    </nav>
  )}
</Base>

<style is:global>
.about-top{display:grid;grid-template-columns:minmax(240px,380px) 1fr;gap:64px;align-items:start}
.about-portrait{margin:0;position:sticky;top:96px}
.about-portrait img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:50% 25%;display:block}
.about-intro{font-size:18px;line-height:1.65}
.about-intro p:first-child{font-size:23px;line-height:1.45;font-weight:300}
.about-body .btns{margin-top:32px}
.about-skills{margin-top:88px;padding-top:40px;border-top:1px solid var(--line)}
.about-skills .eyebrow{margin-bottom:28px}
.about-skill-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 56px}
.about-skill-grid .prose{max-width:none}
.about-skill-grid h2{margin-top:0}
@media (max-width:900px){
  .about-top{grid-template-columns:1fr;gap:32px}
  .about-portrait{position:static;max-width:300px}
  .about-intro p:first-child{font-size:20px}
  .about-skill-grid{grid-template-columns:1fr}
  .about-skills{margin-top:56px}
}
</style>
